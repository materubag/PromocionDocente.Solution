
@using PromocionDocente.Client.Services
@inject UserSessionService UserSession

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @if (routeData.PageType == typeof(PromocionDocente.Client.Pages.Login))
        {
            <!-- Página de login sin layout -->
            <RouteView RouteData="@routeData" />
        }
        else if (IsAdminPage(routeData.RouteValues))
        {
            <!-- Páginas de admin con AdminLayout -->
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(AdminLayout)" />
        }
        else
        {
            <!-- Páginas normales con MainLayout -->
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        }
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Lo sentimos, no se encontró la página.</p>
        </LayoutView>
    </NotFound>
</Router>

<style>
    .success-toast {
        background-color: #4CAF50 !important;
    }

    .error-toast {
        background-color: #f44336 !important;
    }

    .info-toast {
        background-color: #2196F3 !important;
    }

    .warning-toast {
        background-color: #ff9800 !important;
    }
</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        await UserSession.CargarUsuarioAsync();
    }

    private bool IsAdminPage(IReadOnlyDictionary<string, object?> routeValues)
    {
        // Verifica si la ruta comienza con "admin"
        if (routeValues.TryGetValue("page", out var page) && page != null)
        {
            return page.ToString()?.StartsWith("admin", StringComparison.OrdinalIgnoreCase) == true;
        }
        return false;
    }
}