@page "/docente-tiempo"
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="text-xl font-bold mb-4">Tiempo de Enseñanza del Docente</h3>

<div class="flex gap-4 mb-4">
    <input type="text" @bind="cedula" placeholder="Ingrese cédula" class="border rounded px-2 py-1" />
    <button class="bg-blue-600 text-white px-4 py-1 rounded" @onclick="ConsultarTiempo">Buscar</button>
</div>

@if (tiempo != null)
{
    <div class="border p-4 rounded shadow">
        <p><strong>Tiempo Total:</strong> @tiempo.Anios años, @tiempo.Meses meses, @tiempo.Dias días</p>
    </div>
}
@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="text-red-600">@mensajeError</div>
}

@code {
    private string cedula = string.Empty;
    private DocenteTiempo? tiempo;
    private string mensajeError = string.Empty;

    private async Task ConsultarTiempo()
    {
        mensajeError = string.Empty;
        try
        {
            tiempo = await Http.GetFromJsonAsync<DocenteTiempo>($"/api/docentes/tiempo/{cedula}");
        }
        catch (Exception ex)
        {
            mensajeError = "Error al obtener datos: " + ex.Message;
        }
    }

    public class DocenteTiempo
    {
        public string Cedula { get; set; } = string.Empty;
        public int Anios { get; set; }
        public int Meses { get; set; }
        public int Dias { get; set; }
    }
}