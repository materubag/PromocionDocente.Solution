@page "/evaluaciones-docente"
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="text-xl font-bold mb-4">Evaluaciones del Docente</h3>
<div class="flex gap-4 mb-4">
    <input type="text" @bind="cedula" placeholder="Ingrese cédula" class="border rounded px-2 py-1" />
    <button class="bg-purple-600 text-white px-4 py-1 rounded" @onclick="ConsultarEvaluaciones">Buscar</button>
</div>

@if (evaluaciones != null && evaluaciones.Any())
{
    <table class="table-auto border border-gray-300">
        <thead>
            <tr>
                <th class="px-4">Resolución</th>
                <th class="px-4">Fecha</th>
                <th class="px-4">Calificación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in evaluaciones)
            {
                <tr>
                    <td class="px-4">@ev.NumeroResolucion</td>
                    <td class="px-4">@ev.FechaEvaluacion.ToShortDateString()</td>
                    <td class="px-4">@ev.Calificacion</td>
                </tr>
            }
        </tbody>
    </table>
}
@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="text-red-600">@mensajeError</div>
}

@code {
    private string cedula = string.Empty;
    private List<Evaluacion> evaluaciones = new();
    private string mensajeError = string.Empty;

    private async Task ConsultarEvaluaciones()
    {
        mensajeError = string.Empty;
        try
        {
            evaluaciones = await Http.GetFromJsonAsync<List<Evaluacion>>($"/api/evaluaciones/{cedula}");
        }
        catch (Exception ex)
        {
            mensajeError = "Error al obtener evaluaciones: " + ex.Message;
        }
    }

    public class Evaluacion
    {
        public string NumeroResolucion { get; set; } = string.Empty;
        public DateTime FechaEvaluacion { get; set; }
        public decimal Calificacion { get; set; }
    }
}