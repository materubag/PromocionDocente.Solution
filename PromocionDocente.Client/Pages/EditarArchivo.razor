@page "/editar-archivo/{id:int}"
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IArchivoService ArchivoService

<h3>Editar Archivo</h3>

@if (archivo != null)
{
    <EditForm Model="@archivo" OnValidSubmit="ActualizarArchivo">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Título:</label>
            <InputText @bind-Value="archivo.Titulo" class="form-control" />
        </div>
        <div class="mb-2">
            <label>Encargado:</label>
            <InputText @bind-Value="archivo.Encargado" class="form-control" />
        </div>
        <div class="mb-2">
            <label>Fecha:</label>
            <InputDate @bind-Value="archivo.Fecha" class="form-control" />
        </div>
        <div class="mb-2">
            <label>Reemplazar PDF (opcional):</label>
            <InputFile OnChange="SeleccionarArchivo" accept=".pdf" />
        </div>

        <button type="submit" class="btn btn-warning">Actualizar</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        MostrarAlerta("success", "Éxito", mensajeExito);
    }
}
else
{
    <p>Cargando archivo...</p>
}
<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />


@code {
    [Parameter] public int id { get; set; }
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";

    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;

        // Auto-close después de 4s
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }

    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }

    ArchivoDTO? archivo;
    IBrowserFile? archivoSubido;
    string? mensajeExito;

    protected override async Task OnInitializedAsync()
    {
        archivo = await ArchivoService.ObtenerArchivoPorIdAsync(id);
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoSubido = e.File;
    }

    private async Task ActualizarArchivo()
    {
        if (archivoSubido is not null)
        {
            using var stream = new MemoryStream();
            await archivoSubido.OpenReadStream().CopyToAsync(stream);
            archivo!.ContenidoArchivo = stream.ToArray();

            archivo.RutaArchivo = $"archivos/{Guid.NewGuid()}_{archivoSubido.Name}";
        }

        var exito = await ArchivoService.ActualizarArchivoAsync(id, archivo!);

        if (exito)
            mensajeExito = "El archivo fue actualizado correctamente.";
    }

}
