@page "/obras-docente"
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="text-xl font-bold mb-4">Obras del Docente</h3>
<div class="flex gap-4 mb-4">
    <input type="text" @bind="cedula" placeholder="Ingrese cédula" class="border rounded px-2 py-1" />
    <button class="bg-green-600 text-white px-4 py-1 rounded" @onclick="ConsultarObras">Buscar</button>
</div>

@if (obras != null && obras.Any())
{
    <ul>
        @foreach (var obra in obras)
        {
            <li><strong>@obra.Titulo</strong> - @obra.FechaPublicacion.ToShortDateString()</li>
        }
    </ul>
}
@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="text-red-600">@mensajeError</div>
}

@code {
    private string cedula = string.Empty;
    private List<Obra> obras = new();
    private string mensajeError = string.Empty;

    private async Task ConsultarObras()
    {
        mensajeError = string.Empty;
        try
        {
            obras = await Http.GetFromJsonAsync<List<Obra>>($"/api/obras/{cedula}");
        }
        catch (Exception ex)
        {
            mensajeError = "Error al obtener obras: " + ex.Message;
        }
    }

    public class Obra
    {
        public string Titulo { get; set; } = string.Empty;
        public DateTime FechaPublicacion { get; set; }
    }
}