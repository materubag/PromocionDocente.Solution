@page "/home"

<style>
    .hero {
        background: linear-gradient(135deg, #3f51b5, #5c6bc0);
        color: white;
        padding: 4rem 2rem;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        animation: fadeIn 1s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero h1 {
        font-size: 3rem;
        font-weight: bold;
    }

    .hero p {
        font-size: 1.3rem;
        margin-top: 1rem;
    }

    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
    }

    .icon-img {
        width: 80px;
        margin-bottom: 1rem;
    }
</style>


<div class="container mt-5">
    <!-- Sección principal (Hero) -->
    <div class="hero">
        <h1>Bienvenido al Sistema de Promoción Docente</h1>
        <p>Gestione sus criterios de evaluación, cursos, capacitaciones, obras y mucho más con facilidad y transparencia.</p>
    </div>

    <!-- Sección de funcionalidades -->
    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card feature-card text-center p-4">
                <img src="https://img.icons8.com/color/96/000000/classroom.png" class="icon-img" alt="Evaluación">
                <h4>Criterios de Evaluación</h4>
                <p>Revise y actualice sus criterios con base en sus logros académicos.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card text-center p-4">
                <img src="https://img.icons8.com/color/96/000000/training.png" class="icon-img" alt="Capacitaciones">
                <h4>Capacitaciones</h4>
                <p>Gestione sus cursos y capacitaciones para avanzar profesionalmente.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card text-center p-4">
                <img src="https://img.icons8.com/color/96/000000/education.png" class="icon-img" alt="Obras">
                <h4>Obras y Publicaciones</h4>
                <p>Documente sus obras y publicaciones para fortalecer su perfil académico.</p>
            </div>
        </div>
    </div>
</div>