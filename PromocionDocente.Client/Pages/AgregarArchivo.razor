@page "/agregar-archivo"
@using PromocionDocente.Application.Interfaces
@using PromocionDocente.Application.DTOs
@using Microsoft.AspNetCore.Components.Forms
@inject IArchivoService ArchivoService

<h3>Agregar Archivos</h3>

<EditForm Model="@archivo" OnValidSubmit="GuardarArchivo">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Título:</label>
        <InputText @bind-Value="archivo.Titulo" class="form-control" />
    </div>
    <div>
        <label>Nombre del encargado:</label>
        <InputText @bind-Value="archivo.Encargado" class="form-control" />
    </div>
    <div>
        <label>Fecha:</label>
        <InputDate @bind-Value="archivo.Fecha" class="form-control" />
    </div>
    <div>
        <label>Archivo PDF:</label>
        <InputFile OnChange="SeleccionarArchivo" accept=".pdf" />
    </div>

    <button type="submit" class="btn btn-success mt-3">Listo</button>
</EditForm>

@if (mensajeExito != null)
{
    <div class="alert alert-success mt-3">
        ✅ @mensajeExito
    </div>
}

@code {
    ArchivoDTO archivo = new();
    IBrowserFile? archivoSubido;
    string? mensajeExito;

    private void SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoSubido = e.File;
    }

    private async Task GuardarArchivo()
    {
        if (archivoSubido is null)
            return;

        using var stream = new MemoryStream();
        await archivoSubido.OpenReadStream().CopyToAsync(stream);
        archivo.ContenidoArchivo = stream.ToArray();

        archivo.RutaArchivo = $"archivos/{Guid.NewGuid()}_{archivoSubido.Name}";

        var exito = await ArchivoService.AgregarArchivoAsync(archivo);

        if (exito)
        {
            mensajeExito = "Se agregó un archivo con éxito.";
            archivo = new();
            archivoSubido = null;
        }
    }
}
