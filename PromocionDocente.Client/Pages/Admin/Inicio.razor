@code {
    private bool cargando = true;
    private DashboardDataDto dashboardData;

    protected override async Task OnInitializedAsync()
    {
        await UserSessionService.CargarUsuarioAsync();
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            dashboardData = await Http.GetFromJsonAsync<DashboardDataDto>("/api/Postulaciones/Dashboard");
        }
        catch (Exception ex)
        {
            // ToastService?.ShowError($"Error al cargar datos: {ex.Message}");
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ValidarSolicitud(int solicitudId)
    {
        try
        {
            var solicitud = dashboardData?.Solicitudes.FirstOrDefault(s => s.Id == solicitudId);
            if (solicitud != null && !string.IsNullOrEmpty(solicitud.Codigo))
            {
                // Aquí puedes hacer un POST al backend si necesitas validar primero (opcional)
                // await Http.PostAsJsonAsync("api/Postulaciones/Validar", new { Id = solicitudId });

                NavigationManager.NavigateTo($"/administrador?codigo={solicitud.Codigo}");
                Console.WriteLine($"Redirigiendo a administrador con código: {solicitud.Codigo}");
            }
            else
            {
                await CargarDatosAsync();
                // ToastService?.ShowWarning("No se encontró la solicitud.");
            }
        }
        catch (Exception ex)
        {
            // ToastService?.ShowError($"Error al validar: {ex.Message}");
            Console.WriteLine($"Error al validar: {ex.Message}");
        }
    }

    private string GetEstadoClass(string estado)
    {
        if (string.IsNullOrEmpty(estado)) return "pendiente";
        if (estado.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase))
            return "pendiente";
        else if (estado.Contains("REVISION", StringComparison.OrdinalIgnoreCase))
            return "en-revision";
        else if (estado.Contains("RECHAZADO", StringComparison.OrdinalIgnoreCase))
            return "rechazado";
        else if (estado.Contains("APROBADO", StringComparison.OrdinalIgnoreCase))
            return "aprobado";
        else
            return "otro";
    }

    // Clases DTO para recibir datos del backend
    public class DashboardDataDto
    {
        public DashboardEstadisticasDto Estadisticas { get; set; }
        public List<SolicitudDocenteDto> Solicitudes { get; set; } = new List<SolicitudDocenteDto>();
    }

    public class DashboardEstadisticasDto
    {
        public int TotalDocentes { get; set; }
        public int EvaluacionesPendientes { get; set; }
        public int SolicitudesFinalizadas { get; set; }
        public int SolicitudesRechazadas { get; set; }
    }

    public class SolicitudDocenteDto
    {
        public int Id { get; set; }
        public string Codigo { get; set; }
        public string NombreDocente { get; set; }
        public string Nivel { get; set; }
        public DateTime Fecha { get; set; }
        public string TiempoEspera { get; set; }
        public string Estado { get; set; }
    }
}
