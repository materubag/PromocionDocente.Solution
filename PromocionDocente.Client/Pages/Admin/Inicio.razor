@page "/admin"
@using Blazored.Toast.Services
@using PromocionDocente.Client.Services
@layout AdminLayout
@inject HttpClient Http
@inject UserSessionService UserSessionService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

<PageTitle>Panel de Administración</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h1>Panel de Administración</h1>
        <p>Bienvenido al sistema de gestión de promoción docente, @UserSessionService.Usuario?.Nombre1</p>
    </div>

    @if (cargando)
    {
        <div class="loading-indicator">
            <span>Cargando datos...</span>
        </div>
    }
    else
    {
        <div class="dashboard-cards">
            <div class="card">
                <div class="card-header">
                    <h3>Docentes Registrados</h3>
                    <span class="card-icon">👥</span>
                </div>
                <div class="card-body">
                    <div class="stat-number">@dashboardData?.Estadisticas.TotalDocentes</div>
                    <div class="stat-label">Total de docentes</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3>Solicitudes Pendientes</h3>
                    <span class="card-icon">📋</span>
                </div>
                <div class="card-body">
                    <div class="stat-number">@dashboardData?.Estadisticas.EvaluacionesPendientes</div>
                    <div class="stat-label">Por revisar</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3>Solicitudes Validadas</h3>
                    <span class="card-icon">📚</span>
                </div>
                <div class="card-body">
                    <div class="stat-number">@dashboardData?.Estadisticas.SolicitudesFinalizadas</div>
                    <div class="stat-label">En el sistema</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3>Solicitudes Rechazadas</h3>
                    <span class="card-icon">⚡</span>
                </div>
                <div class="card-body">
                    <div class="stat-number">@dashboardData?.Estadisticas.SolicitudesRechazadas</div>
                    <div class="stat-label">Rechazadas</div>
                </div>
            </div>
        </div>

        <!-- Sección de solicitudes pendientes -->
        <div class="solicitudes-section">
            <h2>Solicitudes Docencia</h2>
            <div class="table-container">
                @if (dashboardData?.Solicitudes.Count > 0)
                {
                    <table class="solicitudes-table">
                        <thead>
                            <tr>
                                <th>Cédula</th>
                                <th>Docente</th>
                                <th>Nivel</th>
                                <th>Fecha</th>
                                <th>Tiempo Espera</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in dashboardData.Solicitudes)
                            {
                                <tr>
                                    <td class="cedula">@solicitud.Codigo</td>
                                    <td class="docente">@solicitud.NombreDocente</td>
                                    <td class="nivel">@solicitud.Nivel</td>
                                    <td class="fecha">@solicitud.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="tiempo-espera">@solicitud.TiempoEspera</td>
                                    <td>
                                        <span class="estado-badge @GetEstadoClass(solicitud.Estado)">
                                            @solicitud.Estado
                                        </span>
                                    </td>
                                    <td class="acciones">
                                        <button class="btn-validar" @onclick="() => ValidarSolicitud(solicitud.Id)">
                                            <span class="btn-icon">✓</span>
                                            Validar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="no-solicitudes">
                        <p>No hay solicitudes pendientes en este momento.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

