@code {
    private bool cargando = true;
    private DashboardDataDto dashboardData;

    protected override async Task OnInitializedAsync()
    {
        await UserSessionService.CargarUsuarioAsync();
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            dashboardData = await Http.GetFromJsonAsync<DashboardDataDto>("/api/Postulaciones/Dashboard");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cargar datos: {ex.Message}");
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

   private async Task ValidarSolicitud(int solicitudId)
{
    try
    {
        // Buscar la solicitud en el dashboard para obtener el código
        var respuestaDashboard = await Http.GetAsync("api/Postulaciones/dashboard");
        
        if (respuestaDashboard.IsSuccessStatusCode)
        {
            var dashboardData = await respuestaDashboard.Content.ReadFromJsonAsync<DashboardDataDto>();
            
            // Buscar la solicitud por ID
            var solicitud = dashboardData?.Solicitudes.FirstOrDefault(s => s.Id == solicitudId);
            
            if (solicitud != null && !string.IsNullOrEmpty(solicitud.Codigo))
            {
                // Crear datos para validación con el usuario actual
                var validacion = new ValidacionDto
                {
                    Usuario = $"{UserSessionService.Usuario?.Nombre1} {UserSessionService.Usuario?.Apellido1} ({DateTime.UtcNow:yyyy-MM-dd HH:mm:ss})"
                };

                // Redirigir a la página de administrador con el código del docente
                NavigationManager.NavigateTo($"/administrador?codigo={solicitud.Codigo}");
                
                Console.WriteLine($"[2025-06-26 18:03:37] Usuario: materubag, Redirigiendo a administrador con código: {solicitud.Codigo}");
            }
            else
            {
                ToastService.ShowError("No se encontró la solicitud o no tiene código asociado");
                Console.WriteLine($"[2025-06-26 18:03:37] Usuario: materubag, No se encontró la solicitud ID: {solicitudId}");
            }
        }
        else
        {
            var errorMsg = await respuestaDashboard.Content.ReadAsStringAsync();
            ToastService.ShowError($"Error al obtener datos del dashboard: {errorMsg}");
            Console.WriteLine($"[2025-06-26 18:03:37] Usuario: materubag, Error dashboard: {errorMsg}");
        }
    }
    catch (Exception ex)
    {
        ToastService.ShowError($"Error al procesar la solicitud: {ex.Message}");
        Console.WriteLine($"[2025-06-26 18:03:37] Usuario: materubag, Error: {ex.Message}");
    }
}

    private void VerDetalles(int solicitudId)
    {
        NavigationManager.NavigateTo($"/admin/solicitud/{solicitudId}");
    }

    private string GetEstadoClass(string estado)
    {
        if (string.IsNullOrEmpty(estado)) return "pendiente";
        
        if (estado.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase))
            return "pendiente";
        else if (estado.Contains("REVISION", StringComparison.OrdinalIgnoreCase))
            return "en-revision";
        else if (estado.Contains("RECHAZADO", StringComparison.OrdinalIgnoreCase))
            return "rechazado";
        else if (estado.Contains("APROBADO", StringComparison.OrdinalIgnoreCase))
            return "aprobado";
        else
            return "otro";
    }

    // Clases DTO para recibir datos del backend
    public class DashboardDataDto
    {
        public DashboardEstadisticasDto Estadisticas { get; set; }
        public List<SolicitudDocenteDto> Solicitudes { get; set; } = new List<SolicitudDocenteDto>();
    }

    public class DashboardEstadisticasDto
    {
        public int TotalDocentes { get; set; }
        public int EvaluacionesPendientes { get; set; }
        public int SolicitudesFinalizadas { get; set; }
        public int SolicitudesRechazadas { get; set; }
    }

    public class SolicitudDocenteDto
    {
        public int Id { get; set; }
        public string Codigo { get; set; }
        public string NombreDocente { get; set; }
        public string Nivel { get; set; }
        public DateTime Fecha { get; set; }
        public string TiempoEspera { get; set; }
        public string Estado { get; set; }
    }

    public class ValidacionDto
    {
        public string Usuario { get; set; }
    }
}