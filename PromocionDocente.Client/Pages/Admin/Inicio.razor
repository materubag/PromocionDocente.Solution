@page "/admin"
@layout AdminLayout

<PageTitle>Panel de Administración</PageTitle>

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h1>Panel de Administración</h1>
        <p>Bienvenido al sistema de gestión de promoción docente</p>
    </div>

    <div class="dashboard-cards">
        <div class="card">
            <div class="card-header">
                <h3>Docentes Registrados</h3>
                <span class="card-icon">👥</span>
            </div>
            <div class="card-body">
                <div class="stat-number">@totalDocentes</div>
                <div class="stat-label">Total de docentes</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Solicitudes Pendientes</h3>
                <span class="card-icon">📋</span>
            </div>
            <div class="card-body">
                <div class="stat-number">@evaluacionesPendientes</div>
                <div class="stat-label">Por revisar</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Solicitudes Validadas</h3>
                <span class="card-icon">📚</span>
            </div>
            <div class="card-body">
                <div class="stat-number">@solicitudesFinalizadas</div>
                <div class="stat-label">En el sistema</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Solicitudes en Revisión</h3>
                <span class="card-icon">⚡</span>
            </div>
            <div class="card-body">
                <div class="stat-number">@procesosActivos</div>
                <div class="stat-label">En Proceso</div>
            </div>
        </div>
    </div>

    <!-- Nueva sección de solicitudes pendientes -->
    <div class="solicitudes-section">
        <h2>Solicitudes Docencia</h2>
        <div class="table-container">
            <table class="solicitudes-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Docente</th>
                        <th>Nivel</th>
                        <th>Fecha</th>
                        <th>Tiempo Espera</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var solicitud in solicitudesPendientes)
                    {
                        <tr>
                            <td class="codigo">@solicitud.Codigo</td>
                            <td class="docente">@solicitud.NombreDocente</td>
                            <td class="nivel">@solicitud.Nivel</td>
                            <td class="fecha">@solicitud.Fecha.ToString("dd/MM/yyyy")</td>
                            <td class="tiempo-espera">@solicitud.TiempoEspera</td>
                            <td>
                                <span class="estado-badge @(solicitud.Estado.ToLower())">
                                    @solicitud.Estado
                                </span>
                            </td>
                            <td class="acciones">
                                <button class="btn-validar" @onclick="() => ValidarSolicitud(solicitud.Id)">
                                    <span class="btn-icon">✓</span>
                                    Validar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @*<div class="dashboard-actions">
        <h2>Acciones Rápidas</h2>
        <div class="action-buttons">
            <a href="/admin/docente" class="action-btn primary">
                <span class="btn-icon">👥</span>
                Gestionar Docentes
            </a>
            <a href="/admin/evaluaciones" class="action-btn secondary">
                <span class="btn-icon">📋</span>
                Ver Evaluaciones
            </a>
            <a href="/admin/reportes" class="action-btn tertiary">
                <span class="btn-icon">📊</span>
                Generar Reportes
            </a>
        </div>
    </div>*@
</div>

