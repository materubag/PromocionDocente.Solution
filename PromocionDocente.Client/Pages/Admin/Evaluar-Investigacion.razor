		flex-direction: column;
	}

		.revisar-buttons button {
			width: 100%;
		}

	}

	/* Estilos para la alerta tipo toast */
	.toast-alert {
		position: fixed;
		top: 20px;
		right: 20px;
		background: white;
		border-radius: 12px;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
		min-width: 350px;
		max-width: 400px;
		z-index: 9999;
		display: flex;
		align-items: flex-start;
		padding: 1rem;
		gap: 0.75rem;
		animation: slideInRight 0.4s ease-out;
		border-left: 4px solid;
	}

	.toast-success {
