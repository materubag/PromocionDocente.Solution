@code {
	private List<InvestigacionInfoEval> investigaciones = new();
	private List<InvestigacionInfoEval> investigacionesFiltradas = new();
	private string cedulaDocente = "";
	
	// Variables para la alerta
	private bool mostrarAlerta = false;
	private string tipoAlerta = "";
	private string tituloAlerta = "";
	private string mensajeAlerta = "";

	protected override async Task OnInitializedAsync()
	{
		// Leer la cédula desde el querystring
		var uri = new Uri(Navigation.Uri);
		var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
		cedulaDocente = query["cedula"] ?? "";

		await CargarInvestigaciones();
	}

	private async Task CargarInvestigaciones()
	{
		try
		{
			if (string.IsNullOrEmpty(cedulaDocente))
			{
				investigacionesFiltradas = new();
				return;
			}

			investigaciones = await Http.GetFromJsonAsync<List<InvestigacionInfoEval>>($"/api/Investigaciones/cedula/{cedulaDocente}") ?? new();
			investigacionesFiltradas = investigaciones;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al cargar investigaciones: {ex.Message}");
			investigacionesFiltradas = new();
			MostrarAlerta("error", "Error al cargar datos", 
				"No se pudieron cargar las investigaciones del docente.");
		}
	}

	private void SeleccionarTodas(ChangeEventArgs e)
	{
		bool seleccionar = e.Value as bool? ?? false;
		foreach (var inv in investigacionesFiltradas)
		{
			inv.Seleccionada = seleccionar;
		}
	}

	private string GetClaseDuracion(int duracionMeses)
	{
		if (duracionMeses <= 6) return "duracion-corta";
		if (duracionMeses <= 12) return "duracion-media";
		if (duracionMeses <= 18) return "duracion-larga";
		return "duracion-extensa";
	}

	private string GetClaseEstado(string? estado)
	{
		return (estado ?? "").ToLower().Replace(" ", "-") switch
		{
			"en-curso" => "estado-en-curso",
			"completada" => "estado-completada",
			"planificada" => "estado-planificada",
			"suspendida" => "estado-suspendida",
			"borrador" => "estado-borrador",
			"aprobado" or "APROBADO" => "estado-aprobado",
			"rechazado" or "RECHAZADO" => "estado-rechazado",
			_ => "estado-borrador"
		};
	}

	private async Task VerPDF(InvestigacionInfoEval investigacion)
	{
		if (string.IsNullOrEmpty(investigacion.archivoPdf))
		{
			MostrarAlerta("info", "PDF no disponible", 
				"No hay documento PDF asociado a esta investigación.");
			return;
		}

		try
		{
			// Abrir PDF en nueva ventana
			await JSRuntime.InvokeVoidAsync("window.open", investigacion.archivoPdf, "_blank");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al abrir PDF: {ex.Message}");
			MostrarAlerta("error", "Error al abrir PDF", 
				"No se pudo abrir el documento PDF. Verifique que la URL sea válida.");
		}
	}

	private void RevisarInvestigacion(InvestigacionInfoEval investigacion)
	{
		foreach (var i in investigacionesFiltradas)
			i.MostrandoRevision = false;
		investigacion.MostrandoRevision = true;
		StateHasChanged();
	}

	private void OcultarRevision(InvestigacionInfoEval investigacion)
	{
		investigacion.MostrandoRevision = false;
		investigacion.Observacion = "";
		StateHasChanged();
	}

	private async Task AprobarInvestigacion(InvestigacionInfoEval investigacion)
	{
		try
		{
			investigacion.Estado = "APROBADO";
			investigacion.MostrandoRevision = false;
			var dto = new EstadoUpdateDto
			{
				Estado = "APROBADO",
				Observacion = string.IsNullOrEmpty(investigacion.Observacion) ? "Cumple con todos los requisitos" : investigacion.Observacion
			};
			await Http.PutAsJsonAsync($"/api/Investigaciones/estado/{investigacion.IdInvestigacion}", dto);
			
			// Mostrar alerta de éxito
			MostrarAlerta("success", "¡Investigación aprobada!", 
				$"'{investigacion.TituloInvestigacion}' ha sido aprobada exitosamente.");
		}
		catch
		{
			// Mostrar alerta de error
			MostrarAlerta("error", "Error al aprobar", 
				"No se pudo aprobar la investigación. Inténtalo de nuevo.");
		}
		StateHasChanged();
	}

	private async Task RechazarInvestigacion(InvestigacionInfoEval investigacion)
	{
		if (string.IsNullOrWhiteSpace(investigacion.Observacion))
		{
			MostrarAlerta("error", "Observación requerida", 
				"Debe ingresar una observación para rechazar.");
			return;
		}
		
		try
		{
			investigacion.Estado = "RECHAZADO";
			investigacion.MostrandoRevision = false;
			var dto = new EstadoUpdateDto
			{
				Estado = "RECHAZADO",
				Observacion = investigacion.Observacion
			};
			await Http.PutAsJsonAsync($"/api/Investigaciones/estado/{investigacion.IdInvestigacion}", dto);
			
			// Mostrar alerta de éxito
			MostrarAlerta("success", "Investigación rechazada", 
				$"'{investigacion.TituloInvestigacion}' ha sido rechazada.");
		}
		catch
		{
			// Mostrar alerta de error
			MostrarAlerta("error", "Error al rechazar", 
				"No se pudo rechazar la investigación. Inténtalo de nuevo.");
		}
		StateHasChanged();
	}
	
	private void MostrarAlerta(string tipo, string titulo, string mensaje)
	{
		tipoAlerta = tipo;
		tituloAlerta = titulo;
		mensajeAlerta = mensaje;
		mostrarAlerta = true;
		StateHasChanged();
		
		// Auto-cerrar después de 4 segundos (más rápido para toast)
		_ = Task.Delay(4000).ContinueWith(_ => 
		{
			InvokeAsync(() =>
			{
				if (mostrarAlerta)
				{
					CerrarAlerta();
				}
			});
		});
	}
	
	private void CerrarAlerta()
	{
		mostrarAlerta = false;
		StateHasChanged();
	}

	private void Volver()
	{
		// Navega de vuelta incluyendo la cédula
		Navigation.NavigateTo($"/administrador?codigo={cedulaDocente}");
	}

	public class InvestigacionInfoEval
	{
		public int IdInvestigacion { get; set; }
		public string TituloInvestigacion { get; set; } = "";
		public int DuracionMeses { get; set; }
		public DateTime FechaInicio { get; set; }
		public DateTime FechaFin { get; set; }
		public string TipoInvestigacion { get; set; } = "";
		public string CampoAplicacion { get; set; } = "";
		public string Estado { get; set; } = "";
		public bool Seleccionada { get; set; }
		public string archivoPdf { get; set; } = "";
		public bool TieneArchivoPDF { get; set; }
		public string Observacion { get; set; } = "";
		public bool MostrandoRevision { get; set; } = false;
	}

	public class EstadoUpdateDto
	{
		public string Estado { get; set; } = "";
		public string Observacion { get; set; } = "";
	}
}