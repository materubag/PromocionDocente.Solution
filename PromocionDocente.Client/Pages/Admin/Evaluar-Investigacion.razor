@code {
    private List<InvestigacionInfoEval> investigaciones = new();
    private List<InvestigacionInfoEval> investigacionesFiltradas = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarInvestigaciones();
    }

    private async Task CargarInvestigaciones()
    {
        try
        {
            investigaciones = await Http.GetFromJsonAsync<List<InvestigacionInfoEval>>($"/api/Investigaciones");
            investigacionesFiltradas = investigaciones;
        }
        catch
        {
            investigacionesFiltradas = new();
        }
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var inv in investigacionesFiltradas)
        {
            inv.Seleccionada = seleccionar;
        }
    }

    private string GetClaseDuracion(int duracionMeses)
    {
        if (duracionMeses <= 6) return "duracion-corta";
        if (duracionMeses <= 12) return "duracion-media";
        if (duracionMeses <= 18) return "duracion-larga";
        return "duracion-extensa";
    }

    private string GetClaseEstado(string? estado)
    {
        return (estado ?? "").ToLower().Replace(" ", "-") switch
        {
            "en-curso" => "estado-en-curso",
            "completada" => "estado-completada",
            "planificada" => "estado-planificada",
            "suspendida" => "estado-suspendida",
            "borrador" => "estado-borrador",
            "aprobado" => "estado-aprobado",
            "rechazado" => "estado-rechazado",
            _ => "estado-borrador"
        };
    }

    private async Task VerPDF(InvestigacionInfoEval investigacion)
    {
        if (!string.IsNullOrEmpty(investigacion.archivoPdf))
            await JSRuntime.InvokeVoidAsync("window.open", investigacion.archivoPdf, "_blank");
    }

    private void RevisarInvestigacion(InvestigacionInfoEval investigacion)
    {
        foreach (var i in investigacionesFiltradas)
            i.MostrandoRevision = false;
        investigacion.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(InvestigacionInfoEval investigacion)
    {
        investigacion.MostrandoRevision = false;
        investigacion.Observacion = "";
        StateHasChanged();
    }

    private async Task AprobarInvestigacion(InvestigacionInfoEval investigacion)
    {
        investigacion.Estado = "Aprobado";
        investigacion.MostrandoRevision = false;
        // Utilizando el DTO EstadoUpdateDto para la petición
        var dto = new EstadoUpdateDto
        {
            Estado = investigacion.Estado,
            Observacion = ""
        };
        await Http.PutAsJsonAsync($"/api/Investigaciones/estado/{investigacion.IdInvestigacion}", dto);
        StateHasChanged();
    }

    private async Task RechazarInvestigacion(InvestigacionInfoEval investigacion)
    {
        if (string.IsNullOrWhiteSpace(investigacion.Observacion))
        {

            await JSRuntime.InvokeVoidAsync("alert", "Debe ingresar una observación para rechazar.");
            return;

        }
        investigacion.Estado = "Rechazado";
        investigacion.MostrandoRevision = false;
        // Utilizando el DTO EstadoUpdateDto para la petición
        var dto = new EstadoUpdateDto
        {
            Estado = investigacion.Estado,
            Observacion = investigacion.Observacion
        };
        await Http.PutAsJsonAsync($"/api/Investigaciones/estado/{investigacion.IdInvestigacion}", dto);
        StateHasChanged();
    }

    public class InvestigacionInfoEval
    {
        public int IdInvestigacion { get; set; }
        public string TituloInvestigacion { get; set; } = "";
        public int DuracionMeses { get; set; }
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public string TipoInvestigacion { get; set; } = "";
        public string CampoAplicacion { get; set; } = "";
        public string Estado { get; set; } = "";
        public bool Seleccionada { get; set; }
        public string archivoPdf { get; set; } = "";
        public bool TieneArchivoPDF { get; set; }
        public string Observacion { get; set; } = "";
        public bool MostrandoRevision { get; set; } = false;
    }

    // Agregado DTO para actualizar el estado y la observación
    public class EstadoUpdateDto
    {
        public string Estado { get; set; }
        public string Observacion { get; set; }
    }
}