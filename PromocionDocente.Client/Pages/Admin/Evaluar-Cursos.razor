@code {
    private List<CursoCapacitacionInfo> cursos = new();
    private List<CursoCapacitacionInfo> cursosFiltrados = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarCursos();
    }

    private async Task CargarCursos()
    {
        try
        {
            // Ajusta la URL según tu API/backend real
            cursos = await Http.GetFromJsonAsync<List<CursoCapacitacionInfo>>($"/api/CursosCapacitacions");
            cursosFiltrados = cursos;
        }
        catch
        {
            cursosFiltrados = new();
        }
    }

    private string GetClaseEstado(string estado)
    {
        return estado.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "en progreso" => "estado-en-progreso",
            "en validación" => "estado-en-validacion",
            "validado" => "estado-validado",
            "aprobado" => "estado-aprobado",
            "rechazado" => "estado-rechazado",
            _ => "estado-pendiente"
        };
    }

    private async Task VerPDF(CursoCapacitacionInfo curso)
    {
        if (!string.IsNullOrEmpty(curso.pdfCurso))
            await JSRuntime.InvokeVoidAsync("window.open", curso.pdfCurso, "_blank");
    }

    private void RevisarCurso(CursoCapacitacionInfo curso)
    {
        foreach (var c in cursosFiltrados)
            c.MostrandoRevision = false;
        curso.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(CursoCapacitacionInfo curso)
    {
        curso.MostrandoRevision = false;
        curso.Observacion = "";
        StateHasChanged();
    }

    private async Task AprobarCurso(CursoCapacitacionInfo curso)
    {
        curso.Estado = "Aprobado";
        curso.Observacion = "";
        curso.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = curso.Estado,
            Observacion = ""
        };
        await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
        StateHasChanged();
    }

    private async Task RechazarCurso(CursoCapacitacionInfo curso)
    {
        if (string.IsNullOrWhiteSpace(curso.Observacion))
        {

            isLoading = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(evaluacion.DecisionSeleccionada) || string.IsNullOrEmpty(evaluacion.Comentarios))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Por favor seleccione el estado de la evaluación y haga un comentario");
                return;
            }

            await Task.Delay(1500);

            string nuevoEstado = evaluacion.DecisionSeleccionada;

            // CORRECCIÓN: Solo actualizar el curso seleccionado, no todos
            if (cursoSeleccionado != null)
            {
                cursoSeleccionado.Estado = nuevoEstado;

                // Guardar estado individual del curso en localStorage
                await JSRuntime.InvokeVoidAsync("localStorage.setItem",
                    $"curso_{cursoSeleccionado.Id}_estado", nuevoEstado);
            }

            // OPCIONAL: Solo marcar el documento como evaluado si TODOS los cursos están evaluados
            var todosEvaluados = Cursos.All(c => c.Estado == "Aprobado" || c.Estado == "Rechazado");
            if (todosEvaluados)
            {
                // Determinar el estado general basado en la mayoría
                var aprobados = Cursos.Count(c => c.Estado == "Aprobado");
                var rechazados = Cursos.Count(c => c.Estado == "Rechazado");
                var estadoGeneral = aprobados >= rechazados ? "Aprobado" : "Rechazado";

                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "documento_3_estado", estadoGeneral);
            }

            var evaluacionData = new
            {
                CursoId = cursoSeleccionado?.Id,
                CursoNombre = cursoSeleccionado?.Nombre,
                Estado = evaluacion.DecisionSeleccionada,
                Comentarios = evaluacion.Comentarios ?? "",
                Fecha = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss"),
                Evaluador = "Cuadrado1224"
            };

            // Guardar evaluación específica del curso
            await JSRuntime.InvokeVoidAsync("localStorage.setItem",
                $"evaluacion_curso_{cursoSeleccionado?.Id}",
                System.Text.Json.JsonSerializer.Serialize(evaluacionData));

            await JSRuntime.InvokeVoidAsync("alert",
                $"✅ Curso '{cursoSeleccionado?.Nombre}' evaluado como {nuevoEstado}");

            CerrarModal();
            FiltrarCursos();
        }
        curso.Estado = "Rechazado";
        curso.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = curso.Estado,
            Observacion = curso.Observacion
        };
        await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
        StateHasChanged();
    }

    public class CursoCapacitacionInfo
    {
        public int IdCurso { get; set; }
        public string NombreCurso { get; set; } = "";
        public DateTime FechaCurso { get; set; }
        public int Horas { get; set; }
        public string pdfCurso { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Observacion { get; set; } = "";
        public bool MostrandoRevision { get; set; } = false;
    }

    // DTO para actualizar estado y observacion
    public class EstadoUpdateDto
    {
        public string Estado { get; set; }
        public string Observacion { get; set; }
    }
}