@page "/evaluar-cursos"
@using System.Net.Http.Json
@using System.Web
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Navigation

<!-- Font Awesome para iconos -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="capacitaciones-container">
    <!-- Alerta de éxito/error -->
    @if (mostrarAlerta)
    {
        <div class="toast-alert @(tipoAlerta == "success" ? "toast-success" : tipoAlerta == "error" ? "toast-error" : "toast-info")">
            <div class="toast-icon">
                @if (tipoAlerta == "success")
                {
                    <i class="fas fa-check-circle"></i>
                }
                else if (tipoAlerta == "error")
                {
                    <i class="fas fa-exclamation-triangle"></i>
                }
                else
                {
                    <i class="fas fa-info-circle"></i>
                }
            </div>
            <div class="toast-content">
                <h6 class="toast-title">@tituloAlerta</h6>
                <p class="toast-message">@mensajeAlerta</p>
            </div>
            <button class="toast-close" @onclick="CerrarAlerta">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }


    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">← Volver</button>
            <h1 class="titulo-principal">Sistema de Gestión de Cursos</h1>
            <div class="spacer"></div>
        </div>
    </div>
    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="tabla-cursos">
                <table class="cursos-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" @onchange="SeleccionarTodos" />
                            </th>
                            <th class="col-nombre">Nombre del Curso</th>
                            <th class="col-fecha">Fecha</th>
                            <th class="col-horas">Horas</th>
                            <th class="col-documento">Documento</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cursosFiltrados != null && cursosFiltrados.Any())
                        {
                            @foreach (var curso in cursosFiltrados)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" @bind="curso.Seleccionado" />
                                    </td>
                                    <td class="nombre-cell">@curso.NombreCurso</td>
                                    <td>@curso.FechaCurso.ToString("dd/MM/yyyy")</td>
                                    <td class="horas-cell">@curso.Horas h</td>
                                    <td class="documento">
                                        @if (!string.IsNullOrEmpty(curso.pdfCurso))
                                        {
                                            <button class="btn-documento" @onclick="() => VerPDF(curso)" title="Ver PDF">
                                                <span class="documento-icon">📄</span>
                                                <span class="documento-text">PDF</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(curso.Estado ?? "")">
                                            @curso.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-revisar" @onclick="() => RevisarCurso(curso)">Revisar</button>
                                        @if (((curso.Estado ?? "").ToLower() == "rechazado" || (curso.Estado ?? "").ToUpper() == "RECHAZADO") && !string.IsNullOrEmpty(curso.Observacion))
                                        {
                                            <span title="@curso.Observacion" class="obs-icon">🛈 Obs.</span>
                                        }
                                    </td>
                                </tr>
                                @if (curso.MostrandoRevision)
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="revisar-panel">
                                                <textarea @bind="curso.Observacion"
                                                          placeholder="Ingrese observación (opcional para aprobar, obligatoria para rechazar)"
                                                          class="obs-textarea"></textarea>
                                                <div class="revisar-buttons">
                                                    <button class="btn-aprobar" @onclick="() => AprobarCurso(curso)">Aprobar</button>
                                                    <button class="btn-rechazar" @onclick="() => RechazarCurso(curso)">Rechazar</button>
                                                    <button class="btn-cancelar-revision" @onclick="() => OcultarRevision(curso)">Cancelar</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-data">No se encontraron cursos</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

