</style>

@code {
    private List<CursoCapacitacionInfo> cursos = new();
    private List<CursoCapacitacionInfo> cursosFiltrados = new();
    private string cedulaDocente = "";
    
    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";

    protected override async Task OnInitializedAsync()
    {
        // Leer la cédula desde el querystring
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        cedulaDocente = query["cedula"] ?? "";

        await CargarCursos();
    }

    private async Task CargarCursos()
    {
        try
        {
            // Usar el endpoint correcto para obtener cursos por cédula
            var cursosResponse = await Http.GetFromJsonAsync<List<CursoCapacitacionInfo>>($"/api/CursosCapacitacions/cedula/{cedulaDocente}");
            cursos = cursosResponse ?? new();
            cursosFiltrados = cursos;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando cursos: {ex.Message}");
            cursos = new();
            cursosFiltrados = new();
            MostrarAlerta("error", "Error al cargar cursos", 
                "No se pudieron cargar los cursos. Inténtalo de nuevo.");
        }
    }

    private string GetClaseEstado(string estado)
    {
        return estado?.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "en progreso" => "estado-en-progreso",
            "en validación" => "estado-en-validacion",
            "validado" => "estado-validado",
            "aprobado" or "APROBADO" => "estado-aprobado",
            "rechazado" or "RECHAZADO" => "estado-rechazado",
            _ => "estado-pendiente"
        };
    }

    private async Task VerPDF(CursoCapacitacionInfo curso)
    {
        if (string.IsNullOrEmpty(curso.pdfCurso))
        {
            MostrarAlerta("info", "PDF no disponible", 
                "No hay documento PDF asociado a este curso.");
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("window.open", curso.pdfCurso, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir PDF: {ex.Message}");
            MostrarAlerta("error", "Error al abrir PDF", 
                "No se pudo abrir el documento PDF. Verifique que la URL sea válida.");
        }
    }

    private void RevisarCurso(CursoCapacitacionInfo curso)
    {
        foreach (var c in cursosFiltrados)
            c.MostrandoRevision = false;
        curso.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(CursoCapacitacionInfo curso)
    {
        curso.MostrandoRevision = false;
        curso.Observacion = "";
        StateHasChanged();
    }

    private async Task AprobarCurso(CursoCapacitacionInfo curso)
    {
        try
        {
            curso.Estado = "APROBADO";
            curso.MostrandoRevision = false;
            var dto = new EstadoUpdateDto
            {
                Estado = "APROBADO",
                Observacion = string.IsNullOrEmpty(curso.Observacion) ? "Cumple con todos los requisitos" : curso.Observacion
            };
            await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
            
            // Mostrar alerta de éxito
            MostrarAlerta("success", "¡Curso aprobado!", 
                $"'{curso.NombreCurso}' ha sido aprobado exitosamente.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al aprobar curso: {ex.Message}");
            // Mostrar alerta de error
            MostrarAlerta("error", "Error al aprobar", 
                "No se pudo aprobar el curso. Inténtalo de nuevo.");
        }
        StateHasChanged();
    }

    private async Task RechazarCurso(CursoCapacitacionInfo curso)
    {
        if (string.IsNullOrWhiteSpace(curso.Observacion))
        {
            MostrarAlerta("error", "Observación requerida", 
                "Debe ingresar una observación para rechazar.");
            return;
        }
        
        try
        {
            curso.Estado = "RECHAZADO";
            curso.MostrandoRevision = false;
            var dto = new EstadoUpdateDto
            {
                Estado = "RECHAZADO",
                Observacion = curso.Observacion
            };
            await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
            
            // Mostrar alerta de éxito
            MostrarAlerta("success", "Curso rechazado", 
                $"'{curso.NombreCurso}' ha sido rechazado.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al rechazar curso: {ex.Message}");
            // Mostrar alerta de error
            MostrarAlerta("error", "Error al rechazar", 
                "No se pudo rechazar el curso. Inténtalo de nuevo.");
        }
        StateHasChanged();
    }

    private void SeleccionarTodos(ChangeEventArgs e)
    {
        var seleccionarTodos = (bool)e.Value!;
        foreach (var curso in cursosFiltrados)
        {
            curso.Seleccionado = seleccionarTodos;
        }
        StateHasChanged();
    }
    
    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();
        
        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ => 
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }
    
    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }



    private void Volver()
    {
        // Navega de vuelta incluyendo la cédula
        Navigation.NavigateTo($"/administrador?codigo={cedulaDocente}");
    }

    public class CursoCapacitacionInfo
    {
        public int IdCurso { get; set; }
        public string NombreCurso { get; set; } = "";
