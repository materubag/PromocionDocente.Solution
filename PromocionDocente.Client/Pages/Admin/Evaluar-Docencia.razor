</style>

@code {
    private List<CursoCapacitacionInfo> cursos = new();
    private List<CursoCapacitacionInfo> cursosFiltrados = new();

    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";

    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }

    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarCursos();
    }

    private async Task CargarCursos()
    {
        try
        {
            // Ajusta la URL según tu API/backend real
            cursos = await Http.GetFromJsonAsync<List<CursoCapacitacionInfo>>($"/api/CursosCapacitacions");
            cursosFiltrados = cursos;
        }
        catch
        {
            cursosFiltrados = new();
        }
    }

    private string GetClaseEstado(string estado)
    {
        return estado.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "en progreso" => "estado-en-progreso",
            "en validación" => "estado-en-validacion",
            "validado" => "estado-validado",
            "aprobado" => "estado-aprobado",
            "rechazado" => "estado-rechazado",
            _ => "estado-pendiente"
        };
    }

    private async Task VerPDF(CursoCapacitacionInfo curso)
    {
        if (!string.IsNullOrEmpty(curso.pdfCurso))
            await JSRuntime.InvokeVoidAsync("window.open", curso.pdfCurso, "_blank");
    }

    private void RevisarCurso(CursoCapacitacionInfo curso)
    {
        foreach (var c in cursosFiltrados)
            c.MostrandoRevision = false;
        curso.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(CursoCapacitacionInfo curso)
    {
        curso.MostrandoRevision = false;
        curso.Observacion = "";
        StateHasChanged();
    }

    private async Task AprobarCurso(CursoCapacitacionInfo curso)
    {
        curso.Estado = "Aprobado";
        curso.Observacion = "";
        curso.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = curso.Estado,
            Observacion = ""
        };
        await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
        StateHasChanged();
    }

    private async Task RechazarCurso(CursoCapacitacionInfo curso)
    {
        if (string.IsNullOrWhiteSpace(curso.Observacion))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe ingresar una observación para rechazar.");
            return;
        }
        curso.Estado = "Rechazado";
        curso.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = curso.Estado,
            Observacion = curso.Observacion
        };
        await Http.PutAsJsonAsync($"/api/CursosCapacitacions/estado/{curso.IdCurso}", dto);
        StateHasChanged();
    }

    private void Volver()
    {
        Navigation.NavigateTo("/administrador");
    }

    public class CursoCapacitacionInfo
    {
        public int IdCurso { get; set; }
        public string NombreCurso { get; set; } = "";
        public DateTime FechaCurso { get; set; }
        public int Horas { get; set; }
        public string pdfCurso { get; set; } = "";
        public string Estado { get; set; } = "";
        public string Observacion { get; set; } = "";
        public bool MostrandoRevision { get; set; } = false;
    }

    // DTO para actualizar estado y observacion
    public class EstadoUpdateDto
    {
        public string Estado { get; set; }
        public string Observacion { get; set; }
    }
}