    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoCursos();
        FiltrarCursos();
    }

    private async Task CargarEstadoCursos()
    {
        try
        {
            // Cargar estado individual de cada curso
            foreach (var curso in Cursos)
            {
                var estadoCurso = await JSRuntime.InvokeAsync<string>("localStorage.getItem",
                    $"curso_{curso.Id}_estado");

                if (!string.IsNullOrEmpty(estadoCurso))
                {
                    curso.Estado = estadoCurso;
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estado: {ex.Message}");
        }
    }

    private void FiltrarCursos()
    {
        cursosFiltrados = Cursos.Where(c =>
            string.IsNullOrEmpty(filtroTexto) ||
            c.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            c.Descripcion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            c.Institucion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
        ).ToList();

        StateHasChanged();
    }

