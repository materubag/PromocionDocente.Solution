@page "/evaluar-doc"

@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="capacitaciones-container">
    @if (mostrarAlerta)
    {
        <div class="toast-alert @(tipoAlerta == "success" ? "toast-success" : tipoAlerta == "error" ? "toast-error" : "toast-info")">
            <div class="toast-icon">
                @if (tipoAlerta == "success")
                {
                    <i class="fas fa-check-circle"></i>
                }
                else if (tipoAlerta == "error")
                {
                    <i class="fas fa-exclamation-triangle"></i>
                }
                else
                {
                    <i class="fas fa-info-circle"></i>
                }
            </div>
            <div class="toast-content">
                <h6 class="toast-title">@tituloAlerta</h6>
                <p class="toast-message">@mensajeAlerta</p>
            </div>
            <button class="toast-close" @onclick="CerrarAlerta">
                <i class="fas fa-times"></i>
            </button>
        </div>
    }

    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">← Volver</button>
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="spacer"></div>
        </div>
    </div>
    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="tabla-cursos">
                <table class="cursos-table">
                    <thead>
                        <tr>
                            <th>Nombre del Curso</th>
                            <th>Fecha</th>
                            <th>Horas</th>
                            <th>Documento</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cursosFiltrados != null && cursosFiltrados.Any())
                        {
                            @foreach (var curso in cursosFiltrados)
                            {
                                <tr>
                                    <td>@curso.NombreCurso</td>
                                    <td>@curso.FechaCurso.ToString("dd/MM/yyyy")</td>
                                    <td>@curso.Horas h</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(curso.pdfCurso))
                                        {
                                            <button class="btn-documento" @onclick="() => VerPDF(curso)">Ver PDF</button>
                                        }
                                        else
                                        {
                                            MostrarAlerta("error", "Error al cargar PDF",
                                            "No se pudo Mostrar el PDF. Inténtalo de nuevo.");
                                        
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(curso.Estado)">
                                            @curso.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-revisar" @onclick="() => RevisarCurso(curso)">Revisar</button>
                                        @if (curso.Estado.ToLower() == "rechazado" && !string.IsNullOrEmpty(curso.Observacion))
                                        {
                                            <span title="@curso.Observacion" class="obs-icon">🛈 Obs.</span>
                                        }
                                    </td>
                                </tr>
                                @if (curso.MostrandoRevision)
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="revisar-panel">
                                                <textarea @bind="curso.Observacion" placeholder="Ingrese observación (opcional para aprobar, obligatoria para rechazar)" class="obs-textarea"></textarea>
                                                <button class="btn-aprobar" @onclick="() => AprobarCurso(curso)">Aprobar</button>
                                                <button class="btn-rechazar" @onclick="() => RechazarCurso(curso)">Rechazar</button>
                                                <button class="btn-cancelar-revision" @onclick="() => OcultarRevision(curso)">Cancelar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="no-data">No se encontraron cursos</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
