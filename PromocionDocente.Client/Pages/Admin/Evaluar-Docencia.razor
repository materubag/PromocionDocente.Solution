@page "/evaluar-docencia"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="obras-container">
    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>
            <h1 class="titulo-principal">Años de Docencia </h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">Dr. María González</div>
                    <div class="cargo">Investigación - Evaluación en Proceso</div>
                </div>
            </div>
        </div>
    </div>

    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar proyectos..." @bind="filtroTexto" @oninput="FiltrarProyectos" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="ActualizarEstados">
                        <span class="btn-icon">🔄</span>
                        Actualizar
                    </button>
                    <button class="btn btn-primary" @onclick="VerResumen">
                        <span class="btn-icon">📊</span>
                        Resumen
                    </button>
                </div>
            </div>

            <div class="tabla-obras">
                <table class="obras-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodos" />
                            </th>
                            <th class="col-tipo">Proyecto</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-fecha">Fecha Inicio</th>
                            <th class="col-evaluador">Duración</th>
                            <th class="col-documento">Ver PDF</th>
                            <th class="col-accion">Evaluar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (proyectosFiltrados != null && proyectosFiltrados.Any())
                        {
                            @foreach (var proyecto in proyectosFiltrados)
                            {
                                <tr class="@(proyecto.Seleccionado ? "selected" : "") @(proyecto.Estado == "Completo" ? "completed" : "pending")">
                                    <td>
                                        <input type="checkbox" @bind="proyecto.Seleccionado" />
                                    </td>
                                    <td>
                                        <div class="documento-info">
                                            <i class="fas fa-flask @(proyecto.Estado == "Completo" ? "text-success" : "text-warning") me-2"></i>
                                            <div class="titulo-info">
                                                <span class="titulo-texto">@proyecto.Nombre</span>
                                                <small class="observaciones">@proyecto.Descripcion</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-estado @(proyecto.Estado == "Completo" ? "estado-completo" : "estado-pendiente")">
                                            @proyecto.Estado
                                        </span>
                                    </td>
                                    <td>@proyecto.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="area-badge">@proyecto.Duracion meses</span>
                                    </td>
                                    <td class="documento">
                                        <button class="btn-documento" @onclick="() => VerDocumento(proyecto)" title="Ver PDF">
                                            <span class="documento-icon">📄</span>
                                            <span class="documento-text">PDF</span>
                                        </button>
                                    </td>
                                    <td class="doi-cell">
                                        <button class="btn-evaluar @(proyecto.Estado == "Completo" ? "btn-reevaluar" : "btn-pendiente")"
                                                @onclick="() => EvaluarProyecto(proyecto)" title="Evaluar proyecto">
                                            <span class="evaluar-icon">@(proyecto.Estado == "Completo" ? "✓" : "⏳")</span>
                                            <span class="evaluar-text">@(proyecto.Estado == "Completo" ? "Re-evaluar" : "Evaluar")</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-data">No se encontraron proyectos de investigación</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @proyectosFiltrados.Count de @Proyectos.Count proyectos
                </div>
                <div class="pagination-controls">
                    <span class="page-info">Proyectos de Investigación</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para evaluar -->
@if (mostrarModal && proyectoSeleccionado != null)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@proyectoSeleccionado.Nombre</h5>
                <button class="btn-close" @onclick="CerrarModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="documento-viewer">
                    <div class="pdf-container">
                        <div class="pdf-placeholder">
                            <i class="fas fa-flask fa-3x text-primary mb-3"></i>
                            <h4>@proyectoSeleccionado.Nombre</h4>
                            <p class="text-muted">Proyecto de Investigación</p>

                            <div class="documento-content">
                                <h6>Detalles del Proyecto:</h6>
                                <p><strong>Título:</strong> @proyectoSeleccionado.Nombre</p>
                                <p><strong>Descripción:</strong> @proyectoSeleccionado.Descripcion</p>
                                <p><strong>Fecha de Inicio:</strong> @proyectoSeleccionado.FechaInicio.ToString("dd/MM/yyyy")</p>
                                <p><strong>Duración:</strong> @proyectoSeleccionado.Duracion meses</p>
                                <p><strong>Estado del Proyecto:</strong> En desarrollo</p>
                                <p><strong>Presupuesto:</strong> $@(proyectoSeleccionado.Id * 5000)</p>
                            </div>
                        </div>
                    </div>

                    <div class="evaluacion-panel">
                        <h6>Evaluación del Proyecto</h6>
                        <EditForm Model="@evaluacion" OnValidSubmit="@GuardarEvaluacion">
                            <div class="mb-4">
                                <label class="form-label">Decisión</label>
                                <div class="decision-group">
                                    <InputRadioGroup @bind-Value="evaluacion.Estado" class="form-check-group">
                                        <div class="decision-option aprobar">
                                            <InputRadio Value="EstadoEvaluacion.Aprobado" class="form-check-input" id="aprobado" />
                                            <label class="form-check-label" for="aprobado">
                                                <i class="fas fa-check-circle"></i>
                                                <span>Aprobar Proyecto</span>
                                            </label>
                                        </div>
                                        <div class="decision-option rechazar">
                                            <InputRadio Value="EstadoEvaluacion.Rechazado" class="form-check-input" id="rechazado" />
                                            <label class="form-check-label" for="rechazado">
                                                <i class="fas fa-times-circle"></i>
                                                <span>Rechazar Proyecto</span>
                                            </label>
                                        </div>
                                    </InputRadioGroup>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="comentarios" class="form-label">Comentarios</label>
                                <InputTextArea @bind-Value="evaluacion.Comentarios"
                                               class="form-control"
                                               id="comentarios"
                                               rows="4"
                                               placeholder="Ingrese sus comentarios sobre el proyecto..." />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-loading me-2"></span>
                                        <text>Guardando...</text>
                                    }
                                    else
                                    {
                                        <text>Guardar Evaluación</text>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

