@page "/evaluar-docencia"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="obras-container">
    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>
            <h1 class="titulo-principal">Cursos y Capacitaciones</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">Dr. María González</div>
                    <div class="cargo">Cursos/Capacitaciones - Evaluación en Proceso</div>
                </div>
            </div>
        </div>
    </div>

    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar cursos..." @bind="filtroTexto" @oninput="FiltrarCursos" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="ActualizarEstados">
                        <span class="btn-icon">🔄</span>
                        Actualizar
                    </button>
                    <button class="btn btn-primary" @onclick="VerResumen">
                        <span class="btn-icon">📊</span>
                        Resumen
                    </button>
                </div>
            </div>

            <div class="tabla-obras">
                <table class="obras-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodos" />
                            </th>
                            <th class="col-tipo">Curso/Capacitación</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-fecha">Fecha Realización</th>
                            <th class="col-evaluador">Duración</th>
                            <th class="col-documento">Ver PDF</th>
                            <th class="col-accion">Evaluar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cursosFiltrados != null && cursosFiltrados.Any())
                        {
                            @foreach (var curso in cursosFiltrados)
                            {
                                <tr class="@(curso.Seleccionado ? "selected" : "") @GetClaseFilaEstado(curso.Estado)">
                                    <td>
                                        <input type="checkbox" @bind="curso.Seleccionado" />
                                    </td>
                                    <td>
                                        <div class="documento-info">
                                            <i class="fas fa-graduation-cap @GetIconoEstado(curso.Estado) me-2"></i>
                                            <div class="titulo-info">
                                                <span class="titulo-texto">@curso.Nombre</span>
                                                <small class="observaciones">@curso.Descripcion</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseBadgeEstado(curso.Estado)">
                                            @curso.Estado
                                        </span>
                                    </td>
                                    <td>@curso.FechaRealizacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="area-badge">@curso.DuracionHoras hrs</span>
                                    </td>
                                    <td class="documento">
                                        <button class="btn-documento" @onclick="() => VerDocumento(curso)" title="Ver PDF">
                                            <span class="documento-icon">📄</span>
                                            <span class="documento-text">PDF</span>
                                        </button>
                                    </td>
                                    <td class="doi-cell">
                                        <button class="btn-evaluar @GetClaseBotonEvaluar(curso.Estado)"
                                                @onclick="() => EvaluarCurso(curso)" title="Evaluar curso">
                                            <span class="evaluar-icon">@GetIconoBotonEvaluar(curso.Estado)</span>
                                            <span class="evaluar-text">@GetTextoBotonEvaluar(curso.Estado)</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-data">No se encontraron cursos o capacitaciones</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @cursosFiltrados.Count de @Cursos.Count cursos
                </div>
                <div class="pagination-controls">
                    <span class="page-info">Cursos y Capacitaciones</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para evaluar -->
@if (mostrarModal && cursoSeleccionado != null)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@cursoSeleccionado.Nombre</h5>
                <button class="btn-close" @onclick="CerrarModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="documento-viewer">
                    <div class="pdf-container">
                        <div class="pdf-placeholder">
                            <i class="fas fa-graduation-cap fa-3x text-primary mb-3"></i>
                            <h4>@cursoSeleccionado.Nombre</h4>
                            <p class="text-muted">Curso de Capacitación</p>

                            <div class="documento-content">
                                <h6>Detalles del Curso:</h6>
                                <p><strong>Nombre:</strong> @cursoSeleccionado.Nombre</p>
                                <p><strong>Descripción:</strong> @cursoSeleccionado.Descripcion</p>
                                <p><strong>Fecha de Realización:</strong> @cursoSeleccionado.FechaRealizacion.ToString("dd/MM/yyyy")</p>
                                <p><strong>Duración:</strong> @cursoSeleccionado.DuracionHoras horas</p>
                                <p><strong>Institución:</strong> @cursoSeleccionado.Institucion</p>
                                <p><strong>Estado Actual:</strong> @cursoSeleccionado.Estado</p>

                                @if (cursoSeleccionado.Id == 1)
                                {
                                    <div class="mt-3">
                                        <h6>Contenido del Curso:</h6>
                                        <ul class="text-start">
                                            <li>Fundamentos de metodologías activas</li>
                                            <li>Implementación práctica en el aula</li>
                                            <li>Evaluación de resultados de aprendizaje</li>
                                            <li>Casos de estudio y mejores prácticas</li>
                                        </ul>
                                    </div>
                                }
                                else if (cursoSeleccionado.Id == 2)
                                {
                                    <div class="mt-3">
                                        <h6>Módulos Completados:</h6>
                                        <ul class="text-start">
                                            <li>Herramientas digitales para la educación</li>
                                            <li>Plataformas de aprendizaje virtual</li>
                                            <li>Gamificación en el aula</li>
                                            <li>Evaluación digital</li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-3">
                                        <h6>Competencias Desarrolladas:</h6>
                                        <p>Desarrollo profesional continuo en el área de especialización académica y pedagógica.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="evaluacion-panel">
                        <h6>Evaluación del Curso</h6>
                        <EditForm Model="@evaluacion" OnValidSubmit="@GuardarEvaluacion">
                            <div class="mb-4">
                                <label class="form-label">Decisión</label>
                                <div class="decision-group">
                                    <!-- CAMBIO: Usar string en lugar de enum -->
                                    <div class="decision-option aprobar">
                                        <input type="radio" name="decision" id="aprobado-curso" value="Aprobado" @onchange="@((args) => CambiarDecision(args))" />
                                        <label class="form-check-label" for="aprobado-curso">
                                            <i class="fas fa-check-circle"></i>
                                            <span>Aprobar Curso</span>
                                        </label>
                                    </div>
                                    <div class="decision-option rechazar">
                                        <input type="radio" name="decision" id="rechazado-curso" value="Rechazado" @onchange="@((args) => CambiarDecision(args))" />
                                        <label class="form-check-label" for="rechazado-curso">
                                            <i class="fas fa-times-circle"></i>
                                            <span>Rechazar Curso</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="comentarios" class="form-label">Comentarios</label>
                                <InputTextArea @bind-Value="evaluacion.Comentarios"
                                               class="form-control"
                                               id="comentarios"
                                               rows="4"
                                               placeholder="Ingrese sus comentarios sobre el curso..." />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-loading me-2"></span>
                                        <text>Guardando...</text>
                                    }
                                    else
                                    {
                                        <text>Guardar Evaluación</text>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

