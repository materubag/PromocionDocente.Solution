@code {
    private EvaluacionModel evaluacion = new();
    private bool isLoading = false;
    private bool mostrarModal = false;
    private ProyectoModel? proyectoSeleccionado = null;

    private string filtroTexto = "";
    private List<ProyectoModel> proyectosFiltrados = new();

    private List<ProyectoModel> Proyectos = new()
    {
        new ProyectoModel { Id = 1, Nombre = "Análisis de Datos Educativos", Estado = "Pendiente", Descripcion = "Investigación sobre patrones de aprendizaje", FechaInicio = new DateTime(2023, 3, 15), Duracion = 18 },
        new ProyectoModel { Id = 2, Nombre = "Metodologías Innovadoras", Estado = "Pendiente", Descripcion = "Desarrollo de nuevas técnicas de enseñanza", FechaInicio = new DateTime(2023, 8, 1), Duracion = 24 },
        new ProyectoModel { Id = 3, Nombre = "Tecnología en el Aula", Estado = "Pendiente", Descripcion = "Integración de herramientas digitales", FechaInicio = new DateTime(2024, 1, 10), Duracion = 12 }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoProyectos();
        FiltrarProyectos();
    }

    private async Task CargarEstadoProyectos()
    {
        try
        {
            var estado = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "documento_1_estado");
            if (!string.IsNullOrEmpty(estado) && estado == "Completo")
            {
                foreach (var proyecto in Proyectos)
                {
                    proyecto.Estado = "Completo";
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estado: {ex.Message}");
        }
    }

    private void FiltrarProyectos()
    {
        proyectosFiltrados = Proyectos.Where(p =>
            string.IsNullOrEmpty(filtroTexto) ||
            p.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            p.Descripcion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
        ).ToList();

        StateHasChanged();
    }

    private void SeleccionarTodos(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var proyecto in proyectosFiltrados)
        {
            proyecto.Seleccionado = seleccionar;
        }
    }

    private void VerDocumento(ProyectoModel proyecto)
    {
        proyectoSeleccionado = proyecto;
        evaluacion = new EvaluacionModel();
        mostrarModal = true;
        StateHasChanged();
    }

    private void EvaluarProyecto(ProyectoModel proyecto)
    {
        VerDocumento(proyecto);
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        proyectoSeleccionado = null;
        evaluacion = new EvaluacionModel();
        StateHasChanged();
    }

    private async Task GuardarEvaluacion()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (evaluacion.Estado == default(EstadoEvaluacion))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Por favor seleccione el estado de la evaluación");
                return;
            }

            await Task.Delay(1500);

            // Marcar todos los proyectos como completados
            foreach (var proyecto in Proyectos)
            {
                proyecto.Estado = "Completo";
            }

            // Guardar estado en localStorage
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "documento_1_estado", "Completo");

            var evaluacionData = new
            {
                DocumentoId = 1,
                DocumentoNombre = "Investigacion",
                Estado = evaluacion.Estado.ToString(),
                Comentarios = evaluacion.Comentarios ?? "",
                Fecha = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss"),
                Evaluador = "Cuadrado1224"
            };

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "evaluacion_1",
                System.Text.Json.JsonSerializer.Serialize(evaluacionData));

            await JSRuntime.InvokeVoidAsync("alert", "✅ Evaluación de Investigación guardada exitosamente");
            CerrarModal();
            FiltrarProyectos();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Error al guardar la evaluación: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ActualizarEstados()
    {
        await CargarEstadoProyectos();
        FiltrarProyectos();
        await JSRuntime.InvokeVoidAsync("alert", "Estados actualizados");
    }

    private async Task VerResumen()
    {
        var completados = Proyectos.Count(p => p.Estado == "Completo");
        var pendientes = Proyectos.Count(p => p.Estado == "Pendiente");

        await JSRuntime.InvokeVoidAsync("alert",
            $"📊 Resumen de Investigación\n\n" +
            $"✅ Proyectos Evaluados: {completados}\n" +
            $"⏳ Proyectos Pendientes: {pendientes}\n" +
            $"🔬 Total de Proyectos: {Proyectos.Count}");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/administrador");
    }

    public class ProyectoModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Estado { get; set; } = "Pendiente";
        public string Descripcion { get; set; } = "";
        public bool Seleccionado { get; set; } = false;
        public DateTime FechaInicio { get; set; }
        public int Duracion { get; set; }
    }

    public class EvaluacionModel
    {
        public EstadoEvaluacion Estado { get; set; }
        public string Comentarios { get; set; } = "";
    }

    public enum EstadoEvaluacion
    {
        Aprobado,
        Rechazado
    }
}