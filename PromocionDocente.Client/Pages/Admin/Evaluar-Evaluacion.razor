@page "/evaluar-evaluacion"

@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="evaluaciones-container">
    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
        </div>
    </div>

    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar..." @bind="filtroTexto" @oninput="FiltrarEvaluaciones" />
                    <span class="search-icon">🔍</span>
                </div>
            </div>
            <div class="tabla-evaluaciones">
                <table class="evaluaciones-table">
                    <thead>
                        <tr>
                            <th>Periodo</th>
                            <th>Tipo Evaluación</th>
                            <th>Fecha</th>
                            <th>Resultado</th>
                            <th>Documento</th>
                            <th>Estado</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (evaluacionesFiltradas != null && evaluacionesFiltradas.Any())
                        {
                            @foreach (var evaluacion in evaluacionesFiltradas)
                            {
                                <tr>
                                    <td>@evaluacion.PeriodoEvaluado</td>
                                    <td>@evaluacion.TipoEvaluacion</td>
                                    <td>@evaluacion.FechaEvaluacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge-resultado @GetClaseResultado(evaluacion.Resultado)">
                                            @evaluacion.Resultado.ToString("0.00")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(evaluacion.PdfEvaluacion))
                                        {
                                            <button class="btn-documento" @onclick="() => VerPDF(evaluacion)">Ver PDF</button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(evaluacion.Estado)">
                                            @evaluacion.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-revisar" @onclick="() => RevisarEvaluacion(evaluacion)">Revisar</button>
                                        @if (evaluacion.Estado?.ToLower() == "rechazado" && !string.IsNullOrEmpty(evaluacion.Observacion))
                                        {
                                            <span title="@evaluacion.Observacion" class="obs-icon">🛈 Obs.</span>
                                        }
                                    </td>
                                </tr>
                                @if (evaluacion.MostrandoRevision)
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="revisar-panel">
                                                <textarea @bind="evaluacion.Observacion" placeholder="Ingrese observación (opcional para aprobar, obligatoria para rechazar)" class="obs-textarea"></textarea>
                                                <button class="btn-aprobar" @onclick="() => AprobarEvaluacion(evaluacion)">Aprobar</button>
                                                <button class="btn-rechazar" @onclick="() => RechazarEvaluacion(evaluacion)">Rechazar</button>
                                                <button class="btn-cancelar-revision" @onclick="() => OcultarRevision(evaluacion)">Cancelar</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-data">No se encontraron evaluaciones</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

