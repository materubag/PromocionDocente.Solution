</style>

@code {
    private List<EvaluacionInfo> evaluaciones = new();
    private List<EvaluacionInfo> evaluacionesFiltradas = new();
    private string filtroTexto = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarEvaluaciones();
        FiltrarEvaluaciones();
    }

    private async Task CargarEvaluaciones()
    {
        try
        {
            evaluaciones = await Http.GetFromJsonAsync<List<EvaluacionInfo>>($"/api/Evaluaciones");
            evaluacionesFiltradas = evaluaciones;
        }
        catch
        {
            evaluacionesFiltradas = new();
        }
    }

    private void FiltrarEvaluaciones()
    {
        evaluacionesFiltradas = evaluaciones
            .Where(e =>
                string.IsNullOrEmpty(filtroTexto) ||
                (e.PeriodoEvaluado?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (e.TipoEvaluacion?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

        StateHasChanged();
    }

    private string GetClaseResultado(decimal resultado)
    {
        if (resultado >= 4.5m) return "resultado-excelente";
        if (resultado >= 4.0m) return "resultado-bueno";
        if (resultado >= 3.0m) return "resultado-regular";
        return "resultado-malo";
    }

    private string GetClaseEstado(string estado)
    {
        return estado?.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "borrador" => "estado-borrador",
            "aprobado" => "estado-aprobado",
            "rechazado" => "estado-rechazado",
            _ => "estado-borrador"
        };
    }

    private async Task VerPDF(EvaluacionInfo evaluacion)
    {
        if (!string.IsNullOrEmpty(evaluacion.PdfEvaluacion))
            await JSRuntime.InvokeVoidAsync("window.open", evaluacion.PdfEvaluacion, "_blank");
    }

    private void RevisarEvaluacion(EvaluacionInfo evaluacion)
    {
        foreach (var e in evaluacionesFiltradas)
            e.MostrandoRevision = false;
        evaluacion.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(EvaluacionInfo evaluacion)
    {
        evaluacion.MostrandoRevision = false;
        evaluacion.Observacion = "";
        StateHasChanged();
    }

    private async Task AprobarEvaluacion(EvaluacionInfo evaluacion)
    {
        evaluacion.Estado = "Aprobado";
        evaluacion.Observacion = "";
        evaluacion.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = evaluacion.Estado,
            Observacion = ""
        };
        await Http.PutAsJsonAsync($"/api/Evaluaciones/estado/{evaluacion.IdEvaluacion}", dto);
        StateHasChanged();
    }

    private async Task RechazarEvaluacion(EvaluacionInfo evaluacion)
    {
        if (string.IsNullOrWhiteSpace(evaluacion.Observacion))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe ingresar una observación para rechazar.");
            return;
        }
        evaluacion.Estado = "Rechazado";
        evaluacion.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = evaluacion.Estado,
            Observacion = evaluacion.Observacion
        };
        await Http.PutAsJsonAsync($"/api/Evaluaciones/estado/{evaluacion.IdEvaluacion}", dto);
        StateHasChanged();
    }

    public class EvaluacionInfo
    {
        public int IdEvaluacion { get; set; }
        public string PeriodoEvaluado { get; set; }
        public string TipoEvaluacion { get; set; }
        public DateTime FechaEvaluacion { get; set; }
        public decimal Resultado { get; set; }
        public string PdfEvaluacion { get; set; }
        public string Estado { get; set; }
        public string Observacion { get; set; }
        public bool MostrandoRevision { get; set; }
    }

    // DTO para actualizar estado y observacion
    public class EstadoUpdateDto
    {
        public string Estado { get; set; }
        public string Observacion { get; set; }
    }
}