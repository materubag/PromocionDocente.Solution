@page "/evaluar-obras"
@using Microsoft.EntityFrameworkCore.Metadata.Internal

@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="obras-container">
    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">← Volver</button>
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="spacer"></div>
        </div>
    </div>
    <div class="contenido-principal">
        <div class="tabla-container">
            <div class="tabla-obras">
                <table class="obras-table">
                    <thead>
                        <tr>
                            <th>
                                <input type="checkbox" @onchange="SeleccionarTodas" />
                            </th>
                            <th class="col-tipo">Tipo Obra</th>
                            <th class="col-titulo">Título</th>
                            <th class="col-fecha">Fecha Publicación</th>
                            <th class="col-area">Área Conocimiento</th>
                            <th class="col-documento">Documento</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-acciones">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (obrasFiltradas != null && obrasFiltradas.Any())
                        {
                            @foreach (var obra in obrasFiltradas)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" @bind="obra.Seleccionada" />
                                    </td>
                                    <td>
                                        <span class="badge-tipo @GetClaseTipo(obra.TipoObra)">
                                            @obra.TipoObra
                                        </span>
                                    </td>
                                    <td class="titulo-cell">
                                        <div class="titulo-info">
                                            <span class="titulo-texto">@obra.Titulo</span>
                                            @if (!string.IsNullOrEmpty(obra.Observaciones))
                                            {
                                                <small class="observaciones">@obra.Observaciones</small>
                                            }
                                        </div>
                                    </td>
                                    <td>@obra.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="area-badge">@(obra.AreaConocimiento ?? "Sin especificar")</span>
                                    </td>
                                    <td class="documento">
                                        @if (obra.TienePDF())
                                        {
                                            <button class="btn-documento" @onclick="() => VerPDF(obra)" title="Ver PDF">
                                                <span class="documento-icon">📄</span>
                                                <span class="documento-text">PDF</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(obra.Estado)">
                                            @obra.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn-revisar" @onclick="() => RevisarObra(obra)">Revisar</button>
                                        @if ((obra.Estado ?? "").ToLower() == "rechazado" && !string.IsNullOrEmpty(obra.Observaciones))
                                        {
                                            <span title="@obra.Observaciones" class="obs-icon">🛈 Obs.</span>
                                        }
                                    </td>
                                </tr>
                                @if (obra.MostrandoRevision)
                                {
                                    <tr>
                                        <td colspan="8">
                                            <div class="revisar-panel">
                                                <textarea @bind="obra.Observaciones"
                                                          placeholder="Ingrese observación (opcional para aprobar, obligatoria para rechazar)"
                                                          class="obs-textarea"></textarea>
                                                <div class="revisar-buttons">
                                                    <button class="btn-aprobar" @onclick="() => AprobarObra(obra)">Aprobar</button>
                                                    <button class="btn-rechazar" @onclick="() => RechazarObra(obra)">Rechazar</button>
                                                    <button class="btn-cancelar-revision" @onclick="() => OcultarRevision(obra)">Cancelar</button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="no-data">No se encontraron obras</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

