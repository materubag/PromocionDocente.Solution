@code {
    private List<ObraInfo> obras = new();
    private List<ObraInfo> obrasFiltradas = new();
    private string cedulaDocente = "";

    protected override async Task OnInitializedAsync()
    {
      
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        cedulaDocente = query["cedula"] ?? "";

        await CargarObras();
    }

    

    private async Task CargarObras()
    {
        try
        {
            obras = await Http.GetFromJsonAsync<List<ObraInfo>>($"/api/Obras");
            obrasFiltradas = obras;
        }
        catch
        {
            obrasFiltradas = new();
        }
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var obra in obrasFiltradas)
        {
            obra.Seleccionada = seleccionar;
        }
    }

    private string GetClaseTipo(string? tipo)
    {
        return tipo?.ToLower() switch
        {
            "artículo" => "tipo-articulo",
            "libro" => "tipo-libro",
            "capítulo" => "tipo-capitulo",
            "tesis" => "tipo-tesis",
            "ponencia" => "tipo-ponencia",
            _ => "tipo-articulo"
        };
    }

    private void Volver()
    {
        Navigation.NavigateTo($"/administrador?codigo={cedulaDocente}");
    }

    private string GetClaseEstado(string? estado)
    {
        return (estado ?? "").ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "en progreso" => "estado-en-progreso",
            "en validación" => "estado-en-validacion",
            "validado" => "estado-validado",
            "aprobado" => "estado-aprobado",
            "rechazado" => "estado-rechazado",
            _ => "estado-pendiente"
        };
    }

    private async Task VerPDF(ObraInfo obra)
    {
        if (!string.IsNullOrEmpty(obra.PdfUrl))
            await JSRuntime.InvokeVoidAsync("window.open", obra.PdfUrl, "_blank");
    }

    private void RevisarObra(ObraInfo obra)
    {
        foreach (var o in obrasFiltradas)
            o.MostrandoRevision = false;
        obra.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(ObraInfo obra)
    {
        obra.MostrandoRevision = false;
        obra.Observaciones = "";
        StateHasChanged();
    }

    private async Task AprobarObra(ObraInfo obra)
    {
        obra.Estado = "APROBADO";
        obra.Observaciones = "";
        obra.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = obra.Estado,
            Observacion = ""
        };
        await Http.PutAsJsonAsync($"/api/Obras/estado/{obra.IdObra}", dto);
        StateHasChanged();
    }

    private async Task RechazarObra(ObraInfo obra)
    {
        if (string.IsNullOrWhiteSpace(obra.Observaciones))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Debe ingresar una observación para rechazar.");
            return;
        }
        obra.Estado = "RECHAZADO";
        obra.MostrandoRevision = false;
        var dto = new EstadoUpdateDto
        {
            Estado = obra.Estado,
            Observacion = obra.Observaciones
        };
        await Http.PutAsJsonAsync($"/api/Obras/estado/{obra.IdObra}", dto);
        StateHasChanged();
    }

    public class ObraInfo
    {
        public int IdObra { get; set; }
        public string TipoObra { get; set; } = "";
        public string Titulo { get; set; } = "";
        public DateTime FechaPublicacion { get; set; }
        public string? DoiUrl { get; set; }
        public string? AreaConocimiento { get; set; }
        public string? Observaciones { get; set; }
        public string? PdfUrl { get; set; }
        public string? CedDoc { get; set; }
        public string? Estado { get; set; }
        public bool Seleccionada { get; set; }
        public bool MostrandoRevision { get; set; } = false;

        public bool TienePDF()
        {
            return PdfUrl != null && PdfUrl.Length > 0;
        }
    }

    public class EstadoUpdateDto
    {
        public string Estado { get; set; }
        public string Observacion { get; set; }
    }
}