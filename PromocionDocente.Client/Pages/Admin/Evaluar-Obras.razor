</style>

@code {
    private List<ObraInfo> obras = new();
    private List<ObraInfo> obrasFiltradas = new();
    private string cedulaDocente = "";
    
    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        cedulaDocente = query["cedula"] ?? "";

        await CargarObras();
    }

    private async Task CargarObras()
    {
        try
        {
            // Usar el endpoint correcto para obtener obras por cédula
            var obrasResponse = await Http.GetFromJsonAsync<List<ObraInfo>>($"/api/Obras/cedula/{cedulaDocente}");
            obras = obrasResponse ?? new();
            obrasFiltradas = obras;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando obras: {ex.Message}");
            obras = new();
            obrasFiltradas = new();
            MostrarAlerta("error", "Error al cargar obras", 
                "No se pudieron cargar las obras. Inténtalo de nuevo.");
        }
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        var seleccionar = (bool)(e.Value ?? false);
        foreach (var obra in obrasFiltradas)
        {
            obra.Seleccionada = seleccionar;
        }
        StateHasChanged();
    }

    private string GetClaseTipo(string? tipo)
    {
        return tipo?.ToLower() switch
        {
            "artículo" => "tipo-articulo",
            "libro" => "tipo-libro",
            "capítulo" => "tipo-capitulo",
            "tesis" => "tipo-tesis",
            "ponencia" => "tipo-ponencia",
            _ => "tipo-articulo"
        };
    }

    private string GetClaseEstado(string? estado)
    {
        return estado?.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "en progreso" => "estado-en-progreso",
            "en validación" => "estado-en-validacion",
            "validado" => "estado-validado",
            "aprobado" or "APROBADO" => "estado-aprobado",
            "rechazado" or "RECHAZADO" => "estado-rechazado",
            _ => "estado-pendiente"
        };
    }

    private async Task VerPDF(ObraInfo obra)
    {
        if (string.IsNullOrEmpty(obra.PdfUrl))
        {
            MostrarAlerta("info", "PDF no disponible", 
                "No hay documento PDF asociado a esta obra.");
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("window.open", obra.PdfUrl, "_blank");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al abrir PDF: {ex.Message}");
            MostrarAlerta("error", "Error al abrir PDF", 
                "No se pudo abrir el documento PDF. Verifique que la URL sea válida.");
        }
    }

    private void RevisarObra(ObraInfo obra)
    {
        foreach (var o in obrasFiltradas)
            o.MostrandoRevision = false;
        obra.MostrandoRevision = true;
        StateHasChanged();
    }

    private void OcultarRevision(ObraInfo obra)
    {
        obra.MostrandoRevision = false;
        obra.Observaciones = "";
        StateHasChanged();
    }

    private async Task AprobarObra(ObraInfo obra)
    {
        try
        {
            obra.Estado = "APROBADO";
            obra.MostrandoRevision = false;
            var dto = new EstadoUpdateDto
            {
                Estado = "APROBADO",
                Observacion = string.IsNullOrEmpty(obra.Observaciones) ? "Cumple con todos los requisitos" : obra.Observaciones
            };
            await Http.PutAsJsonAsync($"/api/Obras/estado/{obra.IdObra}", dto);
            
            // Mostrar alerta de éxito
            MostrarAlerta("success", "¡Obra aprobada!", 
                $"'{obra.Titulo}' ha sido aprobada exitosamente.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al aprobar obra: {ex.Message}");
            // Mostrar alerta de error
            MostrarAlerta("error", "Error al aprobar", 
                "No se pudo aprobar la obra. Inténtalo de nuevo.");
        }
        StateHasChanged();
    }

    private async Task RechazarObra(ObraInfo obra)
    {
        if (string.IsNullOrWhiteSpace(obra.Observaciones))
        {
            MostrarAlerta("error", "Observación requerida", 
                "Debe ingresar una observación para rechazar.");
            return;
        }
        
        try
        {
            obra.Estado = "RECHAZADO";
            obra.MostrandoRevision = false;
            var dto = new EstadoUpdateDto
            {
                Estado = "RECHAZADO",
                Observacion = obra.Observaciones
            };
            await Http.PutAsJsonAsync($"/api/Obras/estado/{obra.IdObra}", dto);
            
            // Mostrar alerta de éxito
            MostrarAlerta("success", "Obra rechazada", 
                $"'{obra.Titulo}' ha sido rechazada.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al rechazar obra: {ex.Message}");
            // Mostrar alerta de error
            MostrarAlerta("error", "Error al rechazar", 
                "No se pudo rechazar la obra. Inténtalo de nuevo.");
        }
        StateHasChanged();
    }
    
    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();
        
        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ => 
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }
    
    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }

    private void Volver()
    {
        // Navega de vuelta incluyendo la cédula
        Navigation.NavigateTo($"/administrador?codigo={cedulaDocente}");
    }

    public class ObraInfo
    {
        public int IdObra { get; set; }
        public string TipoObra { get; set; } = "";
        public string Titulo { get; set; } = "";
        public DateTime FechaPublicacion { get; set; }
        public string? DoiUrl { get; set; }
        public string? AreaConocimiento { get; set; }
        public string? Observaciones { get; set; }
        public string? PdfUrl { get; set; }
        public string? CedDoc { get; set; }
        public string? Estado { get; set; }
        public bool Seleccionada { get; set; }
        public bool MostrandoRevision { get; set; } = false;

        public bool TienePDF()
        {
            return !string.IsNullOrEmpty(PdfUrl);
        }
    }

    public class EstadoUpdateDto
    {
        public string Estado { get; set; } = "";
        public string Observacion { get; set; } = "";
    }
}