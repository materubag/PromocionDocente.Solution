<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

@code {
    [Parameter] public int DocumentoId { get; set; }

    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";

    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;

        // Auto-close después de 4s
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }

    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }

    private EvaluacionModel evaluacion = new();
    private bool isLoading = false;
    private bool mostrarModal = false;
    private DocumentoModel? documentoSeleccionado = null;

    // Filtros y paginación
    private string filtroTexto = "";
    private List<DocumentoModel> documentosFiltrados = new();
    private int paginaActual = 1;
    private int elementosPorPagina = 10;
    private int totalElementos = 0;
    private int totalPaginas = 0;

    // Lista de documentos
    private List<DocumentoModel> Documentos = new()
    {
        new DocumentoModel { Id = 1, Nombre = "Hoja de Vida", Estado = "Pendiente", Descripcion = "Información personal y profesional completa" },
        new DocumentoModel { Id = 2, Nombre = "Títulos Académicos", Estado = "Pendiente", Descripcion = "Certificados de títulos universitarios" },
        new DocumentoModel { Id = 3, Nombre = "Certificados de Capacitación", Estado = "Pendiente", Descripcion = "Cursos y capacitaciones realizadas" },
        new DocumentoModel { Id = 4, Nombre = "Evaluaciones Estudiantiles", Estado = "Pendiente", Descripcion = "Evaluaciones de desempeño docente" },
        new DocumentoModel { Id = 5, Nombre = "Publicaciones", Estado = "Pendiente", Descripcion = "Artículos y trabajos de investigación" }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoDocumentos();
        FiltrarDocumentos();
    }

    private async Task CargarEstadoDocumentos()
    {
        try
        {
            foreach (var documento in Documentos)
            {
                var estado = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"documento_{documento.Id}_estado");
                if (!string.IsNullOrEmpty(estado))
                {
                    documento.Estado = estado;
                    documento.Evaluado = estado == "Completo";

                    var evaluacionJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"evaluacion_{documento.Id}");
                    if (!string.IsNullOrEmpty(evaluacionJson))
                    {
                        try
                        {
                            var evaluacionData = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object>>(evaluacionJson);
                            if (evaluacionData != null)
                            {
                                if (evaluacionData.ContainsKey("Fecha"))
                                {
                                    if (DateTime.TryParse(evaluacionData["Fecha"].ToString(), out DateTime fecha))
                                    {
                                        documento.FechaEvaluacion = fecha;
                                    }
                                }
                                if (evaluacionData.ContainsKey("Evaluador"))
                                {
                                    documento.Evaluador = evaluacionData["Evaluador"].ToString();
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            
                            Console.WriteLine($"Error deserializando evaluación: {ex.Message}");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estado de documentos: {ex.Message}");
        }
    }

    private void FiltrarDocumentos()
    {
        var documentosFiltro = Documentos.Where(d =>
            string.IsNullOrEmpty(filtroTexto) ||
            d.Nombre.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            d.Estado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            (d.Descripcion?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();

        totalElementos = documentosFiltro.Count;
        totalPaginas = (int)Math.Ceiling((double)totalElementos / elementosPorPagina);

        documentosFiltrados = documentosFiltro
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina)
            .ToList();

        StateHasChanged();
    }

    private string GetClaseEstado(string estado)
    {
        return estado.ToLower() switch
        {
            "completo" => "estado-completo",
            "pendiente" => "estado-pendiente",
            _ => "estado-pendiente"
        };
    }

    private void SeleccionarTodos(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var documento in documentosFiltrados)
        {
            documento.Seleccionado = seleccionar;
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            FiltrarDocumentos();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            FiltrarDocumentos();
        }
    }

    private void VerDocumento(DocumentoModel documento)
    {
        documentoSeleccionado = documento;
        evaluacion = new EvaluacionModel();
        mostrarModal = true;
        StateHasChanged();
    }

    private void EvaluarDocumento(DocumentoModel documento)
    {
        VerDocumento(documento);
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        documentoSeleccionado = null;
        evaluacion = new EvaluacionModel();
        StateHasChanged();
    }

    private async Task GuardarEvaluacion()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (documentoSeleccionado == null)
            {
                MostrarAlerta("error", "Error", "No hay documento seleccionado.");
                return;
            }

            if (evaluacion.Estado == default(EstadoDocumento))
            {
                MostrarAlerta("error", "Error", "Selecciona el estado del documento.");
                return;
            }

            await Task.Delay(1500);

            documentoSeleccionado.Estado = "Completo";
            documentoSeleccionado.Evaluado = true;
            documentoSeleccionado.FechaEvaluacion = DateTime.UtcNow;
            documentoSeleccionado.Evaluador = "Cuadrado1224";

            await JSRuntime.InvokeVoidAsync("localStorage.setItem",
                $"documento_{documentoSeleccionado.Id}_estado", "Completo");

            var evaluacionData = new
            {
                DocumentoId = documentoSeleccionado.Id,
                DocumentoNombre = documentoSeleccionado.Nombre,
                Estado = evaluacion.Estado.ToString(),
                Comentarios = evaluacion.Comentarios ?? "",
                Fecha = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss"),
                Evaluador = "Cuadrado1224"
            };

            await JSRuntime.InvokeVoidAsync("localStorage.setItem",
                $"evaluacion_{documentoSeleccionado.Id}", System.Text.Json.JsonSerializer.Serialize(evaluacionData));

            MostrarAlerta("success", "Éxito", "Evaluacion guardada");
            CerrarModal();
            FiltrarDocumentos();
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "No se pudo guardar la evaluacion.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ActualizarEstados()
    {
        await CargarEstadoDocumentos();
        FiltrarDocumentos();
        MostrarAlerta("success", "Éxito", "Estados actualizados");
    }

    private async Task VerResumen()
    {
        var completados = Documentos.Count(d => d.Estado == "Completo");
        var pendientes = Documentos.Count(d => d.Estado == "Pendiente");

        await JSRuntime.InvokeVoidAsync("alert",
            $"📊 Resumen de Evaluación\n\n" +
            $"✅ Documentos Evaluados: {completados}\n" +
            $"⏳ Documentos Pendientes: {pendientes}\n" +
            $"📄 Total de Documentos: {Documentos.Count}\n\n" +
            $"Progreso: {(completados * 100 / Documentos.Count)}%");
    }

    private void Volver()
    {
        Navigation.NavigateTo("/administrador");
    }

    public class DocumentoModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Estado { get; set; } = "Pendiente";
        public string? Descripcion { get; set; }
        public bool Evaluado { get; set; } = false;
        public bool Seleccionado { get; set; } = false;
        public DateTime? FechaEvaluacion { get; set; }
        public string? Evaluador { get; set; }
    }

    public class EvaluacionModel
    {
        public EstadoDocumento Estado { get; set; }
        public string Comentarios { get; set; } = "";
    }

    public enum EstadoDocumento
    {
        Aprobado,
        Rechazado
    }
}