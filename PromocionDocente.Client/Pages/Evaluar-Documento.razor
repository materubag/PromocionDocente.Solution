@page "/evaluar-documento/{DocumentoId:int}"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="obras-container">
    <div class="header-container">
        <div class="header-content">
            <button class="btn-volver" @onclick="Volver">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>
            <h1 class="titulo-principal">Evaluación de Documentos</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">Dr. María González</div>
                    <div class="cargo">099234678 - Evaluación en Proceso</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="contenido-principal">
        <div class="tabla-container">
            <!-- Barra de herramientas -->
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar documentos..." @bind="filtroTexto" @oninput="FiltrarDocumentos" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-secondary" @onclick="ActualizarEstados">
                        <span class="btn-icon">🔄</span>
                        Actualizar
                    </button>
                    <button class="btn btn-primary" @onclick="VerResumen">
                        <span class="btn-icon">📊</span>
                        Resumen
                    </button>
                </div>
            </div>

            <!-- Tabla de documentos -->
            <div class="tabla-obras">
                <table class="obras-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodos" />
                            </th>
                            <th class="col-tipo">Documento</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-fecha">Fecha Evaluación</th>
                            <th class="col-evaluador">Evaluador</th>
                            <th class="col-documento">Ver PDF</th>
                            <th class="col-accion">Evaluar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (documentosFiltrados != null && documentosFiltrados.Any())
                        {
                            @foreach (var documento in documentosFiltrados)
                            {
                                <tr class="@(documento.Seleccionado ? "selected" : "") @(documento.Estado == "Completo" ? "completed" : "pending")">
                                    <td>
                                        <input type="checkbox" @bind="documento.Seleccionado" />
                                    </td>
                                    <td>
                                        <div class="documento-info">
                                            <i class="fas fa-file-alt @(documento.Estado == "Completo" ? "text-success" : "text-warning") me-2"></i>
                                            <div class="titulo-info">
                                                <span class="titulo-texto">@documento.Nombre</span>
                                                @if (!string.IsNullOrEmpty(documento.Descripcion))
                                                {
                                                    <small class="observaciones">@documento.Descripcion</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(documento.Estado)">
                                            @documento.Estado
                                        </span>
                                    </td>
                                    <td>
                                        @if (documento.FechaEvaluacion.HasValue)
                                        {
                                            <span>@documento.FechaEvaluacion.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="no-fecha">Sin evaluar</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(documento.Evaluador))
                                        {
                                            <span class="area-badge">@documento.Evaluador</span>
                                        }
                                        else
                                        {
                                            <span class="no-evaluador">Sin asignar</span>
                                        }
                                    </td>
                                    <td class="documento">
                                        <button class="btn-documento" @onclick="() => VerDocumento(documento)" title="Ver PDF">
                                            <span class="documento-icon">📄</span>
                                            <span class="documento-text">PDF</span>
                                        </button>
                                    </td>
                                    <td class="doi-cell">
                                        <button class="btn-evaluar @(documento.Estado == "Completo" ? "btn-reevaluar" : "btn-pendiente")"
                                                @onclick="() => EvaluarDocumento(documento)" title="Evaluar documento">
                                            <span class="evaluar-icon">@(documento.Estado == "Completo" ? "✓" : "⏳")</span>
                                            <span class="evaluar-text">@(documento.Estado == "Completo" ? "Re-evaluar" : "Evaluar")</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                                <tr>
                                    <td colspan="7" class="no-data">No se encontraron documentos</td>
                                </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @((paginaActual - 1) * elementosPorPagina + 1) - @(Math.Min(paginaActual * elementosPorPagina, totalElementos)) de @totalElementos documentos
                </div>
                <div class="pagination-controls">
                    <button class="btn-page" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">◀</button>
                    <span class="page-info">Página @paginaActual de @totalPaginas</span>
                    <button class="btn-page" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">▶</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para visualizar documento y evaluar -->
@if (mostrarModal && documentoSeleccionado != null)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@documentoSeleccionado.Nombre</h5>
                <button class="btn-close" @onclick="CerrarModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="documento-viewer">
                    <div class="pdf-container">
                        <div class="pdf-placeholder">
                            <i class="fas fa-file-pdf fa-3x text-danger mb-3"></i>
                            <h4>@documentoSeleccionado.Nombre</h4>
                            <p class="text-muted">Vista previa del documento</p>

                            @if (documentoSeleccionado.Id == 1)
                            {
                                <div class="documento-content">
                                    <h5>Dr. María González</h5>
                                    <p><strong>Cédula:</strong> 099234678</p>
                                    <p><strong>Cargo Actual:</strong> Profesor Auxiliar</p>
                                    <p><strong>Facultad:</strong> Ciencias de la Educación</p>
                                    <p><strong>Experiencia:</strong> 8 años en docencia universitaria</p>
                                    <p><strong>Formación:</strong> Doctorado en Educación, Maestría en Pedagogía</p>
                                </div>
                            }
                            else if (documentoSeleccionado.Id == 2)
                            {
                                <div class="documento-content">
                                    <h6>Títulos Obtenidos:</h6>
                                    <ul class="text-start">
                                        <li>Doctorado en Educación - Universidad Nacional (2018)</li>
                                        <li>Maestría en Pedagogía - Universidad Central (2015)</li>
                                        <li>Licenciatura en Educación - Universidad Pedagógica (2012)</li>
                                    </ul>
                                </div>
                            }
                            else if (documentoSeleccionado.Id == 3)
                            {
                                <div class="documento-content">
                                    <h6>Capacitaciones Recientes:</h6>
                                    <ul class="text-start">
                                        <li>Metodologías Activas de Aprendizaje (2024)</li>
                                        <li>Tecnologías Educativas (2023)</li>
                                        <li>Evaluación por Competencias (2023)</li>
                                        <li>Investigación Pedagógica (2022)</li>
                                    </ul>
                                </div>
                            }
                            else if (documentoSeleccionado.Id == 4)
                            {
                                <div class="documento-content">
                                    <h6>Evaluaciones Estudiantiles:</h6>
                                    <p><strong>Promedio General:</strong> 4.7/5.0</p>
                                    <p><strong>Comentarios Destacados:</strong></p>
                                    <ul class="text-start">
                                        <li>"Excelente profesora, muy clara en sus explicaciones"</li>
                                        <li>"Metodología innovadora y participativa"</li>
                                        <li>"Siempre disponible para consultas"</li>
                                    </ul>
                                </div>
                            }
                            else if (documentoSeleccionado.Id == 5)
                            {
                                <div class="documento-content">
                                    <h6>Publicaciones Científicas:</h6>
                                    <ul class="text-start">
                                        <li>"Innovación Pedagógica en la Era Digital" - Revista Educación (2024)</li>
                                        <li>"Metodologías Activas en Educación Superior" - Congreso Nacional (2023)</li>
                                        <li>"Evaluación Formativa y Competencias" - Revista Pedagógica (2023)</li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="evaluacion-panel">
                        <h6>Evaluación del Documento</h6>
                        <EditForm Model="@evaluacion" OnValidSubmit="@GuardarEvaluacion">
                            <div class="mb-4">
                                <label class="form-label">Decisión</label>
                                <div class="decision-group">
                                    <InputRadioGroup @bind-Value="evaluacion.Estado" class="form-check-group">
                                        <div class="decision-option aprobar">
                                            <InputRadio Value="EstadoDocumento.Aprobado" class="form-check-input" id="aprobado" />
                                            <label class="form-check-label" for="aprobado">
                                                <i class="fas fa-check-circle"></i>
                                                <span>Aprobar Documento</span>
                                            </label>
                                        </div>
                                        <div class="decision-option rechazar">
                                            <InputRadio Value="EstadoDocumento.Rechazado" class="form-check-input" id="rechazado" />
                                            <label class="form-check-label" for="rechazado">
                                                <i class="fas fa-times-circle"></i>
                                                <span>Rechazar Documento</span>
                                            </label>
                                        </div>
                                    </InputRadioGroup>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="comentarios" class="form-label">Comentarios</label>
                                <InputTextArea @bind-Value="evaluacion.Comentarios"
                                               class="form-control"
                                               id="comentarios"
                                               rows="4"
                                               placeholder="Ingrese sus comentarios sobre el documento..." />
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-loading me-2" role="status" aria-hidden="true"></span>
                                        <text>Guardando...</text>
                                    }
                                    else
                                    {
                                        <text>Guardar Evaluación</text>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CerrarModal">
                                    Cancelar
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
