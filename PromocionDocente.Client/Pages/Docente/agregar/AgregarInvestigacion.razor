@page "/docente/agregar/agregarinvestigacion"
@inject HttpClient Http
@inject NavigationManager NavManager
@using PromocionDocente.Application.DTOs
@inject IJSRuntime JSRuntime
@using System.Text.Json

<h3>Agregar Investigación</h3>

<EditForm Model="@nuevaInvestigacion" OnValidSubmit="GuardarInvestigacion">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Título de la Investigación:</label>
        <InputText @bind-Value="nuevaInvestigacion.TituloInvestigacion" class="form-control" />
    </div>
    <div>
        <label>Tipo de Investigación:</label>
        <InputText @bind-Value="nuevaInvestigacion.TipoInvestigacion" class="form-control" />
    </div>
    <div>
        <label>Campo de Aplicación:</label>
        <InputText @bind-Value="nuevaInvestigacion.CampoAplicacion" class="form-control" />
    </div>
    <div>
        <label>Duración en Meses:</label>
        <InputNumber @bind-Value="nuevaInvestigacion.DuracionMeses" class="form-control" />
    </div>
    <div>
        <label>Fecha de Inicio:</label>
        <InputDate @bind-Value="nuevaInvestigacion.FechaInicio" class="form-control" />
    </div>
    <div>
        <label>Fecha de Fin:</label>
        <InputDate @bind-Value="nuevaInvestigacion.FechaFin" class="form-control" />
    </div>
    <div>
        <label>Archivo PDF:</label>
        <InputFile OnChange="OnInputFileChange" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
    <button type="button" class="btn btn-secondary mt-3" @onclick="Cancelar">Cancelar</button>
</EditForm>

<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

<ConfirmacionToast Mostrar="@mostrarConfirmacion" Titulo="@tituloConfirmar" Mensaje="@mensajeConfirmar" OnConfirmar="@OnConfirmarToast" />

@code {
    private InvestigacionDto nuevaInvestigacion = new()
    {
        Estado = "Pendiente",
        Observacion = ""
    };

    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";
    private bool mostrarConfirmacion = false;
    private string tituloConfirmar = "";
    private string mensajeConfirmar = "";
    private TaskCompletionSource<bool> tcsConfirmar;

    private Task<bool> MostrarConfirmacion(string titulo, string mensaje)
    {
        tituloConfirmar = titulo;
        mensajeConfirmar = mensaje;
        mostrarConfirmacion = true;
        StateHasChanged();
        tcsConfirmar = new TaskCompletionSource<bool>();
        return tcsConfirmar.Task;
    }

    private Task OnConfirmarToast(bool respuesta)
    {
        mostrarConfirmacion = false;
        StateHasChanged();
        tcsConfirmar?.SetResult(respuesta);
        return Task.CompletedTask;
    }


    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }


    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");

        if (!string.IsNullOrEmpty(usuarioJson))
        {
            var usuario = JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
            if (usuario != null)
            {
                nuevaInvestigacion.CedDoc = usuario.Cedula;
            }
        }
    }

    private byte[]? archivoPdf;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var ms = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(ms);
        archivoPdf = ms.ToArray();
    }

    private async Task GuardarInvestigacion()
    {
        nuevaInvestigacion.ArchivoPdf = archivoPdf;
        var response = await Http.PostAsJsonAsync("api/investigaciones", nuevaInvestigacion);

        if (response.IsSuccessStatusCode)
        {
            MostrarAlerta("success", "Investigación guardada", "La investigación se ha guardado correctamente.");
            NavManager.NavigateTo("/docente/investigaciones");
        }
        else
        {
            MostrarAlerta("error", "Error al guardar la investigación", "No se pudo guardar la investigación. Por favor, intente nuevamente.");
        }
    }

    private void Cancelar()
    {
        NavManager.NavigateTo("/docente/investigaciones");
    }

    public class LoginResponse
    {
        public string Cedula { get; set; } = string.Empty;
        public string Nombre1 { get; set; } = string.Empty;
        public string Apellido1 { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
    }
}
