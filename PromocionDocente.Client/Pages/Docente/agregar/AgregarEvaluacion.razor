@page "/docente/agregar/agregarevaluacion"
@inject HttpClient Http
@inject NavigationManager NavManager
@using PromocionDocente.Application.DTOs
@inject IJSRuntime JSRuntime
@using System.Text.Json

<h3>Agregar Evaluación</h3>

<EditForm Model="@nuevaEvaluacion" OnValidSubmit="GuardarEvaluacion">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Periodo Evaluado:</label>
        <InputText @bind-Value="nuevaEvaluacion.PeriodoEvaluado" class="form-control" />
    </div>
    <div>
        <label>Tipo de Evaluación:</label>
        <InputText @bind-Value="nuevaEvaluacion.TipoEvaluacion" class="form-control" />
    </div>
    <div>
        <label>Fecha de Evaluación:</label>
        <InputDate @bind-Value="nuevaEvaluacion.FechaEvaluacion" class="form-control" />
    </div>
    <div>
        <label>Resultado:</label>
        <InputNumber @bind-Value="nuevaEvaluacion.Resultado" class="form-control" />
    </div>
    <div>
        <label>Archivo PDF:</label>
        <InputFile OnChange="OnInputFileChange" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
    <button type="button" class="btn btn-secondary mt-3" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {
    private EvaluacionDto nuevaEvaluacion = new()
    {
        Estado = "Pendiente",
        Observacion = ""
    };

    protected override async Task OnInitializedAsync()
    {
        var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");

        if (!string.IsNullOrEmpty(usuarioJson))
        {
            var usuario = JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
            if (usuario != null)
            {
                nuevaEvaluacion.CedDoc = usuario.Cedula;
            }
        }
    }

    private byte[]? archivoPdf;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var ms = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(ms);
        archivoPdf = ms.ToArray();
    }

    private async Task GuardarEvaluacion()
    {
        nuevaEvaluacion.PdfEvaluacion = archivoPdf;
        var response = await Http.PostAsJsonAsync("api/evaluaciones", nuevaEvaluacion);

        if (response.IsSuccessStatusCode)
        {
            NavManager.NavigateTo("/docente/evaluaciones");
        }
        else
        {
            Console.WriteLine("Error al guardar evaluación");
        }
    }

    private void Cancelar()
    {
        NavManager.NavigateTo("/docente/evaluaciones");
    }

    public class LoginResponse
    {
        public string Cedula { get; set; } = string.Empty;
        public string Nombre1 { get; set; } = string.Empty;
        public string Apellido1 { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
    }
}
