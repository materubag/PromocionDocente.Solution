@page "/docente/editar/obra/{id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update
@inject IJSRuntime JS

<h3>Editar Obra</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="obra" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Título</label>
            <InputText class="form-control" @bind-Value="obra.Titulo" />
        </div>
        <div class="mb-3">
            <label>Tipo de Obra</label>
            <InputText class="form-control" @bind-Value="obra.TipoObra" />
        </div>
        <div class="mb-3">
            <label>Fecha de Publicación</label>
            <InputDate class="form-control" @bind-Value="obra.FechaPublicacion" />
        </div>
        <div class="mb-3">
            <label>DOI / URL</label>
            <InputText class="form-control" @bind-Value="obra.DoiUrl" />
        </div>
        <div class="mb-3">
            <label>Área de Conocimiento</label>
            <InputText class="form-control" @bind-Value="obra.AreaConocimiento" />
        </div>
        <div class="mb-3">
            <label>Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="obra.Observaciones" />
        </div>
        <div class="mb-3">
            <label>Cambiar Archivo PDF (opcional):</label>
            <InputFile OnChange="OnInputFileChange" />
        </div>


        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}
@code {
    [Parameter]
    public int Id { get; set; }

    private ObraUpdateDto obra = new();
    private bool isLoading = true;
    private string? errorMessage;
    private byte[]? archivoPdf;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ObraUpdateDto>($"api/Obras/{Id}");
            if (result == null)
            {
                errorMessage = "No se encontró la obra.";
                return;
            }

            // Mapear ObraDto a ObraUpdateDto
            obra = new ObraUpdateDto
            {
                Titulo = result.Titulo,
                TipoObra = result.TipoObra,
                FechaPublicacion = result.FechaPublicacion,
                DoiUrl = result.DoiUrl,
                AreaConocimiento = result.AreaConocimiento,
                Observaciones = result.Observaciones,
                PdfProduccion = result.PdfProduccion
            };
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar la obra: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Obras/{Id}", obra);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Obra actualizada correctamente.");
                NavManager.NavigateTo("/docente/obras");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar: {response.ReasonPhrase}\n{errorText}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al guardar cambios: " + ex.Message;
        }
    }

    private void Volver()
    {
        NavManager.NavigateTo("/docente/obras");
    }
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var ms = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(ms);
        archivoPdf = ms.ToArray();
    }
}
