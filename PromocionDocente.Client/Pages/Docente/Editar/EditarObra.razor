@page "/docente/editar/obra/{id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update
@inject IJSRuntime JS

<h3>Editar Obra</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="obra" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Título</label>
            <InputText class="form-control" @bind-Value="obra.Titulo" />
        </div>
        <div class="mb-3">
            <label>Tipo de Obra</label>
            <InputText class="form-control" @bind-Value="obra.TipoObra" />
        </div>
        <div class="mb-3">
            <label>Fecha de Publicación</label>
            <InputDate class="form-control" @bind-Value="obra.FechaPublicacion" />
        </div>
        <div class="mb-3">
            <label>DOI / URL</label>
            <InputText class="form-control" @bind-Value="obra.DoiUrl" />
        </div>
        <div class="mb-3">
            <label>Área de Conocimiento</label>
            <InputText class="form-control" @bind-Value="obra.AreaConocimiento" />
        </div>
        <div class="mb-3">
            <label>Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="obra.Observaciones" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}

<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

<ConfirmacionToast Mostrar="@mostrarConfirmacion" Titulo="@tituloConfirmar" Mensaje="@mensajeConfirmar" OnConfirmar="@OnConfirmarToast" />

@code {
    [Parameter]
    public int Id { get; set; }

    private ObraUpdateDto obra = new();
    private bool isLoading = true;
    private string? errorMessage;

     // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";
    private bool mostrarConfirmacion = false;
    private string tituloConfirmar = "";
    private string mensajeConfirmar = "";
    private TaskCompletionSource<bool> tcsConfirmar;

    private Task<bool> MostrarConfirmacion(string titulo, string mensaje)
    {
        tituloConfirmar = titulo;
        mensajeConfirmar = mensaje;
        mostrarConfirmacion = true;
        StateHasChanged();
        tcsConfirmar = new TaskCompletionSource<bool>();
        return tcsConfirmar.Task;
    }

    private Task OnConfirmarToast(bool respuesta)
    {
        mostrarConfirmacion = false;
        StateHasChanged();
        tcsConfirmar?.SetResult(respuesta);
        return Task.CompletedTask;
    }


    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }


    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ObraUpdateDto>($"api/Obras/{Id}");
            if (result == null)
            {
                MostrarAlerta("error", "Error", "No se encontró la obra con el ID especificado.");
                return;
            }

            // Mapear ObraDto a ObraUpdateDto
            obra = new ObraUpdateDto
            {
                Titulo = result.Titulo,
                TipoObra = result.TipoObra,
                FechaPublicacion = result.FechaPublicacion,
                DoiUrl = result.DoiUrl,
                AreaConocimiento = result.AreaConocimiento,
                Observaciones = result.Observaciones,
                PdfProduccion = result.PdfProduccion
            };
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al cargar la obra: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Obras/{Id}", obra);

            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("success", "Éxito", "Obra actualizada correctamente.");
                await Task.Delay(1500);
                NavManager.NavigateTo("/docente/obras");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                MostrarAlerta("error", "Error", $"Error al guardar: {response.ReasonPhrase}\n{errorText}");
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al guardar cambios: " + ex.Message);
        }
    }

    private void Volver()
    {
        NavManager.NavigateTo("/docente/obras");
    }
}
