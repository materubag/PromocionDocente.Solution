@page "/docente/editar/investigacion/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update


<h3>Editar Investigación</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="investigacion" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Título Investigación</label>
            <InputText class="form-control" @bind-Value="investigacion.TituloInvestigacion" />
        </div>
        <div class="mb-3">
            <label>Duración (meses)</label>
            <InputNumber class="form-control" @bind-Value="investigacion.DuracionMeses" />
        </div>
        <div class="mb-3">
            <label>Fecha Inicio</label>
            <InputDate class="form-control" @bind-Value="investigacion.FechaInicio" />
        </div>
        <div class="mb-3">
            <label>Fecha Fin</label>
            <InputDate class="form-control" @bind-Value="investigacion.FechaFin" />
        </div>
        <div class="mb-3">
            <label>Tipo Investigación</label>
            <InputText class="form-control" @bind-Value="investigacion.TipoInvestigacion" />
        </div>
        <div class="mb-3">
            <label>Campo Aplicación</label>
            <InputText class="form-control" @bind-Value="investigacion.CampoAplicacion" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}

<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

<ConfirmacionToast Mostrar="@mostrarConfirmacion" Titulo="@tituloConfirmar" Mensaje="@mensajeConfirmar" OnConfirmar="@OnConfirmarToast" />

@code {
    [Parameter]
    public int Id { get; set; }

    private InvestigacionUpdateDto investigacion = new();
    private bool isLoading = true;
    private string? errorMessage;

    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";
    private bool mostrarConfirmacion = false;
    private string tituloConfirmar = "";
    private string mensajeConfirmar = "";
    private TaskCompletionSource<bool> tcsConfirmar;

    private Task<bool> MostrarConfirmacion(string titulo, string mensaje)
    {
        tituloConfirmar = titulo;
        mensajeConfirmar = mensaje;
        mostrarConfirmacion = true;
        StateHasChanged();
        tcsConfirmar = new TaskCompletionSource<bool>();
        return tcsConfirmar.Task;
    }

    private Task OnConfirmarToast(bool respuesta)
    {
        mostrarConfirmacion = false;
        StateHasChanged();
        tcsConfirmar?.SetResult(respuesta);
        return Task.CompletedTask;
    }


    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }


    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }



    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<InvestigacionDto>($"api/Investigaciones/{Id}");
            if (result == null)
            {
                MostrarAlerta("danger", "Error", "Investigación no encontrada.");
                return;
            }

            investigacion = new InvestigacionUpdateDto
            {
                TituloInvestigacion = result.TituloInvestigacion,
                DuracionMeses = result.DuracionMeses,
                FechaInicio = result.FechaInicio,
                FechaFin = result.FechaFin,
                TipoInvestigacion = result.TipoInvestigacion,
                CampoAplicacion = result.CampoAplicacion,
                ArchivoPdf = result.ArchivoPdf
            };
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "No se pudo cargar la investigación. " + ex.Message);
            
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Investigaciones/{Id}", investigacion);

            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("success", "Éxito", "Investigación actualizada correctamente.");
                NavManager.NavigateTo("/docente/investigaciones");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                MostrarAlerta("error", "Error", $"Error al guardar: {response.ReasonPhrase}\n{errorText}");
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al guardar cambios: " + ex.Message);
        }
    }

    private void Volver()
    {
        NavManager.NavigateTo("/docente/investigaciones");
    }
}
