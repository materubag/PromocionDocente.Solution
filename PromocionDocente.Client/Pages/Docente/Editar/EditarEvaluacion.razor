@page "/docente/editar/evaluacion/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update

<h3>Editar Evaluación</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="evaluacion" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Periodo Evaluado</label>
            <InputText class="form-control" @bind-Value="evaluacion.PeriodoEvaluado" />
        </div>
        <div class="mb-3">
            <label>Tipo Evaluación</label>
            <InputText class="form-control" @bind-Value="evaluacion.TipoEvaluacion" />
        </div>
        <div class="mb-3">
            <label>Fecha Evaluación</label>
            <InputDate class="form-control" @bind-Value="evaluacion.FechaEvaluacion" />
        </div>
        <div class="mb-3">
            <label>Resultado</label>
            <InputNumber class="form-control" @bind-Value="evaluacion.Resultado" />
        </div>
        <div class="mb-3">
            <label>Observaciones</label>
            <InputTextArea class="form-control" @bind-Value="evaluacion.Observaciones" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}

<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

<ConfirmacionToast Mostrar="@mostrarConfirmacion" Titulo="@tituloConfirmar" Mensaje="@mensajeConfirmar" OnConfirmar="@OnConfirmarToast" />

@code {
    [Parameter]
    public int Id { get; set; }

    private EvaluacionUpdateDto evaluacion = new();
    private bool isLoading = true;
    private string? errorMessage;

    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";
    private bool mostrarConfirmacion = false;
    private string tituloConfirmar = "";
    private string mensajeConfirmar = "";
    private TaskCompletionSource<bool> tcsConfirmar;

    private Task<bool> MostrarConfirmacion(string titulo, string mensaje)
    {
        tituloConfirmar = titulo;
        mensajeConfirmar = mensaje;
        mostrarConfirmacion = true;
        StateHasChanged();
        tcsConfirmar = new TaskCompletionSource<bool>();
        return tcsConfirmar.Task;
    }

    private Task OnConfirmarToast(bool respuesta)
    {
        mostrarConfirmacion = false;
        StateHasChanged();
        tcsConfirmar?.SetResult(respuesta);
        return Task.CompletedTask;
    }


    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }


    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<EvaluacionDto>($"api/Evaluaciones/{Id}");
            if (result == null)
            {
                MostrarAlerta("error", "Error", "No se encontró la evaluación solicitada.");
                return;
            }

            evaluacion = new EvaluacionUpdateDto
            {
                PeriodoEvaluado = result.PeriodoEvaluado,
                TipoEvaluacion = result.TipoEvaluacion,
                FechaEvaluacion = result.FechaEvaluacion,
                Resultado = result.Resultado,
                Observaciones = result.Observaciones,
                PdfEvaluacion = result.PdfEvaluacion
            };
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "No se pudo cargar la evaluación. " + ex.Message);
            
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Evaluaciones/{Id}", evaluacion);

            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("success", "Éxito", "Evaluación actualizada correctamente.");
                await Task.Delay(1500);
                NavManager.NavigateTo("/docente/evaluaciones");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                MostrarAlerta("error", "Error", $"Error al guardar: {response.ReasonPhrase}\n{errorText}");
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al guardar cambios: " + ex.Message);
        }
    }

    private void Volver()
    {
        NavManager.NavigateTo("/docente/evaluaciones");
    }
}
