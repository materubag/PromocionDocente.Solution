@page "/docente/editar/curso/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update


<h3>Editar Curso de Capacitación</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="curso" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre Curso</label>
            <InputText class="form-control" @bind-Value="curso.NombreCurso" />
        </div>
        <div class="mb-3">
            <label>Fecha Curso</label>
            <InputDate class="form-control" @bind-Value="curso.FechaCurso" />
        </div>
        <div class="mb-3">
            <label>Horas</label>
            <InputNumber class="form-control" @bind-Value="curso.Horas" />
        </div>
        <div class="mb-3">
            <label>Cambiar Archivo PDF (opcional):</label>
            <InputFile OnChange="OnInputFileChange" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}
@code {
    [Parameter]
    public int Id { get; set; }

    private CursoCapacitacionUpdateDto curso = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<CursoCapacitacionDto>($"api/CursosCapacitacions/{Id}");
            if (result == null)
            {
                errorMessage = "No se encontró el curso.";
                return;
            }

            curso = new CursoCapacitacionUpdateDto
            {
                NombreCurso = result.NombreCurso,
                FechaCurso = result.FechaCurso,
                Horas = result.Horas,
                PdfCurso = result.PdfCurso
            };
        }
        catch (Exception ex)
        {
            errorMessage = "Error al cargar curso: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/CursosCapacitacions/{Id}", curso);

            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Curso actualizado correctamente.");
                NavManager.NavigateTo("/docente/capacitaciones");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar: {response.ReasonPhrase}\n{errorText}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error al guardar cambios: " + ex.Message;
        }
    }
    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        using var stream = new MemoryStream();
        await e.File.OpenReadStream().CopyToAsync(stream);
        curso.PdfCurso = stream.ToArray();
    }



    private void Volver()
    {
        NavManager.NavigateTo("/docente/capacitaciones");
    }
}
