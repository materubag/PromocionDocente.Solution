@page "/docente/editar/curso/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IJSRuntime JS
@using PromocionDocente.Application.DTOs
@using PromocionDocente.Application.DTOs.Update


<h3>Editar Curso de Capacitación</h3>

@if (isLoading)
{
    <p>Cargando datos...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <EditForm Model="curso" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Nombre Curso</label>
            <InputText class="form-control" @bind-Value="curso.NombreCurso" />
        </div>
        <div class="mb-3">
            <label>Fecha Curso</label>
            <InputDate class="form-control" @bind-Value="curso.FechaCurso" />
        </div>
        <div class="mb-3">
            <label>Horas</label>
            <InputNumber class="form-control" @bind-Value="curso.Horas" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Volver">Cancelar</button>
    </EditForm>
}

<ToastAlerta Mostrar="@mostrarAlerta" Tipo="@tipoAlerta" Titulo="@tituloAlerta" Mensaje="@mensajeAlerta" OnCerrar="CerrarAlerta" />

<ConfirmacionToast Mostrar="@mostrarConfirmacion" Titulo="@tituloConfirmar" Mensaje="@mensajeConfirmar" OnConfirmar="@OnConfirmarToast" />

@code {
    [Parameter]
    public int Id { get; set; }

    private CursoCapacitacionUpdateDto curso = new();
    private bool isLoading = true;
    private string? errorMessage;

    // Variables para el sistema de alertas/toast
    private bool mostrarAlerta = false;
    private string tipoAlerta = "";
    private string tituloAlerta = "";
    private string mensajeAlerta = "";
    private bool mostrarConfirmacion = false;
    private string tituloConfirmar = "";
    private string mensajeConfirmar = "";
    private TaskCompletionSource<bool> tcsConfirmar;

    private Task<bool> MostrarConfirmacion(string titulo, string mensaje)
    {
        tituloConfirmar = titulo;
        mensajeConfirmar = mensaje;
        mostrarConfirmacion = true;
        StateHasChanged();
        tcsConfirmar = new TaskCompletionSource<bool>();
        return tcsConfirmar.Task;
    }

    private Task OnConfirmarToast(bool respuesta)
    {
        mostrarConfirmacion = false;
        StateHasChanged();
        tcsConfirmar?.SetResult(respuesta);
        return Task.CompletedTask;
    }


    private void MostrarAlerta(string tipo, string titulo, string mensaje)
    {
        tipoAlerta = tipo;
        tituloAlerta = titulo;
        mensajeAlerta = mensaje;
        mostrarAlerta = true;
        StateHasChanged();

        // Auto-cerrar después de 4 segundos
        _ = Task.Delay(4000).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                if (mostrarAlerta)
                {
                    CerrarAlerta();
                }
            });
        });
    }


    private void CerrarAlerta()
    {
        mostrarAlerta = false;
        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<CursoCapacitacionDto>($"api/CursosCapacitacions/{Id}");
            if (result == null)
            {
                MostrarAlerta("error", "Error", "Curso no encontrado.");
                return;
            }

            curso = new CursoCapacitacionUpdateDto
            {
                NombreCurso = result.NombreCurso,
                FechaCurso = result.FechaCurso,
                Horas = result.Horas,
                PdfCurso = result.PdfCurso
            };
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al cargar los datos del curso: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task GuardarCambios()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/CursosCapacitacions/{Id}", curso);

            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("success", "Éxito", "Curso actualizado correctamente.");
                await Task.Delay(1500);
                NavManager.NavigateTo("/docente/capacitaciones");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                MostrarAlerta("error", "Error", $"Error al guardar: {response.ReasonPhrase}\n{errorText}");
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta("error", "Error", "Error al guardar los cambios: " + ex.Message);
        }
    }


    private void Volver()
    {
        NavManager.NavigateTo("/docente/capacitaciones");
    }
}
