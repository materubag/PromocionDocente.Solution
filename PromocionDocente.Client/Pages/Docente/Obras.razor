@page "/docente/obras"
@layout DocenteLayout
@using Models
@inject IJSRuntime JSRuntime

<div class="obras-container">
    <!-- Header -->
    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">@docenteInfo.Nombre</div>
                    <div class="cargo">@docenteInfo.Cargo</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="obras-content">
        <!-- Barra de Herramientas -->
        <div class="toolbar">
            <div class="search-container">
                <input type="text" @bind="searchTerm" @oninput="OnSearchChanged"
                       placeholder="Buscar obras..." class="search-input" />
                <span class="search-icon">🔍</span>
            </div>
            <div class="toolbar-buttons">
                <button class="btn btn-primary" @onclick="AgregarObra">
                    <span class="btn-icon">+</span>
                    Agregar
                </button>
                <button class="btn btn-secondary" @onclick="ImportarObras">
                    <span class="btn-icon">📄</span>
                    Importar
                </button>
                <button class="btn btn-secondary" @onclick="EditarSeleccionado">
                    <span class="btn-icon">✏️</span>
                    Editar
                </button>
                <button class="btn btn-danger" @onclick="EliminarSeleccionado">
                    <span class="btn-icon">🗑️</span>
                    Eliminar
                </button>
            </div>
        </div>

        <!-- Tabla de Obras -->
        <div class="table-container">
            <table class="obras-table">
                <thead>
                    <tr>
                        <th class="checkbox-column">
                            <input type="checkbox" @onchange="SeleccionarTodos" />
                        </th>
                        <th class="documento-column">Documento</th>
                        <th class="autor-column">Autor</th>
                        <th class="tipo-column">Tipo</th>
                        <th class="fecha-column">Fecha</th>
                        <th class="estado-column">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (obrasFiltradas != null && obrasFiltradas.Any())
                    {
                        @foreach (var obra in obrasFiltradas)
                        {
                            <tr class="@(obra.Seleccionado ? "selected" : "")">
                                <td>
                                    <input type="checkbox" @bind="obra.Seleccionado" />
                                </td>
                                <td class="documento-cell">
                                    <div class="documento-info">
                                        <span class="documento-icon">📄</span>
                                        <span class="documento-nombre">@obra.Titulo</span>
                                    </div>
                                </td>
                                <td>@obra.Autor</td>
                                <td>
                                    <span class="tipo-badge @GetTipoClass(obra.Tipo)">
                                        @obra.Tipo
                                    </span>
                                </td>
                                <td>@obra.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="estado-badge @GetEstadoClass(obra.Estado)">
                                        @obra.Estado
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="no-data">
                                <div class="no-data-message">
                                    <span class="no-data-icon">📚</span>
                                    <p>No se encontraron obras</p>
                                    <button class="btn btn-primary" @onclick="AgregarObra">
                                        Agregar primera obra
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Barra de Progreso -->
        <div class="progress-section">
            <div class="progress-info">
                <span class="progress-label">Progreso</span>
                <span class="progress-text">@obras.Count de @metaObras obras completadas</span>
            </div>
            <div class="progress-bar-container">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @GetProgresoWidth()%"></div>
                </div>
            </div>
        </div>

        <!-- Fecha Límite -->
        <div class="deadline-alert">
            <span class="alert-icon">⏰</span>
            <span class="alert-text">Fecha límite: 15 julio, 2025 (41 días restantes)</span>
        </div>
    </div>
</div>

<style>
