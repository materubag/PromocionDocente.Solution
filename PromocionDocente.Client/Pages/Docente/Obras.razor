</style>

@code {
    private DocenteInfo docenteInfo;
    private List<Obra> obras = new List<Obra>();
    private List<Obra> obrasFiltradas = new List<Obra>();
    private string searchTerm = "";
    private int metaObras = 10;

    protected override void OnInitialized()
    {
        // Inicializar datos del docente
        docenteInfo = new DocenteInfo
        {
            Nombre = "Ing. Ismael Cuadrado",
            Cargo = "Profesor Auxiliar - Ing. Sistemas",
            Avatar = "https://via.placeholder.com/40x40/4A90E2/FFFFFF?text=IC"
        };

        // Datos de ejemplo
        obras = new List<Obra>
        {
            new Obra
            {
                Id = 1,
                Titulo = "Análisis de Algoritmos de Machine Learning",
                Autor = "Ismael Cuadrado",
                Tipo = "Artículo",
                FechaPublicacion = new DateTime(2024, 3, 15),
                Estado = "Publicado"
            },
            new Obra
            {
                Id = 2,
                Titulo = "Sistemas Distribuidos en la Nube",
                Autor = "Ismael Cuadrado, María González",
                Tipo = "Libro",
                FechaPublicacion = new DateTime(2024, 1, 10),
                Estado = "En Revisión"
            },
            new Obra
            {
                Id = 3,
                Titulo = "Inteligencia Artificial en la Educación",
                Autor = "Ismael Cuadrado",
                Tipo = "Capítulo",
                FechaPublicacion = new DateTime(2023, 11, 25),
                Estado = "Borrador"
            }
        };

        obrasFiltradas = obras.ToList();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        FiltrarObras();
    }

    private void FiltrarObras()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            obrasFiltradas = obras.ToList();
        }
        else
        {
            obrasFiltradas = obras.Where(o =>
                o.Titulo.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                o.Autor.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                o.Tipo.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
        StateHasChanged();
    }

    private void SeleccionarTodos(ChangeEventArgs e)
    {
        bool seleccionar = (bool)(e.Value ?? false);
        foreach (var obra in obrasFiltradas)
        {
            obra.Seleccionado = seleccionar;
        }
    }

    private async Task AgregarObra()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Abrir modal para agregar nueva obra");
    }

    private async Task ImportarObras()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Abrir modal para importar obras desde archivo");
    }

    private async Task EditarSeleccionado()
    {
        var seleccionados = obrasFiltradas.Where(o => o.Seleccionado).ToList();
        if (seleccionados.Any())
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Editar {seleccionados.Count} obra(s) seleccionada(s)");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Seleccione al menos una obra para editar");
        }
    }

    private async Task EliminarSeleccionado()
    {
        var seleccionados = obrasFiltradas.Where(o => o.Seleccionado).ToList();
        if (seleccionados.Any())
        {
            bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
                $"¿Está seguro de eliminar {seleccionados.Count} obra(s) seleccionada(s)?");

            if (confirmar)
            {
                foreach (var obra in seleccionados)
                {
                    obras.Remove(obra);
                }
                FiltrarObras();
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Seleccione al menos una obra para eliminar");
        }
    }

    private string GetTipoClass(string tipo)
    {
        return tipo.ToLower() switch
        {
            "artículo" => "tipo-articulo",
            "libro" => "tipo-libro",
            "capítulo" => "tipo-capitulo",
            _ => "tipo-articulo"
        };
    }

    private string GetEstadoClass(string estado)
    {
        return estado.ToLower() switch
        {
            "publicado" => "estado-publicado",
            "en revisión" => "estado-revision",
            "borrador" => "estado-borrador",
            _ => "estado-borrador"
        };
    }

    private double GetProgresoWidth()
    {
        if (metaObras == 0) return 0;
        return Math.Min(100, (double)obras.Count / metaObras * 100);
    }

    public class Obra
    {
        public int Id { get; set; }
        public string Titulo { get; set; } = "";
        public string Autor { get; set; } = "";
        public string Tipo { get; set; } = "";
        public DateTime FechaPublicacion { get; set; }
        public string Estado { get; set; } = "";
        public bool Seleccionado { get; set; }
    }

    public class DocenteInfo
    {
        public string Nombre { get; set; } = "";
        public string Cargo { get; set; } = "";
    }
}
