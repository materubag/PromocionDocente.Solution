</style>

@code {
    private DocenteInfo docenteInfo;
    private List<ObraInfo> obras = new List<ObraInfo>();
    private List<ObraInfo> obrasFiltradas = new List<ObraInfo>();
    private string filtroTexto = "";
    private int paginaActual = 1;
    private int elementosPorPagina = 10;
    private int totalElementos = 0;
    private int totalPaginas = 0;
    private bool isImporting = false;
    private int metaObras = 15;

    protected override void OnInitialized()
    {
        // Inicializar datos del docente
        docenteInfo = new DocenteInfo
        {
            Nombre = "Ing. Ismael Cuadrado",
            Cargo = "Profesor Auxiliar - Ing. Sistemas",
        };

        CargarObras();
    }

    private void CargarObras()
    {
        // Datos de ejemplo que coinciden con la estructura de la base de datos
        obras = new List<ObraInfo>
        {
            new ObraInfo {
                IdObra = 1,
                TipoObra = "Artículo",
                Titulo = "Análisis de Algoritmos de Machine Learning en Sistemas Educativos",
                FechaPublicacion = new DateTime(2024, 3, 15),
                DoiUrl = "https://doi.org/10.1234/ejemplo1",
                AreaConocimiento = "Inteligencia Artificial",
                Observaciones = "Artículo revisado por pares en revista indexada",
                PdfProduccion = new byte[] { 0x25, 0x50, 0x44, 0x46 } // Simulación de datos PDF
            },
            new ObraInfo {
                IdObra = 2,
                TipoObra = "Libro",
                Titulo = "Sistemas Distribuidos en la Nube: Fundamentos y Aplicaciones",
                FechaPublicacion = new DateTime(2024, 1, 10),
                DoiUrl = null, // Puede ser null según la BD
                AreaConocimiento = "Sistemas Distribuidos",
                Observaciones = "Editorial universitaria reconocida",
                PdfProduccion = new byte[] { 0x25, 0x50, 0x44, 0x46 }
            },
            new ObraInfo {
                IdObra = 3,
                TipoObra = "Capítulo",
                Titulo = "Inteligencia Artificial en la Educación Superior",
                FechaPublicacion = new DateTime(2023, 11, 25),
                DoiUrl = "https://doi.org/10.1234/ejemplo3",
                AreaConocimiento = "Educación Tecnológica",
                Observaciones = "Capítulo en libro colectivo",
                PdfProduccion = null // Sin PDF
            },
            new ObraInfo {
                IdObra = 4,
                TipoObra = "Ponencia",
                Titulo = "Implementación de Blockchain en Sistemas Académicos",
                FechaPublicacion = new DateTime(2023, 9, 5),
                DoiUrl = "",
                AreaConocimiento = "Blockchain",
                Observaciones = "Presentado en congreso internacional",
                PdfProduccion = new byte[] { 0x25, 0x50, 0x44, 0x46 }
            },
            new ObraInfo {
                IdObra = 5,
                TipoObra = "Tesis",
                Titulo = "Optimización de Consultas en Bases de Datos NoSQL",
                FechaPublicacion = new DateTime(2023, 6, 20),
                DoiUrl = "https://repositorio.ejemplo.edu/tesis/5",
                AreaConocimiento = "Bases de Datos",
                Observaciones = "Tesis doctoral, mención cum laude",
                PdfProduccion = new byte[] { 0x25, 0x50, 0x44, 0x46 }
            }
        };

        FiltrarObras();
    }

    private void FiltrarObras()
    {
        obrasFiltradas = obras.Where(o =>
            string.IsNullOrEmpty(filtroTexto) ||
            o.Titulo.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            o.TipoObra.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            (o.AreaConocimiento?.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();

        totalElementos = obrasFiltradas.Count;
        totalPaginas = (int)Math.Ceiling((double)totalElementos / elementosPorPagina);

        // Aplicar paginación
        obrasFiltradas = obrasFiltradas
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina)
            .ToList();

        StateHasChanged();
    }

    private string GetClaseTipo(string tipo)
    {
        return tipo.ToLower() switch
        {
            "artículo" => "tipo-articulo",
            "libro" => "tipo-libro",
            "capítulo" => "tipo-capitulo",
            "tesis" => "tipo-tesis",
            "ponencia" => "tipo-ponencia",
            _ => "tipo-articulo"
        };
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var obra in obrasFiltradas)
        {
            obra.Seleccionada = seleccionar;
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            FiltrarObras();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            FiltrarObras();
        }
    }

    private int GetPorcentajeProgreso()
    {
        if (metaObras == 0) return 0;
        return Math.Min(100, (obras.Count * 100) / metaObras);
    }

    // Métodos de acción
    private async Task AgregarObra()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función: Agregar Nueva Obra\n\n• Se abrirá el formulario para registrar una nueva obra\n• Complete todos los campos requeridos\n• Adjunte el documento PDF si está disponible\n• Guarde los cambios para continuar");
    }

    private async Task ImportarObras()
    {
        if (isImporting) return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
            "¿Desea importar obras desde un archivo?\n\n" +
            "• Formatos soportados: Excel (.xlsx), CSV (.csv)\n" +
            "• El archivo debe contener las columnas: Tipo, Título, Fecha, DOI/URL, Área\n" +
            "• Las obras duplicadas serán omitidas\n\n" +
            "¿Continuar con la importación?");

        if (confirmar)
        {
            isImporting = true;
            StateHasChanged();

            // proceso de importación
            await Task.Delay(3000);

            isImporting = false;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("alert",
                "¡Importación completada exitosamente!\n\n" +
                "• 8 obras nuevas importadas\n" +
                "• 3 obras duplicadas omitidas\n" +
                "• Los datos han sido validados y guardados");
        }
    }

    private async Task EditarSeleccionada()
    {
        var seleccionada = obrasFiltradas.FirstOrDefault(o => o.Seleccionada);
        if (seleccionada != null)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"Editar Obra Seleccionada\n\n" +
                $"• Título: {seleccionada.Titulo}\n" +
                $"• Tipo: {seleccionada.TipoObra}\n" +
                $"• Área: {seleccionada.AreaConocimiento}\n\n" +
                $"Se abrirá el formulario de edición...");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Atención\n\n" +
                "No hay ninguna obra seleccionada.\n" +
                "Por favor, seleccione una obra de la lista para editarla.");
        }
    }

    private async Task DescargarPDF(ObraInfo obra)
    {
        if (obra.TienePDF())
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"📄 Descargando Documento PDF\n\n" +
                $"• Obra: {obra.Titulo}\n" +
                $"• Tipo: {obra.TipoObra}\n" +
                $"• La descarga comenzará automáticamente...");
        }
    }

    private async Task AbrirUrl(string url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

   
    public class ObraInfo
    {
        public int IdObra { get; set; }
        public string TipoObra { get; set; } = "";
        public string Titulo { get; set; } = "";
        public DateTime FechaPublicacion { get; set; }
        public string? DoiUrl { get; set; }
        public string? AreaConocimiento { get; set; }
        public string? Observaciones { get; set; }
        public byte[]? PdfProduccion { get; set; }
        
        public bool Seleccionada { get; set; }
        
        // Método para verificar si tiene PDF
        public bool TienePDF()
        {
            return PdfProduccion != null && PdfProduccion.Length > 0;
        }
    }

    public class DocenteInfo
    {
        public string Nombre { get; set; } = "";
        public string Cargo { get; set; } = "";
    }
}