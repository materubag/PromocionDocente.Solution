@page "/docente/obras"
@layout DocenteLayout
@using Models
@inject IJSRuntime JSRuntime

<div class="obras-container">

    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">@docenteInfo.Nombre</div>
                    <div class="cargo">@docenteInfo.Cargo</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="contenido-principal">
        <div class="tabla-container">
            <!-- Barra de herramientas -->
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar obras..." @bind="filtroTexto" @oninput="FiltrarObras" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-primary" @onclick="AgregarObra">
                        <span class="btn-icon">➕</span>
                        Agregar
                    </button>
                    <button class="btn btn-secondary" @onclick="ImportarObras" disabled="@isImporting">
                        <span class="btn-icon">📁</span>
                        @(isImporting ? "Importando..." : "Importar")
                    </button>
                    <button class="btn btn-secondary" @onclick="EditarSeleccionada">
                        <span class="btn-icon">✏️</span>
                        Editar
                    </button>
                </div>
            </div>

            <!-- Tabla de obras -->
            <div class="tabla-obras">
                <table class="obras-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodas" />
                            </th>
                            <th class="col-tipo">Tipo Obra</th>
                            <th class="col-titulo">Título</th>
                            <th class="col-fecha">Fecha Publicación</th>
                            <th class="col-area">Área Conocimiento</th>
                            <th class="col-documento">Documento</th>
                            <th class="col-doi">DOI/URL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (obrasFiltradas != null && obrasFiltradas.Any())
                        {
                            @foreach (var obra in obrasFiltradas)
                            {
                                <tr class="@(obra.Seleccionada ? "selected" : "")">
                                    <td>
                                        <input type="checkbox" @bind="obra.Seleccionada" />
                                    </td>
                                    <td>
                                        <span class="badge-tipo @GetClaseTipo(obra.TipoObra)">
                                            @obra.TipoObra
                                        </span>
                                    </td>
                                    <td class="titulo-cell">
                                        <div class="titulo-info">
                                            <span class="titulo-texto">@obra.Titulo</span>
                                            @if (!string.IsNullOrEmpty(obra.Observaciones))
                                            {
                                                <small class="observaciones">@obra.Observaciones</small>
                                            }
                                        </div>
                                    </td>
                                    <td>@obra.FechaPublicacion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="area-badge">@(obra.AreaConocimiento ?? "Sin especificar")</span>
                                    </td>
                                    <td class="documento">
                                        @if (obra.TienePDF())
                                        {
                                            <button class="btn-documento" @onclick="() => DescargarPDF(obra)" title="Descargar PDF">
                                                <span class="documento-icon">📄</span>
                                                <span class="documento-text">PDF</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                    <td class="doi-cell">
                                        @if (!string.IsNullOrEmpty(obra.DoiUrl))
                                        {
                                            <button class="btn-doi" @onclick="() => AbrirUrl(obra.DoiUrl)" title="Abrir enlace">
                                                <span class="doi-icon">🔗</span>
                                                <span class="doi-text">Ver</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-doi">Sin enlace</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="no-data">No se encontraron obras</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @((paginaActual - 1) * elementosPorPagina + 1) - @(Math.Min(paginaActual * elementosPorPagina, totalElementos)) de @totalElementos obras
                </div>
                <div class="pagination-controls">
                    <button class="btn-page" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">◀</button>
                    <span class="page-info">Página @paginaActual de @totalPaginas</span>
                    <button class="btn-page" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">▶</button>
                </div>
            </div>
        </div>
        
    </div>
</div>

<style>
