        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        transition: all 0.2s;
    }

        .btn-documento:hover {
            background: #28a745;
            color: white;
        }

