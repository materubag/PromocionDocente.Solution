        width: 300px;
    }

    .col-fecha {
        width: 120px;
    }

    .col-area {
        width: 150px;
    }

    .col-documento {
        width: 100px;
    }

    .col-doi {
        width: 80px;
    }

    .badge-tipo {
        padding: 0.25rem 0.5rem;
        border-radius: 12px;
        font-size: 0.8rem;
