@inject IJSRuntime JS
@inject HttpClient Http

@if (mostrar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="@nuevaObra" OnValidSubmit="GuardarObra">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="modal-header">
                        <h5 class="modal-title">Agregar Nueva Obra</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Título</label>
                            <InputText class="form-control" @bind-Value="nuevaObra.TITULO" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tipo de Obra</label>
                            <InputText class="form-control" @bind-Value="nuevaObra.TIPO_OBRA" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha de Publicación</label>
                            <InputDate class="form-control" @bind-Value="nuevaObra.FECHA_PUBLICACION" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Área de Conocimiento</label>
                            <InputText class="form-control" @bind-Value="nuevaObra.AREA_CONOCIMIENTO" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">DOI o URL</label>
                            <InputText class="form-control" @bind-Value="nuevaObra.DOI_URL" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Observaciones</label>
                            <InputTextArea class="form-control" @bind-Value="nuevaObra.OBSERVACIONES" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Archivo PDF</label>
                            <InputFile OnChange="OnInputFileChange" class="form-control" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string CedulaDocente { get; set; }
    [Parameter] public EventCallback OnObraGuardada { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private ObraDto nuevaObra = new();
    private IBrowserFile archivoPdf;
    private bool mostrar = true; // control interno del modal

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        archivoPdf = e.File;
        using var stream = archivoPdf.OpenReadStream();
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        nuevaObra.PDF_PRODUCCION = ms.ToArray();
    }

    private async Task GuardarObra()
    {
        nuevaObra.CED_DOC = CedulaDocente;

        var response = await Http.PostAsJsonAsync("api/obras", nuevaObra);
        if (response.IsSuccessStatusCode)
        {
            await OnObraGuardada.InvokeAsync();
            mostrar = false; // Oculta el modal
        }
        else
        {
            // puedes mostrar error con JS o un mensaje en pantalla
            await JS.InvokeVoidAsync("alert", "Hubo un error al guardar la obra.");
        }
    }

    private async Task CerrarModal()
    {
        mostrar = false;
        await OnCancelar.InvokeAsync();
    }

    public class ObraDto
    {
        public string CED_DOC { get; set; }
        public string TIPO_OBRA { get; set; }
        public string TITULO { get; set; }
        public DateTime FECHA_PUBLICACION { get; set; }
        public string AREA_CONOCIMIENTO { get; set; }
        public string DOI_URL { get; set; }
        public string OBSERVACIONES { get; set; }
        public byte[] PDF_PRODUCCION { get; set; }
    }
}
