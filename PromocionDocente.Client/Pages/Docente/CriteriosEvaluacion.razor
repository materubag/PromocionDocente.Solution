@code {
    // Inicializar con valores por defecto para evitar NullReferenceException
    private DatosEvaluacionCompleta datosEvaluacion = new DatosEvaluacionCompleta();
    private int progresoGeneral = 0;
    private SolicitudesRechazadas solicitudesRechazadas = new SolicitudesRechazadas();
    private bool tienePostulacionRechazada = false;
    private bool hayRechazosDisponibles = false;
    private RequisitoNivel requisitosNivelSiguiente = new RequisitoNivel();

    // Definición de requisitos por nivel
    private Dictionary<string, RequisitoNivel> requisitosNiveles = new Dictionary<string, RequisitoNivel>
    {
        ["DT2"] = new RequisitoNivel { AniosDocencia = 4, NumeroObras = 1, PromedioEvaluacion = 75, HorasCapacitacion = 96, MesesInvestigacion = 0 },
        ["DT3"] = new RequisitoNivel { AniosDocencia = 4, NumeroObras = 2, PromedioEvaluacion = 75, HorasCapacitacion = 96, MesesInvestigacion = 12 },
        ["DT4"] = new RequisitoNivel { AniosDocencia = 4, NumeroObras = 3, PromedioEvaluacion = 75, HorasCapacitacion = 128, MesesInvestigacion = 24 },
        ["DT5"] = new RequisitoNivel { AniosDocencia = 4, NumeroObras = 5, PromedioEvaluacion = 75, HorasCapacitacion = 160, MesesInvestigacion = 24 }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Leer cédula desde localStorage
            var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");
            string cedulaUsuario = "";

            if (!string.IsNullOrEmpty(usuarioJson))
            {
                var usuario = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
                cedulaUsuario = usuario?.Cedula ?? "";
            }

            if (string.IsNullOrEmpty(cedulaUsuario))
            {
                Console.WriteLine("No se encontró la cédula del usuario en localStorage.");
            }
            else
            {
                datosEvaluacion = await Http.GetFromJsonAsync<DatosEvaluacionCompleta>($"api/HistorialDocentes/estadisticas/{cedulaUsuario}");

                // Cargar los requisitos para el siguiente nivel
                if (!string.IsNullOrEmpty(datosEvaluacion?.Cat2) && requisitosNiveles.ContainsKey(datosEvaluacion.Cat2))
                {
                    requisitosNivelSiguiente = requisitosNiveles[datosEvaluacion.Cat2];
                }

                // Cargar datos de postulaciones rechazadas
                try
                {
                    var respuestaRechazos = await Http.GetFromJsonAsync<SolicitudesRechazadas>($"api/DetallePostulacions/rechazados/{cedulaUsuario}");

                    if (respuestaRechazos != null)
                    {
                        solicitudesRechazadas = respuestaRechazos;

                        // Verificar si hay postulaciones rechazadas
                        hayRechazosDisponibles = solicitudesRechazadas.TotalRechazados > 0;

                        // Por defecto, mostrar la vista de rechazos primero si hay alguno
                        tienePostulacionRechazada = hayRechazosDisponibles;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al cargar postulaciones rechazadas: {ex.Message}");
                    hayRechazosDisponibles = false;
                    tienePostulacionRechazada = false;
                }

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar datos: " + ex.Message);
        }
        finally
        {
            progresoGeneral = CalcularProgresoGeneral();
        }
    }

    private void VerCriterios()
    {
        tienePostulacionRechazada = false;
    }

    private void VerRechazos()
    {
        tienePostulacionRechazada = true;
    }

    private async Task EnviarPostulacion()
    {
        var confirmacion = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de enviar tu postulación para ascenso de nivel?");

        if (confirmacion)
        {
            try
            {
                // Obtener la cédula del usuario
                var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");
                string cedula = "";

                if (!string.IsNullOrEmpty(usuarioJson))
                {
                    var usuario = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
                    cedula = usuario?.Cedula ?? "";
                }

                if (string.IsNullOrEmpty(cedula))
                {
                    await JSRuntime.InvokeVoidAsync("alert", "No se pudo determinar la cédula del usuario.");
                    return;
                }

                var content = new StringContent(
                    System.Text.Json.JsonSerializer.Serialize(cedula),
                    System.Text.Encoding.UTF8,
                    "application/json");

                var respuesta = await Http.PostAsync("api/Postulaciones", content);

                if (respuesta.IsSuccessStatusCode)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Postulación enviada con éxito. Serás notificado cuando sea revisada.");
                    Console.WriteLine("Postulación enviada exitosamente");
                }
                else
                {
                    string errorMessage = await respuesta.Content.ReadAsStringAsync();
                    await JSRuntime.InvokeVoidAsync("alert", $"Error al enviar la postulación: {errorMessage}");
                    Console.WriteLine($"Error en la respuesta: {errorMessage}");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al enviar postulación: {ex.Message}");
                await JSRuntime.InvokeVoidAsync("alert", "Error al procesar la solicitud. Contacta al administrador.");
            }
        }
    }

    private int CalcularProgresoGeneral()
    {
        if (datosEvaluacion == null || string.IsNullOrEmpty(datosEvaluacion.CategoriaSiguiente))
        {
            return 100; // Nivel máximo alcanzado o datos no disponibles
        }

        var porcentajes = new List<int>
        {
            GetPorcentaje(datosEvaluacion.TotalObras, requisitosNivelSiguiente.NumeroObras),
            GetPorcentaje(datosEvaluacion.MesesInvestigacion, requisitosNivelSiguiente.MesesInvestigacion),
            GetPorcentajeDecimal(datosEvaluacion.PromedioEvaluacion, requisitosNivelSiguiente.PromedioEvaluacion),
            GetPorcentaje(datosEvaluacion.HorasCursos, requisitosNivelSiguiente.HorasCapacitacion),
            GetPorcentajeDecimal(datosEvaluacion.AniosServicio, requisitosNivelSiguiente.AniosDocencia)
        };

        return (int)porcentajes.Average();
    }

    private int GetPorcentaje(int valorActual, int valorRequerido)
    {
        if (valorRequerido == 0) return 100;
        return Math.Min(100, (valorActual * 100) / valorRequerido);
    }

    private int GetPorcentajeDecimal(decimal valorActual, decimal valorRequerido)
    {
        if (valorRequerido == 0) return 100;
        return (int)Math.Min(100, (valorActual * 100 / valorRequerido));
    }

