@page "/docente/criterios"
@layout PromocionDocente.Client.Layout.DocenteLayout
@using PromocionDocente.Client.Models
@using System.Text.Json.Serialization
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<!-- Header siempre visible -->
<div class="header-container">
    <div class="header-content">
        <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
    </div>
</div>

<div class="criterios-evaluacion-container">
    <h2>Criterios de Evaluación</h2>
    
    <div class="criterios-list">
        <!-- Años de Docencia -->
        <div class="criterio-item">
            <div class="criterio-header">
                <span class="criterio-porcentaje">10%</span>
                <h3 class="criterio-titulo">Años Docencia</h3>
            </div>
            <div class="criterio-detalle">
                <span>@(datosEvaluacion?.AniosdeDocencia ?? 0) años</span>
            </div>
        </div>
        
        <!-- Cursos -->
        <div class="criterio-item">
            <div class="criterio-header">
                <span class="criterio-porcentaje">30%</span>
                <h3 class="criterio-titulo">Cursos</h3>
            </div>
            <div class="criterio-detalle">
                <span>@(datosEvaluacion?.CursosdeCapacitacion ?? 0) horas</span>
            </div>
        </div>
        
        <!-- Obras -->
        <div class="criterio-item">
            <div class="criterio-header">
                <span class="criterio-porcentaje">20%</span>
                <h3 class="criterio-titulo">Obras</h3>
            </div>
            <div class="criterio-detalle">
                <span>@(datosEvaluacion?.NumerodeObras ?? 0) obras</span>
            </div>
        </div>
        
        <!-- Evaluaciones -->
        <div class="criterio-item">
            <div class="criterio-header">
                <span class="criterio-porcentaje">20%</span>
                <h3 class="criterio-titulo">Evaluaciones</h3>
            </div>
            <div class="criterio-detalle">
                <span>Promedio: @(datosEvaluacion?.PromediodeEvaluacion.ToString("0.00") ?? "0")</span>
            </div>
        </div>
        
        <!-- Investigaciones -->
        <div class="criterio-item">
            <div class="criterio-header">
                <span class="criterio-porcentaje">20%</span>
                <h3 class="criterio-titulo">Investigaciones</h3>
            </div>
            <div class="criterio-detalle">
                <span>@(datosEvaluacion?.HorasdeInvestigacion ?? 0) meses</span>
            </div>
        </div>
    </div>
</div>

            @if (solicitudesRechazadas.ObrasRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Obras Rechazadas (@solicitudesRechazadas.ObrasRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var obra in solicitudesRechazadas.ObrasRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@obra.Titulo</div>
                                <div class="item-rechazado-detalle">
                                    <span>Tipo: @obra.TipoObra</span>
                                    <span>Fecha: @obra.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@obra.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.InvestigacionesRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Investigaciones Rechazadas (@solicitudesRechazadas.InvestigacionesRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var inv in solicitudesRechazadas.InvestigacionesRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@inv.TituloInvestigacion</div>
                                <div class="item-rechazado-detalle">
                                    <span>Periodo: @inv.FechaInicio.ToString("dd/MM/yyyy") - @inv.FechaFin.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@inv.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.CursosRechazados.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Cursos Rechazados (@solicitudesRechazadas.CursosRechazados.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var curso in solicitudesRechazadas.CursosRechazados)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@curso.NombreCurso</div>
                                <div class="item-rechazado-detalle">
                                    <span>Fecha: @curso.FechaCurso.ToString("dd/MM/yyyy")</span>
                                    <span>Horas: @curso.Horas</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@curso.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.EvaluacionesRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Evaluaciones Rechazadas (@solicitudesRechazadas.EvaluacionesRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var eval in solicitudesRechazadas.EvaluacionesRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@eval.TipoEvaluacion</div>
                                <div class="item-rechazado-detalle">
                                    <span>Periodo: @eval.PeriodoEvaluado</span>
                                    <span>Resultado: @eval.Resultado.ToString("F2")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@eval.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="boton-regresar">
                <button class="btn-regresar" @onclick="VerCriterios">
                    Regresar a Criterios
                </button>
            </div>

}

<style>
    /* Estilos para el header */
    .header-container {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #d3d3d3 0%, #b0b0b0 100%);
    }

    .header-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .titulo-principal {
        color: white;
        font-size: 2rem;
        font-weight: 300;
        margin: 0;
    }

    /* Estilos para el contenedor de criterios */
    .criterios-evaluacion-container {
        max-width: 100%;
        margin: 2rem auto;
        padding: 2rem;
        background: white;  
    }

    .criterios-evaluacion-container h2 {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 2rem;
        font-size: 1.8rem;
        border-bottom: 2px solid #f7f7f8;
        padding-bottom: 0.5rem;
    }

    .criterios-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .criterio-item {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        border-left: 4px solid #581517 ;
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
        min-height: 120px;
    }

    .criterio-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
    }

    .criterio-header {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .criterio-porcentaje {
        background: #581517;
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-weight: bold;
        margin-right: 1rem;
        font-size: 0.9rem;
    }

    .criterio-titulo {
        margin: 0;
        color: #2c3e50;
        font-size: 1.2rem;
    }

    .criterio-detalle {
        color: #6c757d;
        font-size: 1rem;
        padding-left: 2.5rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .criterios-evaluacion-container {
            padding: 1rem;
            margin: 1rem;
        }
        
        .criterio-item {
            padding: 1rem;
        }
        
        .criterio-titulo {
            font-size: 1.1rem;
        }
        .criterios-list {
            grid-template-columns: 1fr; /* Una columna en móviles */
        }
        
    }
    @@media (min-width: 1200px) {
        .criterios-list {
            grid-template-columns: repeat(5, 1fr); /* 5 columnas en pantallas grandes */
        }
    }

        .btn-regresar:hover {
            background-color: #0a3d8f;
        }
</style>

@code {
    private DatosEvaluacion datosEvaluacion;
    private int progresoGeneral = 0;
    private string nivelObjetivo = "DT2";
    private DocenteInfo docenteInfo;
    private SolicitudesRechazadas solicitudesRechazadas;
    private bool tienePostulacionRechazada = false;
    private bool hayRechazosDisponibles = false;

    private static class RequisitosP1
    {
        public static int NumeroObras = 1;
        public static int MesesInvestigacion = 0;
        public static decimal PromedioEvaluacion = 100.0m;
        public static int HorasCapacitacion = 96;
        public static decimal AniosDocencia = 4.0m;
    }

    protected override async Task OnInitializedAsync()
    {
        docenteInfo = new DocenteInfo
        {
            Nombre = "Nombre del Docente",
            Cargo = "Cargo del Docente"
        };

        try
        {
            // Leer cédula desde localStorage
            var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");
            string cedulaUsuario = "";

            if (!string.IsNullOrEmpty(usuarioJson)) {
                var usuario = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
                cedulaUsuario = usuario?.Cedula ?? "";
            }

            if (string.IsNullOrEmpty(cedulaUsuario))
            {
                Console.WriteLine("No se encontró la cédula del usuario en localStorage.");
                datosEvaluacion = new DatosEvaluacion(); // valores vacíos o default
            }
            else
            {
                datosEvaluacion = await Http.GetFromJsonAsync<DatosEvaluacion>($"api/HistorialDocentes/estadisticas/{cedulaUsuario}");

                // Cargar datos de postulaciones rechazadas
                try
                {
                    solicitudesRechazadas = await Http.GetFromJsonAsync<SolicitudesRechazadas>($"api/DetallePostulacions/rechazados/{cedulaUsuario}");

                    // Verificar si hay postulaciones rechazadas
                    hayRechazosDisponibles = solicitudesRechazadas != null && solicitudesRechazadas.TotalRechazados > 0;

                    // Por defecto, mostrar la vista de rechazos primero si hay alguno
                    tienePostulacionRechazada = hayRechazosDisponibles;

                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error al cargar postulaciones rechazadas: {ex.Message}");
                    hayRechazosDisponibles = false;
                    tienePostulacionRechazada = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error al cargar datos: " + ex.Message);
            datosEvaluacion = new DatosEvaluacion(); // valores vacíos
        }
        finally
        {
            progresoGeneral = CalcularProgresoGeneral();
        }
    }

    private void VerCriterios()
    {
        tienePostulacionRechazada = false;
    }

    private void VerRechazos()
    {
        tienePostulacionRechazada = true;
    }

    private int CalcularProgresoGeneral()
    {
        var porcentajes = new List<int>
        {
            GetPorcentaje(datosEvaluacion.NumerodeObras, RequisitosP1.NumeroObras),
            GetPorcentaje(datosEvaluacion.HorasdeInvestigacion, RequisitosP1.MesesInvestigacion),
            GetPorcentajeDecimal(datosEvaluacion.PromediodeEvaluacion, RequisitosP1.PromedioEvaluacion),
            GetPorcentaje(datosEvaluacion.CursosdeCapacitacion, RequisitosP1.HorasCapacitacion),
            GetPorcentajeDecimal(datosEvaluacion.AniosdeDocencia, RequisitosP1.AniosDocencia)
        };

        return (int)porcentajes.Average();
    }

    private int GetPorcentaje(int valorActual, int valorRequerido)
    {
        if (valorRequerido == 0) return 100;
        return Math.Min(100, (valorActual * 100) / valorRequerido);
    }

    private int GetPorcentajeDecimal(decimal valorActual, decimal valorRequerido)
    {
        if (valorRequerido == 0) return 100;
        return (int)Math.Min(100, (valorActual * 100 / valorRequerido));
    }

    public class DatosEvaluacion
    {
        [JsonPropertyName("fechaBase")]
        public string FechaBase { get; set; }

        [JsonPropertyName("totalObras")]
        public int NumerodeObras { get; set; }

        [JsonPropertyName("mesesInvestigacion")]
        public int HorasdeInvestigacion { get; set; }

        [JsonPropertyName("promedioEvaluacion")]
        public decimal PromediodeEvaluacion { get; set; }

        [JsonPropertyName("horasCursos")]
        public int CursosdeCapacitacion { get; set; }

        [JsonPropertyName("aniosServicio")]
        public decimal AniosdeDocencia { get; set; }
    }

    private class DocenteInfo
    {
        public string Nombre { get; set; }
        public string Cargo { get; set; }
    }

    public class LoginResponse {
        public string Cedula { get; set; } = "";
        public string Nombre1 { get; set; } = "";
        public string Apellido1 { get; set; } = "";
        public string Rol { get; set; } = "";
    }

    // Clases para las solicitudes rechazadas
    public class SolicitudesRechazadas
    {
        public string CedulaDocente { get; set; }
        public string NombreDocente { get; set; }
        public string CategoriaActual { get; set; }
        public string UltimaFechaHistorial { get; set; }
        public List<ObraRechazada> ObrasRechazadas { get; set; } = new List<ObraRechazada>();
        public List<InvestigacionRechazada> InvestigacionesRechazadas { get; set; } = new List<InvestigacionRechazada>();
        public List<CursoRechazado> CursosRechazados { get; set; } = new List<CursoRechazado>();
        public List<EvaluacionRechazada> EvaluacionesRechazadas { get; set; } = new List<EvaluacionRechazada>();
        public int TotalRechazados { get; set; }
        public string FechaGeneracion { get; set; }
        public string UsuarioGeneracion { get; set; }
    }

    public class ObraRechazada
    {
        public int IdObra { get; set; }
        public string Titulo { get; set; }
        public string TipoObra { get; set; }
        public DateTime FechaPublicacion { get; set; }
        public string Observacion { get; set; }
    }

    public class InvestigacionRechazada
    {
        public int IdInvestigacion { get; set; }
        public string TituloInvestigacion { get; set; }
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public string Observacion { get; set; }
    }

    public class CursoRechazado
    {
        public int IdCurso { get; set; }
        public string NombreCurso { get; set; }
        public DateTime FechaCurso { get; set; }
        public int Horas { get; set; }
        public string Observacion { get; set; }
    }

    public class EvaluacionRechazada
    {
        public int IdEvaluacion { get; set; }
        public string TipoEvaluacion { get; set; }
        public string PeriodoEvaluado { get; set; }
        public decimal Resultado { get; set; }
        public string Observacion { get; set; }
    }
}