</style>

@code {
	private DatosEvaluacion datosEvaluacion;
	private int progresoGeneral = 0;
	private string nivelObjetivo = "DT2";
	private DocenteInfo docenteInfo;

	private static class RequisitosP1
	{
		public static int NumeroObras = 1;
		public static int MesesInvestigacion = 0;
		public static decimal PromedioEvaluacion = 100.0m;
		public static int HorasCapacitacion = 96;
		public static decimal AniosDocencia = 4.0m;
	}



	protected override async Task OnInitializedAsync()
	{
		docenteInfo = new DocenteInfo
			{
				Nombre = "Nombre del Docente",
				Cargo = "Cargo del Docente"
			};

		try
		{
			// Leer cédula desde localStorage
			var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");
			string cedulaUsuario = "";

			if (!string.IsNullOrEmpty(usuarioJson))
			{
				var usuario = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
				cedulaUsuario = usuario?.Cedula ?? "";
			}

			if (string.IsNullOrEmpty(cedulaUsuario))
			{
				Console.WriteLine("No se encontró la cédula del usuario en localStorage.");
				datosEvaluacion = new DatosEvaluacion(); // valores vacíos o default
			}
			else
			{
				datosEvaluacion = await Http.GetFromJsonAsync<DatosEvaluacion>($"api/HistorialDocentes/estadisticas/{cedulaUsuario}");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine("Error al cargar datos: " + ex.Message);
			datosEvaluacion = new DatosEvaluacion(); // valores vacíos
		}
		finally
		{
			progresoGeneral = CalcularProgresoGeneral();
		}
	}

	// Clase para deserializar localStorage.usuario
	public class LoginResponse
	{
		public string Cedula { get; set; } = "";
		public string Nombre1 { get; set; } = "";
		public string Apellido1 { get; set; } = "";
		public string Rol { get; set; } = "";
	}




	private int CalcularProgresoGeneral()
	{
		var porcentajes = new List<int>
	{
		GetPorcentaje(datosEvaluacion.NumerodeObras, RequisitosP1.NumeroObras),
		GetPorcentaje(datosEvaluacion.HorasdeInvestigacion, RequisitosP1.MesesInvestigacion),
		GetPorcentajeDecimal(datosEvaluacion.PromediodeEvaluacion, RequisitosP1.PromedioEvaluacion),
		GetPorcentaje(datosEvaluacion.CursosdeCapacitacion, RequisitosP1.HorasCapacitacion),
		GetPorcentajeDecimal(datosEvaluacion.AniosdeDocencia, RequisitosP1.AniosDocencia)
	};

		return (int)porcentajes.Average();
	}

	private int GetPorcentaje(int valorActual, int valorRequerido)
	{
		if (valorRequerido == 0) return 100;
		return Math.Min(100, (valorActual * 100) / valorRequerido);
	}

	private int GetPorcentajeDecimal(decimal valorActual, decimal valorRequerido)
	{
		if (valorRequerido == 0) return 100;
		return (int)Math.Min(100, (valorActual * 100 / valorRequerido));
	}

	public class DatosEvaluacion
	{
		[JsonPropertyName("fechaBase")]
		public string FechaBase { get; set; }

		[JsonPropertyName("totalObras")]
		public int NumerodeObras { get; set; }

		[JsonPropertyName("mesesInvestigacion")]
		public int HorasdeInvestigacion { get; set; }

		[JsonPropertyName("promedioEvaluacion")]
		public decimal PromediodeEvaluacion { get; set; }

		[JsonPropertyName("horasCursos")]
		public int CursosdeCapacitacion { get; set; }

		[JsonPropertyName("aniosServicio")]
		public decimal AniosdeDocencia { get; set; }
	}

	private class DocenteInfo
	{
		public string Nombre { get; set; }
		public string Cargo { get; set; }
	}
}


