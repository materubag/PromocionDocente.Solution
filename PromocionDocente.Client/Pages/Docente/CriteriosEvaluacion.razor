@page "/docente/criterios"
@layout PromocionDocente.Client.Layout.DocenteLayout
@using PromocionDocente.Client.Models
@using System.Text.Json.Serialization
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="evaluacion-container">
	<!-- Header -->
	<div class="header-container">
		<div class="header-content">
			<h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
			<div class="docente-info">
				<div class="info-text">
					<div class="nombre">@docenteInfo.Nombre</div>
					<div class="cargo">@docenteInfo.Cargo</div>
				</div>
			</div>
		</div>
	</div>

	<div class="criterios-grid">
		<!-- Número de Obras -->
		<div class="criterio-card">
			<div class="criterio-header">
				<h3>Número de Obras</h3>
				<span class="criterio-valor">@(datosEvaluacion?.NumerodeObras ?? 0)/@RequisitosP1.NumeroObras</span>
			</div>
			<div class="progress-bar">
				<div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.NumerodeObras ?? 0, RequisitosP1.NumeroObras))%"></div>
			</div>
		</div>

		<!-- Investigación -->
		<div class="criterio-card">
			<div class="criterio-header">
				<h3>Investigación (meses)</h3>
				<span class="criterio-valor">@(datosEvaluacion?.HorasdeInvestigacion ?? 0)/@RequisitosP1.MesesInvestigacion</span>
			</div>
			<div class="progress-bar">
				<div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.HorasdeInvestigacion ?? 0, RequisitosP1.MesesInvestigacion))%"></div>
			</div>
		</div>

		<!-- Promedio de Evaluación -->
		<div class="criterio-card">
			<div class="criterio-header">
				<h3>Promedio Evaluación</h3>
				<span class="criterio-valor">
					@(datosEvaluacion != null ? datosEvaluacion.PromediodeEvaluacion.ToString("0") : "0")
					<div class="progress-fill" style="width: @(GetPorcentajeDecimal(datosEvaluacion?.PromediodeEvaluacion ?? 0, RequisitosP1.PromedioEvaluacion))%"></div>
				</span>
			</div>
		</div>

		<!-- Cursos de Capacitación -->
		<div class="criterio-card">
			<div class="criterio-header">
				<h3>Cursos Capacitación(horas)</h3>
				<span class="criterio-valor">@(datosEvaluacion?.CursosdeCapacitacion ?? 0)/@RequisitosP1.HorasCapacitacion</span>
			</div>
			<div class="progress-bar">
				<div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.CursosdeCapacitacion ?? 0, RequisitosP1.HorasCapacitacion))%"></div>
			</div>
		</div>

		<!-- Años de Docencia -->
		<div class="criterio-card">
			<div class="criterio-header">
				<h3>Años de Docencia</h3>
				<span class="criterio-valor">@(datosEvaluacion?.AniosdeDocencia ?? 0)/@RequisitosP1.AniosDocencia</span>
			</div>
			<div class="progress-bar">
				<div class="progress-fill" style="width: @(GetPorcentajeDecimal(datosEvaluacion?.AniosdeDocencia ?? 0, RequisitosP1.AniosDocencia))%"></div>
			</div>
		</div>
	</div>

	<!-- Slider de Progreso General -->
	<div class="progreso-container">
		<h3>Progreso hacia @nivelObjetivo</h3>
		<div class="slider-container">
			<input type="range" min="0" max="100" value="@progresoGeneral" class="slider" id="progresoSlider" disabled />
			<div class="slider-labels">
				<span>0%</span>
				<span>50%</span>
				<span>100%</span>
			</div>
			<div class="progreso-texto">
				@if (progresoGeneral >= 100)
				{
					<span class="completo">¡Cumples con todos los requisitos para @nivelObjetivo!</span>
				}
				else
				{
					<span>Te faltan @(100 - progresoGeneral)% para cumplir con los requisitos de @nivelObjetivo</span>
				}
			</div>
		</div>
	</div>
</div>

<style>
