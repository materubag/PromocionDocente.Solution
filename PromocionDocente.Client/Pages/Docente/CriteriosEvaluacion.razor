@page "/docente/criterios"
@layout PromocionDocente.Client.Layout.DocenteLayout
@using PromocionDocente.Client.Models
@using System.Text.Json.Serialization
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<!-- Header siempre visible -->
<div class="header-container">
    <div class="header-content">
        <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
    </div>
</div>

@if (!tienePostulacionRechazada)
{
    <!-- Contenedor de evaluación normal -->
    <div class="evaluacion-container">
        @if (hayRechazosDisponibles)
        {
            <div class="notificacion-rechazos">
                <div class="notificacion-contenido">
                    <div class="notificacion-icono">⚠️</div>
                    <div class="notificacion-texto">Tienes @(solicitudesRechazadas?.TotalRechazados ?? 0) solicitudes rechazadas</div>
                    <button class="btn-ver-rechazos" @onclick="VerRechazos">
                        Ver detalles
                    </button>
                </div>
            </div>
        }

        <div class="criterios-grid">
            <!-- Número de Obras -->
            <div class="criterio-card">
                <div class="criterio-header">
                    <h3>Número de Obras</h3>
                    <span class="criterio-valor">@(datosEvaluacion?.NumerodeObras ?? 0)/@RequisitosP1.NumeroObras</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.NumerodeObras ?? 0, RequisitosP1.NumeroObras))%"></div>
                </div>
            </div>

            <!-- Investigación -->
            <div class="criterio-card">
                <div class="criterio-header">
                    <h3>Investigación (meses)</h3>
                    <span class="criterio-valor">@(datosEvaluacion?.HorasdeInvestigacion ?? 0)/@RequisitosP1.MesesInvestigacion</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.HorasdeInvestigacion ?? 0, RequisitosP1.MesesInvestigacion))%"></div>
                </div>
            </div>

            <!-- Promedio de Evaluación -->
            <div class="criterio-card">
                <div class="criterio-header">
                    <h3>Promedio Evaluación</h3>
                    <span class="criterio-valor">
                        @(datosEvaluacion != null ? datosEvaluacion.PromediodeEvaluacion.ToString("0") : "0")
                        <div class="progress-fill" style="width: @(GetPorcentajeDecimal(datosEvaluacion?.PromediodeEvaluacion ?? 0, RequisitosP1.PromedioEvaluacion))%"></div>
                    </span>
                </div>
            </div>

            <!-- Cursos de Capacitación -->
            <div class="criterio-card">
                <div class="criterio-header">
                    <h3>Cursos Capacitación(horas)</h3>
                    <span class="criterio-valor">@(datosEvaluacion?.CursosdeCapacitacion ?? 0)/@RequisitosP1.HorasCapacitacion</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(GetPorcentaje(datosEvaluacion?.CursosdeCapacitacion ?? 0, RequisitosP1.HorasCapacitacion))%"></div>
                </div>
            </div>

            <!-- Años de Docencia -->
            <div class="criterio-card">
                <div class="criterio-header">
                    <h3>Años de Docencia</h3>
                    <span class="criterio-valor">@(datosEvaluacion?.AniosdeDocencia ?? 0)/@RequisitosP1.AniosDocencia</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(GetPorcentajeDecimal(datosEvaluacion?.AniosdeDocencia ?? 0, RequisitosP1.AniosDocencia))%"></div>
                </div>
            </div>
        </div>

        <!-- Slider de Progreso General -->
        <div class="progreso-container">
            <h3>Progreso hacia @nivelObjetivo</h3>
            <div class="slider-container">
                <input type="range" min="0" max="100" value="@progresoGeneral" class="slider" id="progresoSlider" disabled />
                <div class="slider-labels">
                    <span>0%</span>
                    <span>50%</span>
                    <span>100%</span>
                </div>
                <div class="progreso-texto">
                    @if (progresoGeneral >= 100)
                    {
                        <span class="completo">¡Cumples con todos los requisitos para @nivelObjetivo!</span>
                    }
                    else
                    {
                        <span>Te faltan @(100 - progresoGeneral)% para cumplir con los requisitos de @nivelObjetivo</span>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Contenedor de postulaciones rechazadas -->
    <div class="rechazados-container">
        <div class="rechazados-header">
            <h3>Postulación Rechazada</h3>
            <span class="fecha-rechazado">@solicitudesRechazadas.FechaGeneracion</span>
        </div>
        <div class="rechazados-contenido">
            <div class="rechazados-info">
                <p><strong>Revisado por:</strong> @solicitudesRechazadas.UsuarioGeneracion</p>
                <p><strong>Total de elementos rechazados:</strong> @solicitudesRechazadas.TotalRechazados</p>
            </div>

            @if (solicitudesRechazadas.ObrasRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Obras Rechazadas (@solicitudesRechazadas.ObrasRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var obra in solicitudesRechazadas.ObrasRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@obra.Titulo</div>
                                <div class="item-rechazado-detalle">
                                    <span>Tipo: @obra.TipoObra</span>
                                    <span>Fecha: @obra.FechaPublicacion.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@obra.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.InvestigacionesRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Investigaciones Rechazadas (@solicitudesRechazadas.InvestigacionesRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var inv in solicitudesRechazadas.InvestigacionesRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@inv.TituloInvestigacion</div>
                                <div class="item-rechazado-detalle">
                                    <span>Periodo: @inv.FechaInicio.ToString("dd/MM/yyyy") - @inv.FechaFin.ToString("dd/MM/yyyy")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@inv.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.CursosRechazados.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Cursos Rechazados (@solicitudesRechazadas.CursosRechazados.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var curso in solicitudesRechazadas.CursosRechazados)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@curso.NombreCurso</div>
                                <div class="item-rechazado-detalle">
                                    <span>Fecha: @curso.FechaCurso.ToString("dd/MM/yyyy")</span>
                                    <span>Horas: @curso.Horas</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@curso.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (solicitudesRechazadas.EvaluacionesRechazadas.Any())
            {
                <div class="seccion-rechazados">
                    <h4>Evaluaciones Rechazadas (@solicitudesRechazadas.EvaluacionesRechazadas.Count)</h4>
                    <ul class="lista-rechazados">
                        @foreach (var eval in solicitudesRechazadas.EvaluacionesRechazadas)
                        {
                            <li class="item-rechazado">
                                <div class="item-rechazado-titulo">@eval.TipoEvaluacion</div>
                                <div class="item-rechazado-detalle">
                                    <span>Periodo: @eval.PeriodoEvaluado</span>
                                    <span>Resultado: @eval.Resultado.ToString("F2")</span>
                                </div>
                                <div class="observacion-container">
                                    <div class="observacion-titulo">Observación:</div>
                                    <div class="observacion-texto">@eval.Observacion</div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="boton-regresar">
                <button class="btn-regresar" @onclick="VerCriterios">
                    Regresar a Criterios
                </button>
            </div>
        </div>
    </div>
}

