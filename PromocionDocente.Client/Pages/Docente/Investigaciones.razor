@code {
    private DocenteInfo docenteInfo;
    private List<InvestigacionInfo> investigaciones = new List<InvestigacionInfo>();
    private List<InvestigacionInfo> investigacionesFiltradas = new List<InvestigacionInfo>();
    private string filtroTexto = "";
    private int paginaActual = 1;
    private int elementosPorPagina = 10;
    private int totalElementos = 0;
    private int totalPaginas = 0;
    private bool isImporting = false;
    private string mensajeError = string.Empty;

    protected override void OnInitialized()
    {
        // Inicializar datos del docente
        docenteInfo = new DocenteInfo
        {
            Nombre = "Ing. Ismael Cuadrado",
            Cargo = "Profesor Auxiliar - Ing. Sistemas",
        };

        CargarInvestigaciones();
    }

    private async Task CargarInvestigaciones()
    {
        mensajeError = string.Empty;
        try
        {
            // Llamada a la API para obtener las obras filtradas por cédula
            investigaciones = await Http.GetFromJsonAsync<List<InvestigacionInfo>>($"/api/Investigaciones/cedula/0998877665");
            
        }
        catch (Exception ex)
        {
            mensajeError = "Error al obtener obras: " + ex.Message;
        }
       

        FiltrarInvestigaciones();
    }

    private void FiltrarInvestigaciones()
    {
        investigacionesFiltradas = investigaciones.Where(i =>
            string.IsNullOrEmpty(filtroTexto) ||
            i.TituloInvestigacion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            i.TipoInvestigacion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            i.CampoAplicacion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            i.Estado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
        ).ToList();

        totalElementos = investigacionesFiltradas.Count;
        totalPaginas = (int)Math.Ceiling((double)totalElementos / elementosPorPagina);

        // Aplicar paginación
        investigacionesFiltradas = investigacionesFiltradas
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina)
            .ToList();

        StateHasChanged();
    }

    private string GetClaseDuracion(int duracionMeses)
    {
        if (duracionMeses <= 6) return "duracion-corta";
        if (duracionMeses <= 12) return "duracion-media";
        if (duracionMeses <= 18) return "duracion-larga";
        return "duracion-extensa";
    }

    private string GetClaseEstado(string estado)
    {
        return estado.ToLower().Replace(" ", "-") switch
        {
            "en-curso" => "estado-en-curso",
            "completada" => "estado-completada",
            "planificada" => "estado-planificada",
            "suspendida" => "estado-suspendida",
            "borrador" => "estado-borrador",
            _ => "estado-borrador"
        };
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var investigacion in investigacionesFiltradas)
        {
            investigacion.Seleccionada = seleccionar;
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            FiltrarInvestigaciones();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            FiltrarInvestigaciones();
        }
    }

    // Métodos de acción
    private async Task AgregarInvestigacion()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función: Agregar Nueva Investigación\n\n• Se abrirá el formulario para crear una nueva investigación\n• Complete todos los campos requeridos\n• Guarde los cambios para continuar");
    }

    private async Task ImportarInvestigaciones()
    {
        if (isImporting) return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
            "¿Desea importar investigaciones desde un archivo?\n\n" +
            "• Formatos soportados: Excel (.xlsx), CSV (.csv)\n" +
            "• El archivo debe contener las columnas requeridas\n" +
            "• Las investigaciones duplicadas serán omitidas\n\n" +
            "¿Continuar con la importación?");

        if (confirmar)
        {
            isImporting = true;
            StateHasChanged();

            await Task.Delay(3000);

            isImporting = false;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("alert",
                "¡Importación completada exitosamente!\n\n" +
                "• 3 investigaciones nuevas importadas\n" +
                "• 1 investigación duplicada omitida\n" +
                "• Los datos han sido validados y guardados");
        }
    }

    private async Task EditarSeleccionada()
    {
        var seleccionada = investigacionesFiltradas.FirstOrDefault(i => i.Seleccionada);
        if (seleccionada != null)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"Editar Investigación Seleccionada\n\n" +
                $"• Título: {seleccionada.TituloInvestigacion.Substring(0, Math.Min(50, seleccionada.TituloInvestigacion.Length))}...\n" +
                $"• Tipo: {seleccionada.TipoInvestigacion}\n" +
                $"• Estado: {seleccionada.Estado}\n\n" +
                $"Se abrirá el formulario de edición...");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Atención\n\n" +
                "No hay ninguna investigación seleccionada.\n" +
                "Por favor, seleccione una investigación de la lista para editarla.");
        }
    }

    private async Task EnviarSeleccionada()
    {
        var seleccionadas = investigacionesFiltradas.Where(i => i.Seleccionada).ToList();

        if (seleccionadas.Any())
        {
            bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
                $"¿Enviar {seleccionadas.Count} investigación(es) seleccionada(s)?\n\n" +
                $"• Las investigaciones serán enviadas para revisión\n" +
                $"• No podrán ser editadas después del envío\n" +
                $"• Recibirá una confirmación por email\n\n" +
                $"¿Continuar con el envío?");

            if (confirmar)
            {
                await JSRuntime.InvokeVoidAsync("alert",
                    $"✅ Envío exitoso\n\n" +
                    $"• {seleccionadas.Count} investigación(es) enviada(s)\n" +
                    $"• Estado cambiado a 'En Revisión'\n" +
                    $"• Confirmación enviada por email");

                foreach (var inv in seleccionadas)
                {
                    inv.Estado = "En Revisión";
                    inv.Seleccionada = false;
                }
                StateHasChanged();
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Atención\n\n" +
                "No hay investigaciones seleccionadas.\n" +
                "Seleccione al menos una investigación para enviar.");
        }
    }

    private async Task DescargarPDF(InvestigacionInfo investigacion)
    {
        if (investigacion.TieneArchivoPDF)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"📄 Descargando Documento PDF\n\n" +
                $"• Investigación: {investigacion.TituloInvestigacion.Substring(0, Math.Min(50, investigacion.TituloInvestigacion.Length))}...\n" +
                $"• Tipo: {investigacion.TipoInvestigacion}\n" +
                $"• Campo: {investigacion.CampoAplicacion}\n\n" +
                $"La descarga comenzará en breve...");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Documento no disponible\n\n" +
                "Esta investigación aún no tiene un documento PDF.\n" +
                "Complete la investigación para generar el documento.");
        }
    }

    public class InvestigacionInfo
    {
        public int IdInvestigacion { get; set; }
        public string TituloInvestigacion { get; set; } = "";
        public int DuracionMeses { get; set; }
        public DateTime FechaInicio { get; set; }
        public DateTime FechaFin { get; set; }
        public string TipoInvestigacion { get; set; } = "";
        public string CampoAplicacion { get; set; } = "";
        public string Estado { get; set; } = "";
        public bool Seleccionada { get; set; }
        public bool TieneArchivoPDF { get; set; }
    }

    public class DocenteInfo
    {
        public string Nombre { get; set; } = "";
        public string Cargo { get; set; } = "";
    }
}
