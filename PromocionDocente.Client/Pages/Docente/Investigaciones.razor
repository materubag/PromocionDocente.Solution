@page "/docente/investigaciones"
@layout DocenteLayout
@using Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div class="investigaciones-container">

    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Gestión de Investigaciones</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">@docenteInfo.Nombre</div>
                    <div class="cargo">@docenteInfo.Cargo</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="contenido-principal">
        <div class="tabla-container">
            <!-- Barra de herramientas -->
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar investigación..." @bind="filtroTexto" @oninput="FiltrarInvestigaciones" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-primary" @onclick="AgregarInvestigacion">
                        <span class="btn-icon">➕</span>
                        Agregar
                    </button>
                    <button class="btn btn-secondary" @onclick="ImportarInvestigaciones" disabled="@isImporting">
                        <span class="btn-icon">📁</span>
                        @(isImporting ? "Importando..." : "Importar")
                    </button>
                    <button class="btn btn-secondary" @onclick="EditarSeleccionada">
                        <span class="btn-icon">✏️</span>
                        Editar
                    </button>
                    <button class="btn btn-secondary" @onclick="EnviarSeleccionada">
                        <span class="btn-icon">📤</span>
                        Enviar
                    </button>
                </div>
            </div>

            <!-- Tabla de investigaciones -->
            <div class="tabla-investigaciones">
                <table class="investigaciones-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodas" />
                            </th>
                            <th class="col-titulo">Título</th>
                            <th class="col-tipo">Tipo</th>
                            <th class="col-campo">Campo de Aplicación</th>
                            <th class="col-duracion">Duración</th>
                            <th class="col-fechas">Fechas</th>
                            <th class="col-documento">Documento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (investigacionesFiltradas != null && investigacionesFiltradas.Any())
                        {
                            @foreach (var investigacion in investigacionesFiltradas)
                            {
                                <tr class="@(investigacion.Seleccionada ? "selected" : "")">
                                    <td>
                                        <input type="checkbox" @bind="investigacion.Seleccionada" />
                                    </td>
                                    <td class="titulo-cell">
                                        <div class="titulo-investigacion" title="@investigacion.TituloInvestigacion">
                                            @(investigacion.TituloInvestigacion.Length > 50 ?
                                                                                investigacion.TituloInvestigacion.Substring(0, 50) + "..." :
                                                                                investigacion.TituloInvestigacion)
                                </div>
                            </td>
                            <td>@investigacion.TipoInvestigacion</td>
                            <td>@investigacion.CampoAplicacion</td>
                            <td class="duracion">
                                <span class="badge-duracion @GetClaseDuracion(investigacion.DuracionMeses)">
                                    @investigacion.DuracionMeses meses
                                </span>
                            </td>
                            <td class="fechas">
                                <div class="fecha-inicio">Inicio: @investigacion.FechaInicio.ToString("dd/MM/yyyy")</div>
                                <div class="fecha-fin">Fin: @investigacion.FechaFin.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="documento">
                                @if (investigacion.TieneArchivoPDF)
                                        {
                                            <button class="btn-documento" @onclick="() => DescargarPDF(investigacion)" title="Descargar PDF">
                                                <span class="documento-icon">📄</span>
                                                <span class="documento-text">PDF</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="no-data">No se encontraron investigaciones</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @((paginaActual - 1) * elementosPorPagina + 1) - @(Math.Min(paginaActual * elementosPorPagina, totalElementos)) de @totalElementos investigaciones
                </div>
                <div class="pagination-controls">
                    <button class="btn-page" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">◀</button>
                    <span class="page-info">Página @paginaActual de @totalPaginas</span>
                    <button class="btn-page" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">▶</button>
                </div>
            </div>
        </div>
    </div>
</div>

