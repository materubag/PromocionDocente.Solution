@code {
    private DocenteInfo docenteInfo;
    private List<EvaluacionInfo> evaluaciones = new List<EvaluacionInfo>();
    private List<EvaluacionInfo> evaluacionesFiltradas = new List<EvaluacionInfo>();
    private string filtroTexto = "";
    private int paginaActual = 1;
    private int elementosPorPagina = 10;
    private int totalElementos = 0;
    private int totalPaginas = 0;
    private bool isImporting = false;

    protected override void OnInitialized()
    {
        // Inicializar datos del docente
        docenteInfo = new DocenteInfo
        {
            Nombre = "Ing. Ismael Cuadrado",
            Cargo = "Profesor Auxiliar - Ing. Sistemas",
        };

        CargarEvaluaciones();
    }

    private void CargarEvaluaciones()
    {
        //reemplazar con llamada real a API
        evaluaciones = new List<EvaluacionInfo>
        {
            new EvaluacionInfo {
                Id = 1,
                PeriodoEvaluado = "2024-01",
                TipoEvaluacion = "Evaluación Docente",
                FechaEvaluacion = new DateTime(2024, 2, 15),
                Resultado = 4.5m,
                Estado = "Completado",
                DocumentoPDF = "evaluacion_2024_01.pdf"
            },
            new EvaluacionInfo {
                Id = 2,
                PeriodoEvaluado = "2023-02",
                TipoEvaluacion = "Autoevaluación",
                FechaEvaluacion = new DateTime(2023, 8, 20),
                Resultado = 4.2m,
                Estado = "Completado",
                DocumentoPDF = "autoevaluacion_2023_02.pdf"
            },
            new EvaluacionInfo {
                Id = 3,
                PeriodoEvaluado = "2023-01",
                TipoEvaluacion = "Evaluación por Pares",
                FechaEvaluacion = new DateTime(2023, 3, 10),
                Resultado = 3.8m,
                Estado = "Completado",
                DocumentoPDF = "evaluacion_pares_2023_01.pdf"
            },
            new EvaluacionInfo {
                Id = 4,
                PeriodoEvaluado = "2024-02",
                TipoEvaluacion = "Evaluación Docente",
                FechaEvaluacion = new DateTime(2024, 9, 5),
                Resultado = 4.7m,
                Estado = "Pendiente",
                DocumentoPDF = ""
            },
            new EvaluacionInfo {
                Id = 5,
                PeriodoEvaluado = "2024-03",
                TipoEvaluacion = "Autoevaluación",
                FechaEvaluacion = new DateTime(2024, 12, 1),
                Resultado = 0m,
                Estado = "Borrador",
                DocumentoPDF = ""
            }
        };

        FiltrarEvaluaciones();
    }

    private void FiltrarEvaluaciones()
    {
        evaluacionesFiltradas = evaluaciones.Where(e =>
            string.IsNullOrEmpty(filtroTexto) ||
            e.PeriodoEvaluado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            e.TipoEvaluacion.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
            e.Estado.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
        ).ToList();

        totalElementos = evaluacionesFiltradas.Count;
        totalPaginas = (int)Math.Ceiling((double)totalElementos / elementosPorPagina);

        // Aplicar paginación
        evaluacionesFiltradas = evaluacionesFiltradas
            .Skip((paginaActual - 1) * elementosPorPagina)
            .Take(elementosPorPagina)
            .ToList();

        StateHasChanged();
    }

    private string GetClaseResultado(decimal resultado)
    {
        if (resultado >= 4.5m) return "resultado-excelente";
        if (resultado >= 4.0m) return "resultado-bueno";
        if (resultado >= 3.0m) return "resultado-regular";
        return "resultado-malo";
    }

    private string GetClaseEstado(string estado)
    {
        return estado.ToLower() switch
        {
            "completado" => "estado-completado",
            "pendiente" => "estado-pendiente",
            "borrador" => "estado-borrador",
            _ => "estado-borrador"
        };
    }

    private void SeleccionarTodas(ChangeEventArgs e)
    {
        bool seleccionar = (bool)e.Value;
        foreach (var evaluacion in evaluacionesFiltradas)
        {
            evaluacion.Seleccionada = seleccionar;
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            FiltrarEvaluaciones();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            FiltrarEvaluaciones();
        }
    }

 
    private async Task AgregarEvaluacion()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Función: Agregar Nueva Evaluación\n\n• Se abrirá el formulario para crear una nueva evaluación\n• Complete todos los campos requeridos\n• Guarde los cambios para continuar");
        // Lógica para agregar nueva evaluación
    }

    private async Task ImportarEvaluaciones()
    {
        if (isImporting) return;

        bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
            "¿Desea importar evaluaciones desde un archivo?\n\n" +
            "• Formatos soportados: Excel (.xlsx), CSV (.csv)\n" +
            "• El archivo debe contener las columnas requeridas\n" +
            "• Las evaluaciones duplicadas serán omitidas\n\n" +
            "¿Continuar con la importación?");

        if (confirmar)
        {
            isImporting = true;
            StateHasChanged();

            // Simular proceso de importación
            await Task.Delay(3000);

            isImporting = false;
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("alert",
                "¡Importación completada exitosamente!\n\n" +
                "• 5 evaluaciones nuevas importadas\n" +
                "• 2 evaluaciones duplicadas omitidas\n" +
                "• Los datos han sido validados y guardados");
        }
    }

    private async Task EditarSeleccionada()
    {
        var seleccionada = evaluacionesFiltradas.FirstOrDefault(e => e.Seleccionada);
        if (seleccionada != null)
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"Editar Evaluación Seleccionada\n\n" +
                $"• Periodo: {seleccionada.PeriodoEvaluado}\n" +
                $"• Tipo: {seleccionada.TipoEvaluacion}\n" +
                $"• Estado: {seleccionada.Estado}\n\n" +
                $"Se abrirá el formulario de edición...");

            EditarEvaluacion(seleccionada);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Atención\n\n" +
                "No hay ninguna evaluación seleccionada.\n" +
                "Por favor, seleccione una evaluación de la lista para editarla.");
        }
    }

    private async Task EnviarSeleccionada()
    {
        var seleccionadas = evaluacionesFiltradas.Where(e => e.Seleccionada).ToList();

        if (seleccionadas.Any())
        {
            bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
                $"¿Enviar {seleccionadas.Count} evaluación(es) seleccionada(s)?\n\n" +
                $"• Las evaluaciones serán enviadas para revisión\n" +
                $"• No podrán ser editadas después del envío\n" +
                $"• Recibirá una confirmación por email\n\n" +
                $"¿Continuar con el envío?");

            if (confirmar)
            {
                await JSRuntime.InvokeVoidAsync("alert",
                    $"✅ Envío exitoso\n\n" +
                    $"• {seleccionadas.Count} evaluación(es) enviada(s)\n" +
                    $"• Estado cambiado a 'En Revisión'\n" +
                    $"• Confirmación enviada por email");

                // Actualizar estado de las evaluaciones seleccionadas
                foreach (var eval in seleccionadas)
                {
                    eval.Estado = "En Revisión";
                    eval.Seleccionada = false;
                }
                StateHasChanged();
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Atención\n\n" +
                "No hay evaluaciones seleccionadas.\n" +
                "Seleccione al menos una evaluación para enviar.");
        }
    }

    private async Task EditarEvaluacion(EvaluacionInfo evaluacion)
    {
        await JSRuntime.InvokeVoidAsync("alert",
            $"Editando Evaluación\n\n" +
            $"• ID: {evaluacion.Id}\n" +
            $"• Periodo: {evaluacion.PeriodoEvaluado}\n" +
            $"• Tipo: {evaluacion.TipoEvaluacion}\n" +
            $"• Estado: {evaluacion.Estado}\n\n" +
            $"Redirigiendo al formulario de edición...");
        // Lógica para editar evaluación
    }

    private async Task DescargarPDF(EvaluacionInfo evaluacion)
    {
        if (!string.IsNullOrEmpty(evaluacion.DocumentoPDF))
        {
            await JSRuntime.InvokeVoidAsync("alert",
                $"📄 Descargando Documento PDF\n\n" +
                $"• Archivo: {evaluacion.DocumentoPDF}\n" +
                $"• Evaluación: {evaluacion.TipoEvaluacion}\n" +
                $"• Periodo: {evaluacion.PeriodoEvaluado}\n\n" +
                $"La descarga comenzará en breve...");

            // Aquí iría la lógica real de descarga
            // Por ejemplo: await JSRuntime.InvokeVoidAsync("downloadFile", evaluacion.DocumentoPDF);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert",
                "⚠️ Documento no disponible\n\n" +
                "Esta evaluación aún no tiene un documento PDF generado.\n" +
                "Complete la evaluación para generar el documento.");
        }
    }

    public class EvaluacionInfo
    {
        public int Id { get; set; }
        public string PeriodoEvaluado { get; set; }
        public string TipoEvaluacion { get; set; }
        public DateTime FechaEvaluacion { get; set; }
        public decimal Resultado { get; set; }
        public string Estado { get; set; }
        public bool Seleccionada { get; set; }
        public string DocumentoPDF { get; set; } = "";
    }

    public class DocenteInfo
    {
        public string Nombre { get; set; } = "";
        public string Cargo { get; set; } = "";
    }
}