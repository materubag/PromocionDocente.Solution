@page "/docente/evaluaciones"
@using static PromocionDocente.Client.Pages.Docente.CursosCapacitaciones
@layout DocenteLayout
@using static System.Net.WebRequestMethods
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<div class="evaluaciones-container">

	<div class="header-container">
		<div class="header-content">
			<h1 class="titulo-principal">Sistema de Ascenso Docente</h1>

		</div>
	</div>

	<!-- Contenido Principal -->
	<div class="contenido-principal">
		<div class="tabla-container">
			<!-- Barra de herramientas -->
			<div class="toolbar">
				<div class="search-container">
					<input type="text" class="search-input" placeholder="Buscar..." @bind="filtroTexto" @oninput="FiltrarEvaluaciones" />
					<span class="search-icon">🔍</span>
				</div>
				<div class="action-buttons">
					<button class="btn btn-primary" @onclick="AgregarEvaluacion">
						<span class="btn-icon">➕</span>
						Agregar
					</button>
					<button class="btn btn-secondary" @onclick="ImportarEvaluaciones" disabled="@isImporting">
						<span class="btn-icon">📁</span>
						@(isImporting ? "Importando..." : "Importar")
					</button>
					
					<button class="btn btn-secondary" @onclick="EnviarSeleccionada">
						<span class="btn-icon">📤</span>
						Enviar
					</button>
				</div>
			</div>

			<!-- Tabla-->
			<div class="tabla-evaluaciones">
				<table class="evaluaciones-table">
					<thead>
						<tr>
							<th class="col-checkbox">
								<input type="checkbox" @onchange="SeleccionarTodas" />
							</th>
							<th class="col-periodo">Periodo</th>
							<th class="col-tipo">Tipo Evaluación</th>
							<th class="col-fecha">Fecha</th>
							<th class="col-resultado">Resultado</th>
							<th class="col-documento">Documento</th>
							<th class="col-documento">Editar</th>
						</tr>
					</thead>
					<tbody>
						@if (evaluacionesFiltradas != null && evaluacionesFiltradas.Any())
						{
							@foreach (var evaluacion in evaluacionesFiltradas)
							{
								<tr class="@(evaluacion.Seleccionada ? "selected" : "")">
									<td>
										<input type="checkbox" @bind="evaluacion.Seleccionada" />
									</td>
									<td>@evaluacion.PeriodoEvaluacion</td>
									<td>@evaluacion.TipoEvaluacion</td>
									<td>@evaluacion.FechaEvaluacion.ToString("dd/MM/yyyy")</td>
									<td class="resultado">
										<span class="badge-resultado @GetClaseResultado(evaluacion.Calificacion)">
											@evaluacion.Calificacion.ToString("0.00")
										</span>
									</td>
									<td class="documento">
										@if (!string.IsNullOrEmpty(evaluacion.PdfEvaluacion))
										{
											<button class="btn-documento" @onclick="() => VerPDF(evaluacion)" title="Ver PDF">
												<span class="documento-icon">📄</span>
												<span class="documento-text">PDF</span>
											</button>
										}
										else
										{
											<span class="no-documento">Sin documento</span>
										}
									</td>
									<td>
										<button @onclick="() => EditarEvaluacion(evaluacion.IdEvaluacion)">
											<span class="btn-icon">✏️</span>
											Editar
										</button>

									</td>
									<td>
										<button class="btn btn-secondary" @onclick="() => EditarEvaluacion(evaluacion.IdEvaluacion)">
											<span class="btn-icon">✏️</span>
											Editar
										</button>

									</td>
								</tr>
							}
						}
						else
						{
							<tr>
								<td colspan="7" class="no-data">No se encontraron evaluaciones</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<!-- Paginación -->
			<div class="pagination-container">
				<div class="pagination-info">
					Mostrando @((paginaActual - 1) * elementosPorPagina + 1) - @(Math.Min(paginaActual * elementosPorPagina, totalElementos)) de @totalElementos evaluaciones
				</div>
				<div class="pagination-controls">
					<button class="btn-page" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">◀</button>
					<span class="page-info">Página @paginaActual de @totalPaginas</span>
					<button class="btn-page" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">▶</button>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
