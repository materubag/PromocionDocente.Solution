        align-items: center;
        justify-content: center;
    }

        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .info-text {
        color: white;
    }

    .nombre {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .cargo {
        font-size: 0.8rem;
