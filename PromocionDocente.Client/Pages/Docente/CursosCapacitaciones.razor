@code {
	private DocenteInfo docenteInfo;
	private List<CursoCapacitacionInfo> cursos = new List<CursoCapacitacionInfo>();
	private List<CursoCapacitacionInfo> cursosFiltrados = new List<CursoCapacitacionInfo>();
	private string filtroTexto = "";
	private int paginaActual = 1;
	private int elementosPorPagina = 10;
	private int totalElementos = 0;
	private int totalPaginas = 0;
	private bool isImporting = false;
	private int progresoActual = 75;
	private int totalHorasCompletadas = 0;
	private int cursosCompletados = 0;
	private string mensajeError = string.Empty;
	private string? cedulaUsuario;

	protected override async Task OnInitializedAsync()
	{
		// Inicializar datos del docente
		docenteInfo = new DocenteInfo
			{
				Nombre = "Ing. Ismael Cuadrado",
				Cargo = "Profesor Auxiliar - Ing. Sistemas",
			};

		await CargarCursos();
	}

	private async Task CargarCursos()
	{
		mensajeError = string.Empty;

		try
		{
			// Leer el JSON desde localStorage
			var usuarioJson = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "usuario");

			if (!string.IsNullOrEmpty(usuarioJson))
			{
				// Deserializar a objeto para obtener la cedula
				var usuario = System.Text.Json.JsonSerializer.Deserialize<LoginResponse>(usuarioJson);
				cedulaUsuario = usuario?.Cedula;
			}

			if (string.IsNullOrEmpty(cedulaUsuario))
			{
				mensajeError = "No se encontró la cédula del usuario";
				return;
			}

			cursos = await Http.GetFromJsonAsync<List<CursoCapacitacionInfo>>($"/api/CursosCapacitacions/cedula/{cedulaUsuario}");
			CalcularEstadisticas();
		}
		catch (Exception ex)
		{
			mensajeError = "Error al obtener cursos: " + ex.Message;
		}
		finally
		{
			CalcularEstadisticas();
		}

		FiltrarCursos();
	}

	public class LoginResponse
	{
		public string Cedula { get; set; } = string.Empty;
		public string Nombre1 { get; set; } = string.Empty;
		public string Apellido1 { get; set; } = string.Empty;
		public string Rol { get; set; } = string.Empty;
	}

	private void CalcularEstadisticas()
	{
		cursosCompletados = cursos.Count;
		totalHorasCompletadas = cursos.Sum(c => c.Horas);

		int horasMeta = 96;
		progresoActual = totalHorasCompletadas >= horasMeta
			? 100
			: (totalHorasCompletadas * 100) / horasMeta;
	}

	private void FiltrarCursos()
	{
		cursosFiltrados = cursos.Where(c =>
			string.IsNullOrEmpty(filtroTexto) ||
			c.NombreCurso.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase)
		).ToList();

		totalElementos = cursosFiltrados.Count;
		totalPaginas = (int)Math.Ceiling((double)totalElementos / elementosPorPagina);

		// Aplicar paginación
		cursosFiltrados = cursosFiltrados
			.Skip((paginaActual - 1) * elementosPorPagina)
			.Take(elementosPorPagina)
			.ToList();

		StateHasChanged();
	}

	private string GetClaseEstado(string estado)
	{
		return estado.ToLower() switch
		{
			"completado" => "estado-completado",
			"pendiente" => "estado-pendiente",
			"en progreso" => "estado-en-progreso",
			"validado" => "estado-validado",
			_ => "estado-pendiente"
		};
	}

	private void SeleccionarTodos(ChangeEventArgs e)
	{
		bool seleccionar = (bool)e.Value;
		foreach (var curso in cursosFiltrados)
		{
			curso.Seleccionado = seleccionar;
		}
	}

	private void PaginaAnterior()
	{
		if (paginaActual > 1)
		{
			paginaActual--;
			FiltrarCursos();
		}
	}

	private void PaginaSiguiente()
	{
		if (paginaActual < totalPaginas)
		{
			paginaActual++;
			FiltrarCursos();
		}
	}

	// Métodos de acción
	private async Task AgregarCurso()
	{
		await JSRuntime.InvokeVoidAsync("alert", "Función: Agregar Nuevo Curso de Capacitación\n\n• Se abrirá el formulario para registrar un nuevo curso\n• Complete los datos: nombre, fecha, horas y documento PDF\n• Guarde los cambios para continuar");
	}

	private async Task ImportarCursos()
	{
		if (isImporting) return;

		if (string.IsNullOrEmpty(cedulaUsuario))
		{
			await JSRuntime.InvokeVoidAsync("alert", "No se ha cargado la cédula del usuario. No se puede importar.");
			return;
		}

		bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
			"¿Desea importar cursos de capacitación desde la base externa?\n\n" +
			"• Los cursos duplicados serán omitidos\n" +
			"• Solo se importarán los cursos nuevos\n\n" +
			"¿Desea continuar?");

		if (confirmar)
		{
			isImporting = true;
			StateHasChanged();

			try
			{
				var response = await Http.GetFromJsonAsync<ImportacionResultado>(
					$"/api/ImportacionCursos/cedula/{cedulaUsuario}");

				if (response != null)
				{
					await JSRuntime.InvokeVoidAsync("alert",
						$"¡Importación completada exitosamente!\n\n" +
						$"• {response.nuevos} cursos nuevos importados\n" +
						$"• {response.duplicados} cursos duplicados omitidos\n" +
						$"• Total procesados: {response.total}");
				}
				else
				{
					await JSRuntime.InvokeVoidAsync("alert", "No se recibió una respuesta válida del servidor.");
				}
			}
			catch (Exception ex)
			{
				Console.WriteLine(ex.Message);
				await JSRuntime.InvokeVoidAsync("alert", "Error al importar cursos: " + ex.Message);
			}

			isImporting = false;
			StateHasChanged();
			await CargarCursos();
		}
	}



	private async Task EditarSeleccionado()
	{
		var seleccionado = cursosFiltrados.FirstOrDefault(c => c.Seleccionado);
		if (seleccionado != null)
		{
			await JSRuntime.InvokeVoidAsync("alert",
				$"Editar Curso Seleccionado\n\n" +
				$"• Curso: {seleccionado.NombreCurso}\n" +
				$"• Fecha: {seleccionado.FechaCurso:dd/MM/yyyy}\n" +
				$"• Horas: {seleccionado.Horas}\n" +
				$"Se abrirá el formulario de edición...");
		}
		else
		{
			await JSRuntime.InvokeVoidAsync("alert",
				"⚠️ Atención\n\n" +
				"No hay ningún curso seleccionado.\n" +
				"Por favor, seleccione un curso de la lista para editarlo.");
		}
	}

	private async Task EnviarSeleccionado()
	{
		var seleccionados = cursosFiltrados.Where(c => c.Seleccionado).ToList();

		if (seleccionados.Any())
		{
			bool confirmar = await JSRuntime.InvokeAsync<bool>("confirm",
				$"¿Enviar {seleccionados.Count} curso(s) seleccionado(s) para validación?\n\n" +
				$"• Los cursos serán enviados para revisión\n" +
				$"• No podrán ser editados después del envío\n" +
				$"• Recibirá una confirmación por email\n\n" +
				$"¿Continuar con el envío?");

			if (confirmar)
			{
				await JSRuntime.InvokeVoidAsync("alert",
					$"✅ Envío exitoso\n\n" +
					$"• {seleccionados.Count} curso(s) enviado(s)\n" +
					$"• Estado cambiado a 'En Validación'\n" +
					$"• Confirmación enviada por email");

				// Actualizar estado de los cursos seleccionados
				foreach (var curso in seleccionados)
				{
					curso.Seleccionado = false;
				}
				StateHasChanged();
			}
		}
		else
		{
			await JSRuntime.InvokeVoidAsync("alert",
				"⚠️ Atención\n\n" +
				"No hay cursos seleccionados.\n" +
				"Seleccione al menos un curso para enviar.");
		}
	}

	private async Task VerPDF(CursoCapacitacionInfo curso)
	{
		if (!string.IsNullOrEmpty(curso.pdfCurso))
		{
			await JSRuntime.InvokeVoidAsync("window.open", curso.pdfCurso, "_blank");
		}
	}

	// Clases de modelo
	public class CursoCapacitacionInfo
	{
		public int IdCurso { get; set; }
		public string NombreCurso { get; set; } = "";
		public DateTime FechaCurso { get; set; }
		public int Horas { get; set; }
		public bool TienePDF { get; set; }
		public string pdfCurso { get; set; } = "";
		public bool Seleccionado { get; set; }
        public string Estado { get; set; }
	}
	public class ImportacionResultado
	{
		public string mensaje { get; set; }
		public int nuevos { get; set; }
		public int duplicados { get; set; }
		public int total { get; set; }
	}

	public class DocenteInfo
	{
		public string Nombre { get; set; } = "";
		public string Cargo { get; set; } = "";
	}
}