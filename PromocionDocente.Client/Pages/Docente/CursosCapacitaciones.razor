@page "/docente/capacitaciones"
@layout DocenteLayout
@using Models
@inject IJSRuntime JSRuntime

<div class="capacitaciones-container">
    <!-- Header -->
    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">@docenteInfo.Nombre</div>
                    <div class="cargo">@docenteInfo.Cargo</div>
                </div>
            </div>
        </div>
    </div>

    <div class="capacitaciones-content">
        <!-- Sección de Búsqueda y Botones -->
        <div class="search-section">
            <div class="search-container">
                <input type="text"
                       @bind="searchTerm"
                       @bind:event="oninput"
                       placeholder="Buscar capacitaciones..."
                       class="search-input" />
                <span class="search-icon">🔍</span>
            </div>
            <div class="action-buttons">
                <button class="btn btn-primary" @onclick="AgregarCapacitacion">
                    <span class="btn-icon">➕</span>
                    Agregar
                </button>
                <button class="btn btn-secondary" @onclick="ImportarCapacitaciones" disabled="@isImporting">
                    <span class="btn-icon">📁</span>
                    @(isImporting ? "Importando..." : "Importar")
                </button>
                <button class="btn btn-secondary" @onclick="EditarSeleccionados" disabled="@(!tieneSeleccionados)">
                    <span class="btn-icon">✏️</span>
                    Editar
                </button>
                <button class="btn btn-danger" @onclick="EnviarSeleccionados" disabled="@(!tieneSeleccionados)">
                    <span class="btn-icon">📤</span>
                    Enviar
                </button>
            </div>
        </div>

        <!-- Tabla de Capacitaciones -->
        <div class="table-container">
            <div class="table-wrapper">
                <div class="table-left">
                    <table class="capacitaciones-table">
                        <thead>
                            <tr>
                                <th class="checkbox-column">
                                    <input type="checkbox"
                                           @onchange="SeleccionarTodos"
                                           checked="@todoSeleccionado" />
                                </th>
                                <th class="documento-column">Capacitación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var capacitacion in capacitacionesFiltradas)
                            {
                                <tr class="@(capacitacion.Seleccionado ? "selected" : "")">
                                    <td class="checkbox-cell">
                                        <input type="checkbox"
                                               @onchange="@((e) => ToggleSeleccion(capacitacion.Id, (bool)e.Value))"
                                               checked="@capacitacion.Seleccionado" />
                                    </td>
                                    <td class="documento-cell">
                                        <div class="documento-info">
                                            <span class="documento-tipo">@capacitacion.TipoCapacitacion</span>
                                            <span class="documento-nombre">@capacitacion.Nombre</span>
                                            @if (!string.IsNullOrEmpty(capacitacion.Institucion))
                                            {
                                                <span class="documento-detalle">@capacitacion.Institucion</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-right">
                    <table class="detalles-table">
                        <thead>
                            <tr>
                                <th>Instructor</th>
                                <th>Horas</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var capacitacion in capacitacionesFiltradas)
                            {
                                <tr class="@(capacitacion.Seleccionado ? "selected" : "")">
                                    <td>@capacitacion.Instructor</td>
                                    <td class="horas-cell">@capacitacion.Horas</td>
                                    <td class="estado-cell">
                                        <span class="estado-badge @GetEstadoClass(capacitacion.Estado)">
                                            @GetEstadoIcon(capacitacion.Estado)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Barra de Progreso -->
        <div class="progress-section">
            <div class="progress-info">
                <span class="progress-label">Progreso</span>
                <div class="progress-bar-container">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: @(progresoActual)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Fecha Límite -->
        <div class="deadline-section">
            <div class="deadline-alert">
                <span class="deadline-icon">⏰</span>
                <span class="deadline-text">Fecha límite: 15 julio, 2025 (41 días restantes)</span>
            </div>
        </div>
    </div>
</div>

<style>
