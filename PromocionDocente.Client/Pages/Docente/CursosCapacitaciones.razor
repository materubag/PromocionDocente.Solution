@page "/docente/capacitaciones"
@layout DocenteLayout
@using Models
@inject IJSRuntime JSRuntime

<div class="capacitaciones-container">

    <div class="header-container">
        <div class="header-content">
            <h1 class="titulo-principal">Sistema de Ascenso Docente</h1>
            <div class="docente-info">
                <div class="info-text">
                    <div class="nombre">@docenteInfo.Nombre</div>
                    <div class="cargo">@docenteInfo.Cargo</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="contenido-principal">
        <div class="tabla-container">
            <!-- Barra de herramientas -->
            <div class="toolbar">
                <div class="search-container">
                    <input type="text" class="search-input" placeholder="Buscar cursos..." @bind="filtroTexto" @oninput="FiltrarCursos" />
                    <span class="search-icon">🔍</span>
                </div>
                <div class="action-buttons">
                    <button class="btn btn-primary" @onclick="AgregarCurso">
                        <span class="btn-icon">➕</span>
                        Agregar
                    </button>
                    <button class="btn btn-secondary" @onclick="ImportarCursos" disabled="@isImporting">
                        <span class="btn-icon">📁</span>
                        @(isImporting ? "Importando..." : "Importar")
                    </button>
                    <button class="btn btn-secondary" @onclick="EditarSeleccionado">
                        <span class="btn-icon">✏️</span>
                        Editar
                    </button>
                    <button class="btn btn-secondary" @onclick="EnviarSeleccionado">
                        <span class="btn-icon">📤</span>
                        Enviar
                    </button>
                </div>
            </div>

            <!-- Tabla de cursos -->
            <div class="tabla-cursos">
                <table class="cursos-table">
                    <thead>
                        <tr>
                            <th class="col-checkbox">
                                <input type="checkbox" @onchange="SeleccionarTodos" />
                            </th>
                            <th class="col-nombre">Nombre del Curso</th>
                            <th class="col-fecha">Fecha</th>
                            <th class="col-horas">Horas</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-documento">Documento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cursosFiltrados != null && cursosFiltrados.Any())
                        {
                            @foreach (var curso in cursosFiltrados)
                            {
                                <tr class="@(curso.Seleccionado ? "selected" : "")">
                                    <td>
                                        <input type="checkbox" @bind="curso.Seleccionado" />
                                    </td>
                                    <td class="nombre-curso">
                                        <div class="curso-info">
                                            <span class="curso-nombre">@curso.NombreCurso</span>
                                            <span class="curso-tipo">Curso de Capacitación</span>
                                        </div>
                                    </td>
                                    <td>@curso.FechaCurso.ToString("dd/MM/yyyy")</td>
                                    <td class="horas">
                                        <span class="badge-horas">
                                            @curso.Horas h
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge-estado @GetClaseEstado(curso.Estado)">
                                            @curso.Estado
                                        </span>
                                    </td>
                                    <td class="documento">
                                        @if (curso.TienePDF)
                                        {
                                            <button class="btn-documento" @onclick="() => DescargarPDF(curso)" title="Descargar PDF">
                                                <span class="documento-icon">📄</span>
                                                <span class="documento-text">PDF</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="no-documento">Sin documento</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="no-data">No se encontraron cursos de capacitación</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="pagination-container">
                <div class="pagination-info">
                    Mostrando @((paginaActual - 1) * elementosPorPagina + 1) - @(Math.Min(paginaActual * elementosPorPagina, totalElementos)) de @totalElementos cursos
                </div>
                <div class="pagination-controls">
                    <button class="btn-page" @onclick="PaginaAnterior" disabled="@(paginaActual <= 1)">◀</button>
                    <span class="page-info">Página @paginaActual de @totalPaginas</span>
                    <button class="btn-page" @onclick="PaginaSiguiente" disabled="@(paginaActual >= totalPaginas)">▶</button>
                </div>
            </div>
        </div>

        <!-- Sección de Progreso -->
        <div class="progreso-section">
            <div class="progreso-card">
                <div class="progreso-header">
                    <h3>Progreso de Capacitación</h3>
                    <span class="progreso-porcentaje">@progresoActual%</span>
                </div>
                <div class="progreso-bar">
                    <div class="progreso-fill" style="width: @(progresoActual)%"></div>
                </div>
                <div class="progreso-stats">
                    <div class="stat-item">
                        <span class="stat-numero">@totalHorasCompletadas</span>
                        <span class="stat-label">Horas completadas</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-numero">@cursosCompletados</span>
                        <span class="stat-label">Cursos completados</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

