@page "/administrador"
@using Microsoft.AspNetCore.Components.Forms
@using System.Web
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="container-fluid">
    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="alert alert-danger">@errorMensaje</div>
    }
    else if (cargando)
    {
        <div class="text-center p-4">
            <div class="row align-items-center mb-4 border-bottom pb-3">
                <div class="col-auto">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando información del docente...</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <button class="btn btn-link text-muted p-0" @onclick="Volver">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </button>
        <div class="col">
            <h2 class="mb-1">Evaluación de Promoción Docente</h2>
            <p class="text-muted mb-0">@infoDocente.NombreCompleto - @infoDocente.Codigo</p>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-user me-2"></i>Información General
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted">Cargo Actual</label>
                            <p class="mb-0">@infoDocente.CargoActual</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">Fecha de Solicitud</label>
                            <p class="mb-0">@infoDocente.FechaSolicitud.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">Estado</label>
                            <p class="mb-0">
                                <span class="badge @GetClaseBadgeEstadoSolicitud(infoDocente.Estado)">
                                    @infoDocente.Estado
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label text-muted">Cargo Solicitado</label>
                            <p class="mb-0">@infoDocente.CargoSolicitado</p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">Tiempo en Proceso</label>
                            <p class="mb-0">@infoDocente.TiempoEnProceso</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Criterios de Evaluación -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-tasks me-2"></i>Criterios de evaluación
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Criterio</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var criterio in Criterios)
                            {
                                <tr>
                                    <td>@criterio.Id</td>
                                    <td>@criterio.Nombre</td>
                                    <td>
                                        <span class="badge @GetClaseBadgeEstado(criterio.Estado)">
                                            @criterio.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <button class="btn @GetClaseBotonCriterio(criterio.Estado) btn-sm"
                                                @onclick="() => IrAEvaluacion(criterio.Id, criterio.Nombre)">
                                            @GetTextoBotonCriterio(criterio.Estado)
                                        </button>
                                        @if (criterio.Estado == "Pendiente")
                                        {
                                            <button class="btn btn-success btn-sm ms-2" @onclick="() => MarcarComoEvaluado(criterio)">
                                                ✓ Marcar Evaluado
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Información de debug debajo de la tabla -->
                <div class="mt-3 p-3 bg-light rounded">
                    <small class="text-muted">
                        <strong>Estado de evaluación:</strong><br>
                        Criterios evaluados: @Criterios.Count(c => c.Estado == "Aprobado" || c.Estado == "Rechazado") de @Criterios.Count<br>
                        Todos evaluados: @(TodosEvaluados() ? "Sí" : "No")
                    </small>
                </div>
            </div>
        </div>

        <!-- Sección de decisión final SIEMPRE visible -->
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Tomar Decisión Final</h5>
                @if (!TodosEvaluados())
                {
                    <small class="text-warning">⚠ Primero debe evaluar todos los criterios</small>
                }
            </div>
            <div class="card-body">
                <EditForm Model="@decision" OnValidSubmit="@GuardarDecision">
                    <div class="mb-4">
                        <label class="form-label">Decisión</label>
                        <div class="decision-container">
                            <!-- Opción Aprobar -->
                            <div class="decision-option @(decision.DecisionSeleccionada == "Aprobar" ? "selected" : "")">
                                <input type="radio"
                                       name="decision-final"
                                       id="aprobar-final"
                                       value="Aprobar"
                                       @onchange="@((args) => CambiarDecisionFinal(args))"
                                       checked="@(decision.DecisionSeleccionada == "Aprobar")" />
                                <label class="decision-label" for="aprobar-final">
                                    <div class="decision-content">
                                        <i class="fas fa-check-circle text-success me-3"></i>
                                        <div class="decision-text">
                                            <h6 class="mb-1">Aprobar Promoción</h6>
                                            <small class="text-muted">El docente cumple con todos los requisitos</small>
                                        </div>
                                    </div>
                                </label>
                            </div>

                            <!-- Opción Rechazar -->
                            <div class="decision-option @(decision.DecisionSeleccionada == "Rechazar" ? "selected" : "")">
                                <input type="radio"
                                       name="decision-final"
                                       id="rechazar-final"
                                       value="Rechazar"
                                       @onchange="@((args) => CambiarDecisionFinal(args))"
                                       checked="@(decision.DecisionSeleccionada == "Rechazar")" />
                                <label class="decision-label" for="rechazar-final">
                                    <div class="decision-content">
                                        <i class="fas fa-times-circle text-danger me-3"></i>
                                        <div class="decision-text">
                                            <h6 class="mb-1">Rechazar Promoción</h6>
                                            <small class="text-muted">El docente no cumple con los requisitos</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="observaciones" class="form-label">Observaciones</label>
                        <InputTextArea @bind-Value="decision.Observaciones"
                                       class="form-control"
                                       id="observaciones"
                                       rows="6"
                                       placeholder="Ingrese sus observaciones sobre la evaluación..." />
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="loading-dots me-2">●●●</span>
                                <text>Guardando...</text>
                            }
                            else
                            {
                                <text>Guardar Decisión</text>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private DecisionModel decision = new();
    private bool isLoading = false;
    private bool cargando = true;
    private string cedulaDocente = "";
    private string errorMensaje = null;

    private DocenteInfoModel infoDocente = new DocenteInfoModel();

    private List<CriterioModel> Criterios = new()
    {
        new CriterioModel { Id = 1, Nombre = "Investigación", Estado = "Pendiente" },
        new CriterioModel { Id = 2, Nombre = "Evaluación", Estado = "Pendiente" },
        new CriterioModel { Id = 3, Nombre = "Cursos/Capacitaciones", Estado = "Pendiente" },
        new CriterioModel { Id = 4, Nombre = "Obras/Papers", Estado = "Pendiente" }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;
            errorMensaje = null;
            StateHasChanged();

            var uri = new Uri(Navigation.Uri);
            var query = HttpUtility.ParseQueryString(uri.Query);

            var codigoDocente = query["codigo"];
            if (!string.IsNullOrEmpty(codigoDocente))
            {
                await CargarDatosPorCodigo(codigoDocente);
                cedulaDocente = codigoDocente;
            }
            else
            {
                infoDocente = new DocenteInfoModel
                {
                    NombreCompleto = "Docente de Ejemplo",
                    Codigo = "0000000000",
                    CargoActual = "Docente Titular 1",
                    CargoSolicitado = "Docente Titular 2",
                    FechaSolicitud = new DateTime(2025, 6, 26),
                    TiempoEnProceso = "0 días"
                };
                cedulaDocente = "0000000000";
            }

            // Ya no se carga desde API ni localStorage
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error en inicialización: {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarDatosPorCodigo(string codigo)
    {
        try
        {
            var response = await Http.GetAsync("api/Postulaciones/dashboard");
            if (response.IsSuccessStatusCode)
            {
                var dashboardData = await response.Content.ReadFromJsonAsync<DashboardDataDto>();
                var solicitud = dashboardData?.Solicitudes.FirstOrDefault(s => s.Codigo == codigo);
                if (solicitud != null)
                {
                    var niveles = ExtraerNiveles(solicitud.Nivel);
                    infoDocente = new DocenteInfoModel
                    {
                        NombreCompleto = solicitud.NombreDocente,
                        Codigo = solicitud.Codigo,
                        CargoActual = niveles.NivelActual,
                        CargoSolicitado = niveles.NivelSolicitado,
                        FechaSolicitud = solicitud.Fecha is DateOnly d ? d.ToDateTime(TimeOnly.MinValue) : DateTime.Now,
                        TiempoEnProceso = solicitud.TiempoEspera,
                        Estado = solicitud.Estado
                    };
                }
                else
                {
                    errorMensaje = $"No se encontró información para el código: {codigo}";
                }
            }
            else
            {
                errorMensaje = $"Error al cargar dashboard: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMensaje = $"Error al cargar datos por código: {ex.Message}";
        }
    }

    private (string NivelActual, string NivelSolicitado) ExtraerNiveles(string nivelTexto)
    {
        if (string.IsNullOrEmpty(nivelTexto))
            return ("No especificado", "No especificado");
        if (nivelTexto.Contains(" a "))
        {
            var partes = nivelTexto.Split(new[] { " a " }, StringSplitOptions.None);
            return (partes[0].Trim(), partes[1].Trim());
        }
        return (nivelTexto, ObtenerNivelSiguiente(nivelTexto));
    }

    private string ObtenerNivelSiguiente(string nivelActual)
    {
        return nivelActual switch
        {
            "Docente Titular 1" => "Docente Titular 2",
            "Docente Titular 2" => "Docente Titular 3",
            "Docente Titular 3" => "Docente Titular 4",
            "Docente Titular 4" => "Docente Titular 5",
            "Profesor Auxiliar" => "Profesor Agregado",
            "Profesor Agregado" => "Profesor Principal",
            _ => "Nivel Superior"
        };
    }

    private async Task MarcarComoEvaluado(CriterioModel criterio)
    {
        criterio.Estado = "Evaluado";
        criterio.Evaluado = true;
        StateHasChanged();
    }

    private bool TodosEvaluados()
    {
        return Criterios.All(c => c.Estado == "Evaluado" || c.Estado == "Rechazado");
    }

    private void CambiarDecisionFinal(ChangeEventArgs e)
    {
        decision.DecisionSeleccionada = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private string GetClaseBadgeEstado(string estado)
    {
        return estado switch
        {
            "Evaluado" => "bg-success-subtle text-success",
            "Rechazado" => "bg-danger-subtle text-danger",
            "En Proceso" => "bg-info-subtle text-info",
            "En Evaluación" => "bg-info-subtle text-info",
            _ => "bg-warning-subtle text-warning"
        };
    }

    private string GetClaseBotonCriterio(string estado)
    {
        return estado switch
        {
            "Evaluado" => "btn-outline-success",
            "Rechazado" => "btn-outline-danger",
            "En Proceso" => "btn-outline-info",
            "En Evaluación" => "btn-outline-info",
            _ => "btn-primary"
        };
    }

    private string GetTextoBotonCriterio(string estado)
    {
        return estado switch
        {
            "Evaluado" => "Ver Evaluación",
            "Rechazado" => "Ver Evaluación",
            "En Proceso" => "Ver Evaluación",
            "En Evaluación" => "Continuar Evaluación",
            _ => "Ir a Evaluar"
        };
    }

    private void IrAEvaluacion(int criterioId, string nombreCriterio)
    {
        string ruta = criterioId switch
        {
            1 => $"/evaluar-investigacion?cedula={cedulaDocente}",
            2 => $"/evaluar-evaluacion?cedula={cedulaDocente}",
            3 => $"/evaluar-cursos?cedula={cedulaDocente}",
            4 => $"/evaluar-obras?cedula={cedulaDocente}",
            5 => $"/evaluar-docencia?cedula={cedulaDocente}",
            _ => $"/evaluar-criterio/1?cedula={cedulaDocente}"
        };
        Navigation.NavigateTo(ruta);
    }

    private void Volver()
    {
        Navigation.NavigateTo("/admin");
    }

    private async Task GuardarDecision()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(decision.DecisionSeleccionada))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Por favor seleccione una decisión");
                return;
            }

            var postulacionDto = new PostulacionAprobacionDto
            {
                CedulaDocente = infoDocente.Codigo,
                Estado = decision.DecisionSeleccionada == "Aprobar" ? "APROBADO" : "RECHAZADO",
                Observacion = decision.Observaciones,
                Usuario = "materubag"
            };

            var response = await Http.PutAsJsonAsync("api/Postulaciones/evaluar", postulacionDto);

            if (response.IsSuccessStatusCode)
            {
                var mensajeExito = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", mensajeExito);
                Navigation.NavigateTo("/");
            }
            else
            {
                var errorMessage = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", $"Error: {errorMessage}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error al procesar la solicitud: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // --- Clases modelo ---
    public class DocenteInfoModel
    {
        public string NombreCompleto { get; set; } = "";
        public string Codigo { get; set; } = "";
        public string CargoActual { get; set; } = "";
        public string CargoSolicitado { get; set; } = "";
        public DateTime FechaSolicitud { get; set; } = DateTime.Now;
        public string TiempoEnProceso { get; set; } = "";
        public string Estado { get; set; } = "REVISION";
    }

    public class CriterioModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Estado { get; set; } = "Pendiente";
        public bool Evaluado { get; set; } = false;
    }

    public class DecisionModel
    {
        public string DecisionSeleccionada { get; set; } = "";
        public string Observaciones { get; set; } = "";
    }

    public class DashboardDataDto
    {
        public DashboardEstadisticasDto Estadisticas { get; set; }
        public List<SolicitudDocenteDto> Solicitudes { get; set; } = new List<SolicitudDocenteDto>();
    }

    public class DashboardEstadisticasDto
    {
        public int TotalDocentes { get; set; }
        public int EvaluacionesPendientes { get; set; }
        public int SolicitudesFinalizadas { get; set; }
        public int SolicitudesRechazadas { get; set; }
    }

    public class SolicitudDocenteDto
    {
        public int Id { get; set; }
        public string Codigo { get; set; }
        public string NombreDocente { get; set; }
        public string Nivel { get; set; }
        public DateOnly Fecha { get; set; }
        public string TiempoEspera { get; set; }
        public string Estado { get; set; }
    }

    public class PostulacionAprobacionDto
    {
        public string CedulaDocente { get; set; }
        public string Estado { get; set; }
        public string Observacion { get; set; }
        public string Usuario { get; set; }
    }

    private string GetClaseBadgeEstadoSolicitud(string estado)
    {
        if (string.IsNullOrEmpty(estado)) return "bg-warning-subtle text-warning";
        if (estado.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase))
            return "bg-warning-subtle text-warning";
        else if (estado.Contains("REVISION", StringComparison.OrdinalIgnoreCase))
            return "bg-info-subtle text-info";
        else if (estado.Contains("RECHAZADO", StringComparison.OrdinalIgnoreCase))
            return "bg-danger-subtle text-danger";
        else if (estado.Contains("EVALUADO", StringComparison.OrdinalIgnoreCase))
            return "bg-success-subtle text-success";
        else
            return "bg-secondary-subtle text-secondary";
    }
}