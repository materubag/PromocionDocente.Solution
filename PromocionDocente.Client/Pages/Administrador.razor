@code {
    private DecisionModel decision = new();
    private bool isLoading = false;

    private string CargoActual = "Profesor Auxiliar";
    private string CargoSolicitado = "Profesor Agregado";
    private DateTime FechaSolicitud = new DateTime(2024, 12, 15);
    private string TiempoEnProceso = "183 días";

    private List<DocumentoModel> Documentos = new()
    {
        new DocumentoModel { Id = 1, Nombre = "Investigacion", Estado = "Pendiente" },
        new DocumentoModel { Id = 2, Nombre = "Evaluacion", Estado = "Pendiente" },
        new DocumentoModel { Id = 3, Nombre = "Cursos/Capacitaciones", Estado = "Pendiente" },
        new DocumentoModel { Id = 4, Nombre = "Obras/Papers", Estado = "Pendiente" },
        new DocumentoModel { Id = 5, Nombre = "Años Docencia", Estado = "Pendiente" }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarEstadoDocumentos();
    }

    // MÉTODO TEMPORAL PARA TESTING
    private async Task MarcarComoEvaluado(DocumentoModel documento)
    {
        documento.Estado = "Aprobado";
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", $"documento_{documento.Id}_estado", "Aprobado");
        StateHasChanged();
    }

    private async Task CargarEstadoDocumentos()
    {
        try
        {
            foreach (var documento in Documentos)
            {
                var estado = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"documento_{documento.Id}_estado");
                if (!string.IsNullOrEmpty(estado))
                {
                    documento.Estado = estado;
                    documento.Evaluado = estado != "En Proceso" && estado != "Pendiente";
                }
                else
                {
                    if (documento.Id == 3) // Cursos/Capacitaciones
                    {
                        var hayEvaluaciones = false;
                        for (int i = 1; i <= 4; i++)
                        {
                            var estadoCurso = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"curso_{i}_estado");
                            if (!string.IsNullOrEmpty(estadoCurso) && estadoCurso != "En Proceso")
                            {
                                hayEvaluaciones = true;
                                break;
                            }
                        }

                        if (hayEvaluaciones)
                        {
                            documento.Estado = "En Evaluación";
                            documento.Evaluado = false;
                        }
                    }
                }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando estado de documentos: {ex.Message}");
        }
    }

    private bool TodosEvaluados()
    {
        return Documentos.All(d => d.Estado == "Aprobado" || d.Estado == "Rechazado");
    }

    private void CambiarDecisionFinal(ChangeEventArgs e)
    {
        if (TodosEvaluados())
        {
            decision.DecisionSeleccionada = e.Value?.ToString() ?? "";
            Console.WriteLine($"Decisión final cambiada a: {decision.DecisionSeleccionada}");
            StateHasChanged();
        }
    }

    private string GetIconoEstado(string estado)
    {
        return estado switch
        {
            "Aprobado" => "text-success",
            "Rechazado" => "text-danger",
            "En Proceso" => "text-info",
            "En Evaluación" => "text-info",
            _ => "text-warning"
        };
    }

    private string GetClaseBadgeEstado(string estado)
    {
        return estado switch
        {
            "Aprobado" => "bg-success-subtle text-success",
            "Rechazado" => "bg-danger-subtle text-danger",
            "En Proceso" => "bg-info-subtle text-info",
            "En Evaluación" => "bg-info-subtle text-info",
            _ => "bg-warning-subtle text-warning"
        };
    }

    private string GetClaseBotonDocumento(string estado)
    {
        return estado switch
        {
            "Aprobado" => "btn-outline-success",
            "Rechazado" => "btn-outline-danger",
            "En Proceso" => "btn-outline-info",
            "En Evaluación" => "btn-outline-info",
            _ => "btn-primary"
        };
    }

    private string GetTextoBotonDocumento(string estado)
    {
        return estado switch
        {
            "Aprobado" => "Ver Evaluación",
            "Rechazado" => "Ver Evaluación",
            "En Proceso" => "Ver Evaluación",
            "En Evaluación" => "Continuar Evaluación",
            _ => "Ir a Evaluar"
        };
    }

    private void IrAEvaluacion(int documentoId, string nombreDocumento)
    {
        string ruta = documentoId switch
        {
            1 => "/evaluar-investigacion",
            2 => "/evaluar-evaluacion",
            3 => "/evaluar-cursos",
            4 => "/evaluar-obras",
            5 => "/evaluar-docencia",
            _ => "/evaluar-documento/1"
        };

        Navigation.NavigateTo(ruta);
    }

    private void Volver()
    {
        Navigation.NavigateTo("/");
    }

    private async Task GuardarDecision()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (string.IsNullOrEmpty(decision.DecisionSeleccionada))
            {
                await JSRuntime.InvokeVoidAsync("alert", "Por favor seleccione una decisión");
                return;
            }

            await Task.Delay(2000);

            var decisionData = new
            {
                TipoDecision = decision.DecisionSeleccionada,
                Observaciones = decision.Observaciones ?? "",
                Fecha = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss"),
                Usuario = "Cuadrado1224",
                Docente = "Dr. María González",
                CargoActual = CargoActual,
                CargoSolicitado = CargoSolicitado
            };

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", "ultima_decision",
                System.Text.Json.JsonSerializer.Serialize(decisionData));

            await JSRuntime.InvokeVoidAsync("alert", $"✅ Decisión '{decision.DecisionSeleccionada}' guardada exitosamente");
            decision = new DecisionModel();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"❌ Error al guardar la decisión: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class DocumentoModel
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Estado { get; set; } = "Pendiente";
        public bool Evaluado { get; set; } = false;
    }

    public class DecisionModel
    {
        public string DecisionSeleccionada { get; set; } = "";
        public string Observaciones { get; set; } = "";
    }
}