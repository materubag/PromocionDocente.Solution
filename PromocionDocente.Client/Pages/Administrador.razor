@page "/administrador"
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="container-fluid">

    <div class="row align-items-center mb-4 border-bottom pb-3">
        <div class="col-auto">
            <button class="btn btn-link text-muted p-0" @onclick="Volver">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </button>
        </div>
        <div class="col">
            <h2 class="mb-1">Evaluación de Promoción Docente</h2>
            <p class="text-muted mb-0">Dr. María González - 099234678</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-user me-2"></i>Información General
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Cargo Actual</label>
                        <p class="mb-0">@CargoActual</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Fecha de Solicitud</label>
                        <p class="mb-0">@FechaSolicitud.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label text-muted">Cargo Solicitado</label>
                        <p class="mb-0">@CargoSolicitado</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Tiempo en Proceso</label>
                        <p class="mb-0">@TiempoEnProceso</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-0">
                <i class="fas fa-file-alt me-2"></i>Documentos adjuntos
            </h5>
            @foreach (var documento in Documentos)
            {
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-file-alt @GetIconoEstado(documento.Estado) me-3"></i>
                        <div>
                            <h6 class="mb-1">@documento.Nombre</h6>
                            <span class="badge @GetClaseBadgeEstado(documento.Estado)">
                                @documento.Estado
                            </span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn @GetClaseBotonDocumento(documento.Estado) btn-sm"
                                @onclick="() => IrAEvaluacion(documento.Id, documento.Nombre)">
                            @GetTextoBotonDocumento(documento.Estado)
                        </button>
                        <!-- BOTÓN TEMPORAL PARA MARCAR COMO EVALUADO -->
                        @if (documento.Estado == "Pendiente")
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => MarcarComoEvaluado(documento)">
                                ✓ Marcar Evaluado
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- INFORMACIÓN DE DEBUG -->
            <div class="mt-3 p-3 bg-light rounded">
                <small class="text-muted">
                    <strong>Estado de evaluación:</strong><br>
                    Documentos evaluados: @Documentos.Count(d => d.Estado == "Aprobado" || d.Estado == "Rechazado") de @Documentos.Count<br>
                    Todos evaluados: @(TodosEvaluados() ? "Sí" : "No")
                </small>
            </div>
        </div>
    </div>

    <!-- CAMBIO: Mostrar siempre la sección de decisión para debug -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Tomar Decisión Final</h5>
            @if (!TodosEvaluados())
            {
                <small class="text-warning">⚠️ Primero debe evaluar todos los documentos</small>
            }
        </div>
        <div class="card-body">
            <!-- Deshabilitar el formulario si no todos están evaluados -->
            <div class="@(!TodosEvaluados() ? "disabled-form" : "")">
                <EditForm Model="@decision" OnValidSubmit="@GuardarDecision">
                    <div class="mb-4">
                        <label class="form-label">Decisión</label>
                        <div class="decision-container">
                            <!-- Opción Aprobar -->
                            <div class="decision-option @(decision.DecisionSeleccionada == "Aprobar" ? "selected" : "") @(!TodosEvaluados() ? "disabled" : "")">
                                <input type="radio"
                                       name="decision-final"
                                       id="aprobar-final"
                                       value="Aprobar"
                                       @onchange="@((args) => CambiarDecisionFinal(args))"
                                       checked="@(decision.DecisionSeleccionada == "Aprobar")"
                                       disabled="@(!TodosEvaluados())" />
                                <label class="decision-label" for="aprobar-final">
                                    <div class="decision-content">
                                        <i class="fas fa-check-circle text-success me-3"></i>
                                        <div class="decision-text">
                                            <h6 class="mb-1">Aprobar Promoción</h6>
                                            <small class="text-muted">El docente cumple con todos los requisitos</small>
                                        </div>
                                    </div>
                                </label>
                            </div>

                            <!-- Opción Rechazar -->
                            <div class="decision-option @(decision.DecisionSeleccionada == "Rechazar" ? "selected" : "") @(!TodosEvaluados() ? "disabled" : "")">
                                <input type="radio"
                                       name="decision-final"
                                       id="rechazar-final"
                                       value="Rechazar"
                                       @onchange="@((args) => CambiarDecisionFinal(args))"
                                       checked="@(decision.DecisionSeleccionada == "Rechazar")"
                                       disabled="@(!TodosEvaluados())" />
                                <label class="decision-label" for="rechazar-final">
                                    <div class="decision-content">
                                        <i class="fas fa-times-circle text-danger me-3"></i>
                                        <div class="decision-text">
                                            <h6 class="mb-1">Rechazar Promoción</h6>
                                            <small class="text-muted">El docente no cumple con los requisitos</small>
                                        </div>
                                    </div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="observaciones" class="form-label">Observaciones</label>
                        <InputTextArea @bind-Value="decision.Observaciones"
                                       class="form-control"
                                       id="observaciones"
                                       rows="6"
                                       disabled="@(!TodosEvaluados())"
                                       placeholder="Ingrese sus observaciones sobre la evaluación..." required />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" disabled="@(isLoading || !TodosEvaluados())">
                            @if (isLoading)
                            {
                                <span class="loading-dots me-2">●●●</span>
                                <text>Guardando...</text>
                            }
                            else if (!TodosEvaluados())
                            {
                                <text>Complete todas las evaluaciones</text>
                            }
                            else
                            {
                                <text>Guardar Decisión</text>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

