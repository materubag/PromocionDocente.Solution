@using PromocionDocente.Client.Services
@using Blazored.Toast.Configuration
@using Blazored.Toast.Services
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IToastService ToastService
@inherits LayoutComponentBase

<div class="page">
    <BlazoredToasts Position="ToastPosition.BottomRight"
                    Timeout="5"
                    IconType="IconType.FontAwesome"
                    SuccessClass="success-toast"
                    ErrorClass="error-toast"
                    InfoClass="info-toast"
                    WarningClass="warning-toast" />

    <!-- Contenido principal con clase condicional -->
    <main class="@GetMainContentClass()">
        <!-- Barra superior con logo y usuario - Solo visible si NO es administrador -->
        @if (UserSession.Usuario?.Rol != "Administrador")
        {
            <div class="top-row d-flex justify-content-between align-items-center px-4">
                <div class="d-flex align-items-center">
                    <img src="https://img.icons8.com/color/48/000000/school.png" alt="Logo" style="width: 36px; height: 36px;" />
                    <span class="ms-2 fw-bold">Plataforma Docente</span>
                </div>
                <div class="d-flex align-items-center">
                    @if (UserSession.Usuario != null)
                    {  
                        <span class="me-3 text-muted">
                            Usuario: <strong>@UserSession.Usuario.Nombre1 @UserSession.Usuario.Apellido1</strong>
                            Rol:<strong> @UserSession.Usuario.Rol</strong>
                        </span>  
                    }  
                    else  
                    {  
                        <span class="me-3 text-muted">  
                            Usuario: <strong>No autenticado</strong>  
                        </span>  
                    }  
                    <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">  
                        Cerrar sesión  
                    </button>  
                </div>  
            </div>
        }

        <!-- Área del contenido de la página -->  
        <article class="content p-4">  
            @Body  
        </article>  
    </main>  
</div>  

<!-- Modal de confirmación personalizado -->
@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-sign-out-alt me-2"></i>
                        Confirmar acción
                    </h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0">¿Estás seguro de que deseas cerrar sesión?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelarLogout">
                        <i class="fas fa-times me-1"></i>
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarLogout">
                        <i class="fas fa-check me-1"></i>
                        Cerrar sesión
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool mostrarConfirmacion = false;

    private void HandleLogout()
    {
        mostrarConfirmacion = true;
        StateHasChanged();
    }

    private void CancelarLogout()
    {
        mostrarConfirmacion = false;
        ToastService.ShowInfo("Operación cancelada");
        StateHasChanged();
    }

    private async Task ConfirmarLogout()
    {
        mostrarConfirmacion = false;
        StateHasChanged();

        try
        {
            await UserSession.EliminarUsuarioAsync();
            ToastService.ShowSuccess("Sesión cerrada exitosamente");

            // Pequeño delay para que se vea el toast
            await Task.Delay(1000);
            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al cerrar sesión: {ex.Message}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await UserSession.CargarUsuarioAsync();
        Console.WriteLine($"[2025-06-26 05:39:38] Usuario: {UserSession.Usuario?.Nombre1}, MainLayout cargado");

        // Toast de bienvenida (opcional, solo para usuarios autenticados)
        if (UserSession.Usuario != null)
        {
            ToastService.ShowSuccess($"¡Bienvenido, {UserSession.Usuario.Nombre1}!");
        }
    }

    // Puedes usar esto para cambiar el layout dinámicamente si tienes barra lateral/admin
    private string GetMainContentClass()
    {
        // Por defecto, solo devuelve "main-content" pero puedes personalizar para admin
        // Ejemplo: return UserSession.Usuario?.Rol == "Administrador" ? "main-content admin" : "main-content";
        return "main-content";
    }
}
