@using PromocionDocente.Client.Services
@using Blazored.Toast.Configuration
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inherits LayoutComponentBase

<div class="page">
    <!-- Sidebar de navegación - Solo visible si NO es administrador -->
    @if (UserSession.Usuario?.Rol != "admin")
    {
        <div class="sidebar shadow">
            <NavMenu />
        </div>
    }
    
    <BlazoredToasts Position="ToastPosition.BottomRight"
                    Timeout="5"
                    IconType="IconType.FontAwesome"
                    SuccessClass="success-toast"
                    ErrorClass="error-toast"
                    InfoClass="info-toast"
                    WarningClass="warning-toast" />
                    
    <!-- Contenido principal con clase condicional -->
    <main class="@GetMainContentClass()">
        <!-- Barra superior con logo y usuario - Solo visible si NO es administrador -->
        @if (UserSession.Usuario?.Rol != "admin")
        {
            <div class="top-row d-flex justify-content-between align-items-center px-4">
                <div class="d-flex align-items-center">
                    <img src="https://img.icons8.com/color/48/000000/school.png" alt="Logo" style="width: 36px; height: 36px;" />
                    <span class="ms-2 fw-bold">Plataforma Docente</span>
                </div>
                <div class="d-flex align-items-center">
                    @if (UserSession.Usuario != null)
                    {  
                        <span class="me-3 text-muted">
                            Usuario: <strong>@UserSession.Usuario.Nombre1 @UserSession.Usuario.Apellido1</strong>
                            Rol:<strong> @UserSession.Usuario.Rol</strong>
                        </span>  
                    }  
                    else  
                    {  
                        <span class="me-3 text-muted">  
                            Usuario: <strong>No autenticado</strong>  
                        </span>  
                    }  
                    <button class="btn btn-outline-danger btn-sm" @onclick="HandleLogout">  
                        Cerrar sesión  
                    </button>  
                </div>  
            </div>
        }  
        
        <!-- Área del contenido de la página -->  
        <article class="content p-4">  
            @Body  
        </article>  
    </main>  
</div>  

@code {
    private async Task HandleLogout()  
    {  
        var confirmado = await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de cerrar sesión?");  
        if (confirmado)  
        {  
            await UserSession.EliminarUsuarioAsync();  
            Navigation.NavigateTo("/");  
        }  
    }  
    
    protected override async Task OnInitializedAsync()  
    {
        await UserSession.CargarUsuarioAsync();
        Console.WriteLine($"[2025-06-26 05:39:38] Usuario: materubag, MainLayout cargado");
    }
    
    private string GetMainContentClass()
    {
        // Si es administrador, usa toda la pantalla
        if (UserSession.Usuario?.Rol == "Administrador")
        {
            return "main-fullwidth";
        }
        // Si no es administrador, usa el layout normal con sidebar
        return "";
    }
}