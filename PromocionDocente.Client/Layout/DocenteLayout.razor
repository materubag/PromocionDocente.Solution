@* Components/Layout/DocenteLayout.razor *@
@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="docente-layout">
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="header-content">
                <button class="back-btn" @onclick="GoToHome" title="Volver al inicio">
                    <span class="back-icon">←</span>
                </button>
                <h3>Panel Docente</h3>
            </div>
        </div>
        
        <ul class="nav-menu">
            @*<li class="nav-item">
                <a href="/docente/dashboard" class="nav-link @GetActiveClass("/docente/dashboard")">
                    <span class="nav-icon">🏠</span>
                    Dashboard
                </a>
            </li>*@
            <li class="nav-item">
                <a href="/docente/criterios" class="nav-link @GetActiveClass("/docente/criterios")">
                    <span class="nav-icon">📋</span>
                    Criterios de Evaluación
                </a>
            </li>
            <li class="nav-item">
                <a href="/docente/obras" class="nav-link @GetActiveClass("/docente/obras")">
                    <span class="nav-icon">📄</span>
                    Obras/Papers
                </a>
            </li>
            <li class="nav-item">
                <a href="/docente/evaluaciones" class="nav-link @GetActiveClass("/docente/evaluaciones")">
                    <span class="nav-icon">📊</span>
                    Evaluaciones
                </a>
            </li>
            <li class="nav-item">
                <a href="/docente/capacitaciones" class="nav-link @GetActiveClass("/docente/capacitaciones")">
                    <span class="nav-icon">📚</span>
                    Cursos/Capacitaciones
                </a>
            </li>
            <li class="nav-item">
                <a href="/docente/investigaciones" class="nav-link @GetActiveClass("/docente/investigaciones")">
                    <span class="nav-icon">🔍</span>
                    Investigaciones
                </a>
            </li>
            
        </ul>
        
    </nav>
    
    <main class="main-content">
        @Body
    </main>
</div>


@code {
    private string GetActiveClass(string path)
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }

    private void Logout()
    {
        // Implementar lógica de logout
        Navigation.NavigateTo("/");
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/");
    }

}
